---
// Real logo (public/logo.png — optimized web copy of /logo/logo.png, see
// scripts/generate-brand-assets.mjs). Single point of change: if the asset
// is swapped again, only this file and the script need updating.
interface Props {
  class?: string;
}
const { class: className = 'h-11' } = Astro.props;
---

<img
  src="/logo.png"
  alt="LeadVault"
  width="512"
  height="512"
  class={`w-auto ${className}`}
  loading="eager"
  decoding="async"
/>
