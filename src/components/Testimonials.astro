---
import { TESTIMONIALS } from '../data/testimonials';
---

{TESTIMONIALS.length > 0 && (
  <section aria-labelledby="testimonials-heading" class="section">
    <h2 id="testimonials-heading" class="text-center text-3xl font-bold text-white sm:text-4xl">What Customers Say</h2>
    <ul class="mx-auto mt-10 grid max-w-5xl gap-6 md:grid-cols-2">
      {TESTIMONIALS.map((t) => (
        <li class="card">
          <blockquote class="text-sm leading-relaxed text-white/85">“{t.quote}”</blockquote>
          <p class="mt-4 text-sm font-semibold text-white">{t.name}</p>
          <p class="text-xs text-white/60">{t.role}</p>
        </li>
      ))}
    </ul>
  </section>
)}
