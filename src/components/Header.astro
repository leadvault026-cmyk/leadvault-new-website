---
import Logo from './Logo.astro';
import { HEADER_NAV, isNavGroup, CTA_MAIN, WHATSAPP_GET_LEADS_LINK } from '../data/site';
import { ChevronDown } from '@lucide/astro';

const currentPath = new URL(Astro.request.url).pathname;
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
const groupIsActive = (items: { href: string }[]) => items.some((i) => isActive(i.href));
const slug = (label: string) => label.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<!--
  Header gets its own surface tier (bg-mid, not bg) plus a border and shadow,
  so it reads as a distinct element sitting on top of whatever section is
  under it — never blending into the hero (design review requirement).
-->
<header class="sticky top-0 z-50 border-b border-white/10 bg-[var(--color-bg-mid)]/95 shadow-lg shadow-black/30 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-3 lg:px-8">
    <a href="/" class="shrink-0" aria-label="LeadVault home">
      <Logo class="h-14 sm:h-16 lg:h-20" />
    </a>

    <nav class="hidden items-center gap-7 xl:flex" aria-label="Primary">
      {HEADER_NAV.map((entry) =>
        isNavGroup(entry) ? (
          <div class="group relative" data-dropdown>
            <button
              type="button"
              class:list={[
                'flex items-center gap-1 text-sm font-medium whitespace-nowrap transition-colors hover:text-[var(--color-lime)]',
                groupIsActive(entry.items) ? 'text-[var(--color-lime)]' : 'text-white/85',
              ]}
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls={`dropdown-${slug(entry.label)}`}
              data-dropdown-trigger
            >
              {entry.label}
              <ChevronDown size={15} class="transition-transform duration-150 group-[.is-open]:rotate-180" aria-hidden="true" />
            </button>
            <div
              id={`dropdown-${slug(entry.label)}`}
              role="menu"
              aria-label={entry.label}
              class="dropdown-panel absolute left-1/2 top-full z-10 mt-3 w-56 -translate-x-1/2 rounded-xl border border-white/10 bg-[var(--color-bg-mid)] p-2 shadow-xl shadow-black/40"
            >
              {entry.items.map((item) => (
                <a
                  href={item.href}
                  role="menuitem"
                  class:list={[
                    'block rounded-lg px-3 py-2.5 text-sm font-medium transition-colors hover:bg-white/5 hover:text-[var(--color-lime)]',
                    isActive(item.href) ? 'text-[var(--color-lime)]' : 'text-white/85',
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={entry.href}
            class:list={[
              'text-sm font-medium whitespace-nowrap transition-colors hover:text-[var(--color-lime)]',
              isActive(entry.href) ? 'text-[var(--color-lime)]' : 'text-white/85',
            ]}
            aria-current={isActive(entry.href) ? 'page' : undefined}
          >
            {entry.label}
          </a>
        )
      )}
    </nav>

    <div class="hidden shrink-0 items-center gap-3 xl:flex">
      <a
        href={WHATSAPP_GET_LEADS_LINK}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat with LeadVault on WhatsApp"
        data-cta="header-whatsapp"
        class="flex h-10 w-10 items-center justify-center rounded-full bg-[#25D366] text-white transition-transform hover:scale-105"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <path d="M16.004 3C9.377 3 4 8.373 4 15c0 2.386.66 4.617 1.807 6.522L4 29l7.66-1.77A11.94 11.94 0 0 0 16.004 27C22.63 27 28 21.627 28 15S22.63 3 16.004 3Zm0 21.818a9.78 9.78 0 0 1-4.986-1.362l-.358-.213-4.545 1.05 1.08-4.428-.234-.372A9.77 9.77 0 0 1 5.182 15c0-5.968 4.855-10.818 10.822-10.818S26.818 9.032 26.818 15 21.97 24.818 16.004 24.818Zm5.61-8.146c-.307-.154-1.816-.897-2.098-1-.28-.103-.485-.154-.69.154-.204.307-.79 1-.968 1.205-.178.205-.357.23-.664.077-.307-.154-1.296-.478-2.47-1.524-.913-.814-1.53-1.82-1.708-2.127-.178-.307-.019-.473.135-.626.138-.138.307-.358.46-.537.154-.18.205-.307.307-.512.103-.205.051-.384-.026-.538-.077-.154-.69-1.664-.946-2.28-.249-.598-.502-.517-.69-.526l-.588-.01c-.205 0-.538.077-.82.384-.28.307-1.07 1.046-1.07 2.552s1.096 2.96 1.249 3.165c.153.205 2.157 3.293 5.226 4.62.73.315 1.3.503 1.744.644.733.233 1.4.2 1.927.121.588-.088 1.816-.742 2.072-1.46.256-.717.256-1.332.18-1.46-.077-.128-.281-.205-.588-.359Z"/>
        </svg>
      </a>
      <a href="/contact" data-cta="header-get-leads" class="btn-primary !px-5 !py-2.5 text-sm">{CTA_MAIN}</a>
    </div>

    <button
      id="mobile-nav-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-white xl:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Toggle navigation menu"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" x2="20" y1="7" y2="7"></line>
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="17" y2="17"></line>
      </svg>
      <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" x2="6" y1="6" y2="18"></line>
        <line x1="6" x2="18" y1="6" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    class="hidden flex-col gap-1 border-t border-white/10 bg-[var(--color-bg-mid)] px-6 py-4 xl:hidden"
    aria-label="Mobile"
  >
    {HEADER_NAV.map((entry) =>
      isNavGroup(entry) ? (
        <details class="group">
          <summary
            class:list={[
              'flex cursor-pointer list-none items-center justify-between rounded-md px-3 py-2.5 text-base font-medium marker:content-none',
              groupIsActive(entry.items) ? 'text-[var(--color-lime)]' : 'text-white/85',
            ]}
          >
            {entry.label}
            <ChevronDown size={18} class="shrink-0 transition-transform duration-200 group-open:rotate-180" aria-hidden="true" />
          </summary>
          <div class="ml-3 flex flex-col gap-1 border-l border-white/10 pl-3">
            {entry.items.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-white/5 hover:text-[var(--color-lime)]',
                  isActive(item.href) ? 'text-[var(--color-lime)]' : 'text-white/70',
                ]}
              >
                {item.label}
              </a>
            ))}
          </div>
        </details>
      ) : (
        <a
          href={entry.href}
          class:list={[
            'rounded-md px-3 py-2.5 text-base font-medium transition-colors hover:bg-white/5 hover:text-[var(--color-lime)]',
            isActive(entry.href) ? 'text-[var(--color-lime)]' : 'text-white/85',
          ]}
        >
          {entry.label}
        </a>
      )
    )}
    <a href="/contact" data-cta="header-get-leads-mobile" class="btn-primary mt-3 w-full">{CTA_MAIN}</a>
    <a href={WHATSAPP_GET_LEADS_LINK} target="_blank" rel="noopener noreferrer" data-cta="header-whatsapp-mobile" class="btn-outline mt-2 w-full">Chat on WhatsApp</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('flex');
    menu?.classList.toggle('hidden', isOpen);
    menu?.classList.toggle('flex', !isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });

  // Desktop dropdowns ("Solutions" / "Company"): click or keyboard (Enter/Space,
  // since these are real <button> elements) toggles open; Escape closes and
  // returns focus to the trigger; clicking or tabbing outside closes it too.
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');

  function closeDropdown(el: HTMLElement) {
    el.classList.remove('is-open');
    el.querySelector('[data-dropdown-trigger]')?.setAttribute('aria-expanded', 'false');
  }

  function openDropdown(el: HTMLElement) {
    dropdowns.forEach((d) => d !== el && closeDropdown(d));
    el.classList.add('is-open');
    el.querySelector('[data-dropdown-trigger]')?.setAttribute('aria-expanded', 'true');
  }

  dropdowns.forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');

    trigger?.addEventListener('click', () => {
      const isOpen = dropdown.classList.contains('is-open');
      isOpen ? closeDropdown(dropdown) : openDropdown(dropdown);
    });

    dropdown.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDropdown(dropdown);
        trigger?.focus();
      }
    });

    dropdown.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (!next || !dropdown.contains(next)) closeDropdown(dropdown);
    });
  });

  document.addEventListener('click', (e) => {
    dropdowns.forEach((dropdown) => {
      if (!dropdown.contains(e.target as Node)) closeDropdown(dropdown);
    });
  });
</script>

<style>
  .dropdown-panel {
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -4px);
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0.15s;
  }
  [data-dropdown].is-open .dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .dropdown-panel {
      transition: none;
    }
  }
</style>
