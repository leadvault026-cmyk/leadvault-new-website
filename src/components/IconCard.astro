---
import type { HTMLAttributes } from 'astro/types';

interface Props {
  icon: any;
  title: string;
  class?: string;
}
const { icon: Icon, title, class: className = '' } = Astro.props;
---

<div class={`card flex flex-col gap-3 ${className}`}>
  <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-teal)]/15 text-[var(--color-teal)]">
    <Icon size={22} stroke-width={1.75} />
  </div>
  <h3 class="text-lg font-semibold text-white">{title}</h3>
  <div class="text-sm leading-relaxed text-white/70">
    <slot />
  </div>
</div>
