---
// Site-wide floating WhatsApp chat button — a plain link to wa.me, no
// third-party script/widget/tracking loaded (keeps CLAUDE.md's "no chat
// widgets or third-party embeds" intact in spirit; this is just an <a>).
// Uses WhatsApp's own brand green rather than the site's cyan/lime accents,
// since it's a recognizable third-party affordance, not a site CTA.
import { WHATSAPP_LINK } from '../data/site';

const prefilledMessage = encodeURIComponent("Hi LeadVault, I'd like to get started.");
---

<a
  href={`${WHATSAPP_LINK}?text=${prefilledMessage}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with LeadVault on WhatsApp"
  class="fixed bottom-4 right-4 z-40 flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/40 transition-transform hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-cyan)] sm:bottom-5 sm:right-5 sm:h-14 sm:w-14"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-[26px] w-[26px] sm:h-[30px] sm:w-[30px]" fill="currentColor" aria-hidden="true">
    <path d="M16.004 3C9.377 3 4 8.373 4 15c0 2.386.66 4.617 1.807 6.522L4 29l7.66-1.77A11.94 11.94 0 0 0 16.004 27C22.63 27 28 21.627 28 15S22.63 3 16.004 3Zm0 21.818a9.78 9.78 0 0 1-4.986-1.362l-.358-.213-4.545 1.05 1.08-4.428-.234-.372A9.77 9.77 0 0 1 5.182 15c0-5.968 4.855-10.818 10.822-10.818S26.818 9.032 26.818 15 21.97 24.818 16.004 24.818Zm5.61-8.146c-.307-.154-1.816-.897-2.098-1-.28-.103-.485-.154-.69.154-.204.307-.79 1-.968 1.205-.178.205-.357.23-.664.077-.307-.154-1.296-.478-2.47-1.524-.913-.814-1.53-1.82-1.708-2.127-.178-.307-.019-.473.135-.626.138-.138.307-.358.46-.537.154-.18.205-.307.307-.512.103-.205.051-.384-.026-.538-.077-.154-.69-1.664-.946-2.28-.249-.598-.502-.517-.69-.526l-.588-.01c-.205 0-.538.077-.82.384-.28.307-1.07 1.046-1.07 2.552s1.096 2.96 1.249 3.165c.153.205 2.157 3.293 5.226 4.62.73.315 1.3.503 1.744.644.733.233 1.4.2 1.927.121.588-.088 1.816-.742 2.072-1.46.256-.717.256-1.332.18-1.46-.077-.128-.281-.205-.588-.359Z"/>
  </svg>
</a>
