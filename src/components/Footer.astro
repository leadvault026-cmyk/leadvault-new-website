---
import Logo from './Logo.astro';
import { EXPLORE_LINKS, LEGAL_LINKS } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-[var(--color-navy-dark)]">
  <div class="mx-auto max-w-7xl px-6 py-14 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <Logo />
        <p class="mt-3 text-sm font-semibold text-white">Every Business Needs Leads. Every Lead Starts Here.</p>
        <p class="mt-1 text-sm text-white/60">Fresh, verified leads — sourced on request, delivered in days.</p>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-[var(--color-teal)]">Explore</h2>
        <ul class="mt-4 space-y-2">
          {EXPLORE_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-white/70 transition-colors hover:text-[var(--color-teal)]">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-[var(--color-teal)]">Legal</h2>
        <ul class="mt-4 space-y-2">
          {LEGAL_LINKS.map((label) => (
            <li>
              <span class="text-sm text-white/40" title="Coming soon — drafted separately for lawyer review">
                {label}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-[var(--color-teal)]">Newsletter</h2>
        <p class="mt-4 text-sm text-white/70">Fresh-data insights for growing businesses — monthly, no spam.</p>
        <form
          name="newsletter-subscribe"
          method="POST"
          data-netlify="true"
          netlify-honeypot="company-website"
          class="mt-4 flex flex-col gap-2 sm:flex-row"
        >
          <input type="hidden" name="form-name" value="newsletter-subscribe" />
          <div class="hidden">
            <label>
              Don't fill this out if you're human: <input name="company-website" />
            </label>
          </div>
          <label class="sr-only" for="newsletter-email">Email</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            placeholder="you@company.com"
            class="w-full min-w-0 rounded-md border border-white/15 bg-white/5 px-3 py-2 text-sm text-white placeholder:text-white/40 focus:border-[var(--color-teal)] focus:outline-none"
          />
          <button type="submit" class="btn-teal !px-4 !py-2 text-sm whitespace-nowrap">Subscribe</button>
        </form>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-6 text-sm text-white/50">
      © {year} LeadVault · leadvault.com · Serving businesses worldwide from our roots in Nigeria. 🌍
    </div>
  </div>
</footer>
