---
// Homepage proof section — replaces the old StatsSection (see ASSUMPTIONS.md,
// "credibility pass" round). That component showed four numbers (5+ years,
// 80,000+ datasets, 96% deliverability, 4 continents) none of which had a
// verifiable source, methodology, or business-owner confirmation behind them
// — rather than swap in different invented numbers, this section shows the
// one thing on the site that IS real, checkable evidence: an actual sample
// dataset, pulled from the same parsed CSVs the Data Catalog page uses. The
// only number here — the category count — is derived directly from
// CATALOG_CATEGORIES.length, not typed in by hand.
import ComparisonTable from './ComparisonTable.astro';
import { CATALOG_CATEGORIES } from '../data/catalog';
import { ArrowRight } from '@lucide/astro';

const featured = CATALOG_CATEGORIES.find((c) => c.slug === 'business-decision-makers') ?? CATALOG_CATEGORIES[0];
const PREVIEW_ROWS = 3;
---

<div class="grid gap-10 lg:grid-cols-2 lg:items-center">
  <div>
    <p class="eyebrow">See The Work, Not Just The Claim</p>
    <h2 class="mt-2 text-2xl font-bold text-white sm:text-3xl">This Is What A LeadVault Dataset Actually Looks Like.</h2>
    <p class="mt-4 text-white/75">
      Every category in our Data Catalog ships with a real sample preview — the same field
      structure and format you'd receive in a full order. Below: a preview of {featured.name}.
    </p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a href="/data-catalog" data-cta="sample-section-view-catalog" class="btn-primary">View Sample Data <ArrowRight size={18} /></a>
      <a href="/contact" data-cta="sample-section-custom-recommendation" class="btn-outline">Request a Custom Recommendation</a>
    </div>
  </div>
  <div class="min-w-0">
    <ComparisonTable
      headers={featured.sample.headers}
      rows={featured.sample.rows.slice(0, PREVIEW_ROWS)}
      caption={`Sample preview: ${featured.name} (illustrative, not real customer data)`}
    />
    <p class="mt-3 text-xs text-white/50">{CATALOG_CATEGORIES.length} categories available in the full Data Catalog.</p>
  </div>
</div>
