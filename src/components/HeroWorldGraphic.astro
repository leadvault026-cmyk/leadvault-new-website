---
// Hero visual centerpiece. This inlines the client-provided
// leadvault-globe-animated.svg (project root) EXACTLY as delivered —
// accurate geography, multicolor countries, built-in animated arcs, and
// labeled nodes for USA/UK/Canada/Nigeria/Worldwide. Do not regenerate or
// redesign it here; this component only sizes it responsively and adds
// prefers-reduced-motion handling (see <script> below) without touching
// its internal markup, colors, animations, or labels.
// Vite's `?raw` suffix inlines the file's contents as a string at build
// time (resolved relative to this file, not the runtime output location) —
// unlike a runtime fs.readFileSync, this survives production builds, where
// the compiled component is relocated into dist/ and a relative filesystem
// path would no longer resolve.
import svgMarkup from '../../leadvault-globe-animated.svg?raw';
---

<div
  id="hero-globe"
  class="relative mx-auto aspect-square w-full max-w-[560px] lg:mx-0 lg:max-w-none"
  set:html={svgMarkup}
/>

<style>
  #hero-globe :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  // The globe's motion is authored as SVG SMIL <animate> elements, which CSS
  // `prefers-reduced-motion` cannot reach — only the SVG DOM's native
  // animation-control API can pause it. This never edits the SVG's own
  // markup: it jumps the shared timeline past every one-time arc/label
  // reveal (so reduced-motion users see the graphic fully drawn in, not
  // stuck mid-animation) and then pauses it there, freezing the otherwise-
  // continuous node-pulse loops. Re-enables normally if the preference
  // changes back at runtime.
  const svgEl = document.querySelector<SVGSVGElement>('#hero-globe svg');
  const mql = window.matchMedia('(prefers-reduced-motion: reduce)');

  function applyMotionPreference(reduced: boolean) {
    if (!svgEl || typeof svgEl.pauseAnimations !== 'function') return;
    if (reduced) {
      svgEl.setCurrentTime(6);
      svgEl.pauseAnimations();
    } else {
      svgEl.unpauseAnimations();
    }
  }

  applyMotionPreference(mql.matches);
  mql.addEventListener('change', (e) => applyMotionPreference(e.matches));
</script>
