---
// Coded hero graphic (handoff brief §2, row 1 — "Recommended" zero-sourcing option):
// a stylized globe with animated teal connection arcs between served regions.
// Purely decorative — aria-hidden, no alt text needed.
const nodes = [
  { x: 130, y: 150, label: 'USA' },
  { x: 400, y: 90, label: 'UK' },
  { x: 150, y: 230, label: 'Canada' },
  { x: 430, y: 260, label: 'Nigeria' },
  { x: 620, y: 190, label: 'Worldwide' },
];
const arcs = [
  [0, 1],
  [0, 2],
  [1, 3],
  [3, 4],
  [0, 4],
];
---

<div class="relative mx-auto aspect-square w-full max-w-lg" aria-hidden="true">
  <svg viewBox="0 0 700 400" class="h-full w-full">
    <defs>
      <radialGradient id="globeGlow" cx="50%" cy="45%" r="60%">
        <stop offset="0%" stop-color="#12315F" stop-opacity="0.9"></stop>
        <stop offset="100%" stop-color="#0A1F44" stop-opacity="0.2"></stop>
      </radialGradient>
    </defs>

    <circle cx="350" cy="190" r="185" fill="url(#globeGlow)" stroke="#1DBF9F" stroke-opacity="0.25"></circle>
    {[60, 110, 160].map((r) => (
      <ellipse cx="350" cy="190" rx={r * 1.5} ry={r} fill="none" stroke="#1DBF9F" stroke-opacity="0.15"></ellipse>
    ))}
    <ellipse cx="350" cy="190" rx="185" ry="60" fill="none" stroke="#1DBF9F" stroke-opacity="0.15"></ellipse>
    <line x1="165" y1="190" x2="535" y2="190" stroke="#1DBF9F" stroke-opacity="0.15"></line>

    {arcs.map(([a, b], i) => {
      const n1 = nodes[a];
      const n2 = nodes[b];
      const mx = (n1.x + n2.x) / 2;
      const my = Math.min(n1.y, n2.y) - 50;
      return (
        <path
          d={`M ${n1.x} ${n1.y} Q ${mx} ${my} ${n2.x} ${n2.y}`}
          fill="none"
          stroke="#1DBF9F"
          stroke-width="1.5"
          stroke-opacity="0.55"
          stroke-dasharray="6 6"
          class="lv-arc"
          style={`animation-delay:${i * 0.4}s`}
        ></path>
      );
    })}

    {nodes.map((n, i) => (
      <g>
        <circle cx={n.x} cy={n.y} r="14" fill="#1DBF9F" fill-opacity="0.15" class="lv-pulse" style={`animation-delay:${i * 0.3}s`}></circle>
        <circle cx={n.x} cy={n.y} r="5" fill="#1DBF9F"></circle>
        <text x={n.x} y={n.y - 20} text-anchor="middle" fill="#F5F7FA" font-size="13" font-weight="600" opacity="0.85">{n.label}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .lv-arc {
    animation: lv-dash 3.5s linear infinite;
  }
  @keyframes lv-dash {
    to {
      stroke-dashoffset: -48;
    }
  }
  .lv-pulse {
    transform-origin: center;
    animation: lv-pulse 2.4s ease-out infinite;
  }
  @keyframes lv-pulse {
    0% {
      transform: scale(0.8);
      opacity: 0.8;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lv-arc,
    .lv-pulse {
      animation: none;
    }
  }
</style>
