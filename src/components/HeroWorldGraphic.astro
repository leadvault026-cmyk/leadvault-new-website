---
// Hero visual centerpiece. Inlines leadvault-globe-animated.svg (project
// root) — accurate geography, multicolor countries, labeled nodes for
// USA/UK/Canada/Nigeria/Worldwide/UAE/Asia. Geography, colors, and labels
// on the original 7 delivered nodes are untouched; the connection-arc
// animations were changed from a one-time draw-and-freeze to a continuous
// flowing loop (repeatCount="indefinite") per follow-up feedback asking for
// continuous arc movement — see ASSUMPTIONS.md. Two additional arcs
// (Canada<->Asia, USA<->UAE, in the site's own cyan/lime accent colors)
// were added later, connecting existing labeled nodes to each other rather
// than only to the Nigeria hub, so the graphic reads as a genuine network
// rather than a single hub-and-spoke — same path/animate pattern as the
// other 7 arcs, no new geography or nodes introduced. Globe rotation (also
// requested) is added below as pure CSS on the country-shapes group only,
// with zero changes to the SVG file's own markup beyond the two new arcs.
// Vite's `?raw` suffix inlines the file's contents as a string at build
// time (resolved relative to this file, not the runtime output location) —
// unlike a runtime fs.readFileSync, this survives production builds, where
// the compiled component is relocated into dist/ and a relative filesystem
// path would no longer resolve.
import svgMarkup from '../../leadvault-globe-animated.svg?raw';
---

<div
  id="hero-globe"
  class="relative mx-auto aspect-square w-full max-w-[560px] lg:mx-0 lg:max-w-none"
  set:html={svgMarkup}
/>

<style>
  #hero-globe :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Continuous globe rotation — spins only the country-shapes layer (the
     SVG's first <g>, clipped to the sphere) so the map appears to rotate
     beneath the fixed arcs/nodes/labels, which stay put and readable.
     transform-box: view-box anchors the rotation to the SVG's own 2000x2000
     coordinate space (the sphere's true center), not the group's own
     (clipped) bounding box. */
  #hero-globe :global(svg > g:first-of-type) {
    transform-box: view-box;
    transform-origin: 1000px 1000px;
    animation: lv-globe-spin 90s linear infinite;
  }

  @keyframes lv-globe-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #hero-globe :global(svg > g:first-of-type) {
      animation: none;
    }
  }
</style>

<script>
  // The arcs/nodes are authored as SVG SMIL <animate> elements, which CSS
  // `prefers-reduced-motion` cannot reach — only the SVG DOM's native
  // animation-control API can pause them. This never edits the SVG's own
  // markup: it jumps the shared timeline forward (past every arc's initial
  // begin delay, so reduced-motion users see a mid-flow snapshot rather
  // than the pre-animation start state) and then pauses it there. The CSS
  // globe rotation above is handled separately by its own
  // prefers-reduced-motion media query. Re-enables normally if the
  // preference changes back at runtime.
  const svgEl = document.querySelector<SVGSVGElement>('#hero-globe svg');
  const mql = window.matchMedia('(prefers-reduced-motion: reduce)');

  function applyMotionPreference(reduced: boolean) {
    if (!svgEl || typeof svgEl.pauseAnimations !== 'function') return;
    if (reduced) {
      svgEl.setCurrentTime(8);
      svgEl.pauseAnimations();
    } else {
      svgEl.unpauseAnimations();
    }
  }

  applyMotionPreference(mql.matches);
  mql.addEventListener('change', (e) => applyMotionPreference(e.matches));
</script>
