---
// Interactive hero globe (country-level, canvas). Loads after the page's load event so the hero
// text and buttons render first. The container reserves its square space up
// front, so nothing shifts when the canvas appears.
const CITIES = [
  { name: 'Lagos', lat: 6.5244, lng: 3.3792, home: true },
  { name: 'New York', lat: 40.7128, lng: -74.006 },
  { name: 'Houston', lat: 29.7604, lng: -95.3698 },
  { name: 'Toronto', lat: 43.6532, lng: -79.3832 },
  { name: 'London', lat: 51.5074, lng: -0.1278 },
  { name: 'Dubai', lat: 25.2048, lng: 55.2708 },
  { name: 'Johannesburg', lat: -26.2041, lng: 28.0473 },
  { name: 'Nairobi', lat: -1.2921, lng: 36.8219 },
  { name: 'Mumbai', lat: 19.076, lng: 72.8777 },
  { name: 'Singapore', lat: 1.3521, lng: 103.8198 },
  { name: 'São Paulo', lat: -23.5505, lng: -46.6333 },
  { name: 'Sydney', lat: -33.8688, lng: 151.2093 },
];

// Static fallback: orthographic projection of the same points, computed at build time.
const CENTER_LAT = 10 * (Math.PI / 180);
const CENTER_LNG = 20 * (Math.PI / 180);
const project = (lat: number, lng: number) => {
  const φ = lat * (Math.PI / 180);
  const λ = lng * (Math.PI / 180);
  const x = Math.cos(φ) * Math.sin(λ - CENTER_LNG);
  const y = Math.cos(CENTER_LAT) * Math.sin(φ) - Math.sin(CENTER_LAT) * Math.cos(φ) * Math.cos(λ - CENTER_LNG);
  return { x: +(x * 90).toFixed(2), y: +(-y * 90).toFixed(2), visible: Math.cos(CENTER_LAT) * Math.cos(φ) * Math.cos(λ - CENTER_LNG) + Math.sin(CENTER_LAT) * Math.sin(φ) > 0 };
};
const fallbackDots = CITIES.map((c) => ({ ...c, ...project(c.lat, c.lng) })).filter((c) => c.visible);
const homeDot = fallbackDots.find((c) => c.home);
---

<div data-globe class="mx-auto w-full max-w-[300px] md:max-w-md">
  <div class="relative aspect-square w-full">
    <canvas
      data-globe-canvas
      class="absolute inset-0 h-full w-full touch-pan-y"
      role="img"
      aria-label="Rotating globe showing LeadVault's research reach from Lagos to cities in North America, Europe, Africa, the Middle East, Asia, South America and Australia."
    ></canvas>
    <svg data-globe-fallback class="absolute inset-0 hidden h-full w-full" viewBox="-100 -100 200 200" role="img" aria-label="Map of LeadVault's research reach, with Lagos highlighted.">
      <circle cx="0" cy="0" r="90" fill="#0A0B0D" stroke="#00D9FF" stroke-opacity="0.35" stroke-width="1" />
      {fallbackDots.map((c) => (
        <g>
          {!c.home && <line x1={homeDot?.x} y1={homeDot?.y} x2={c.x} y2={c.y} stroke="#00D9FF" stroke-opacity="0.25" stroke-width="0.6" />}
          <circle cx={c.x} cy={c.y} r={c.home ? 3.5 : 2} fill={c.home ? '#B7FF00' : '#00D9FF'} />
        </g>
      ))}
    </svg>
  </div>
</div>

<script>
  // Country-level globe: each country gets a colour from the LeadVault palette,
  // chosen by hashing its numeric ISO code, so colours never change between loads.
  const LIME = ['#B7FF00', '#8FD12A', '#6BAE1F'];
  const YELLOW = ['#E9F542', '#CFE02A'];
  const GREY = ['#3A434C', '#4A5560', '#5E6A75'];
  const LIME_YELLOW = [...LIME, ...YELLOW];
  // Key markets, by ISO numeric code.
  const KEY_COLOURS: Record<number, string> = {
    566: '#B7FF00', // Nigeria: brightest logo lime
    840: '#E9F542', // United States
    826: '#E9F542', // United Kingdom
    124: '#E9F542', // Canada
    784: '#E9F542', // United Arab Emirates
  };
  const CITIES = [
    { name: 'Lagos', lat: 6.5244, lng: 3.3792, home: true },
    { name: 'New York', lat: 40.7128, lng: -74.006 },
    { name: 'Houston', lat: 29.7604, lng: -95.3698 },
    { name: 'Toronto', lat: 43.6532, lng: -79.3832 },
    { name: 'London', lat: 51.5074, lng: -0.1278 },
    { name: 'Dubai', lat: 25.2048, lng: 55.2708 },
    { name: 'Johannesburg', lat: -26.2041, lng: 28.0473 },
    { name: 'Nairobi', lat: -1.2921, lng: 36.8219 },
    { name: 'Mumbai', lat: 19.076, lng: 72.8777 },
    { name: 'Singapore', lat: 1.3521, lng: 103.8198 },
    { name: 'São Paulo', lat: -23.5505, lng: -46.6333 },
    { name: 'Sydney', lat: -33.8688, lng: 151.2093 },
  ];
  const CYAN = '#00D9FF';
  const INITIAL_LAMBDA = -3.3792; // centre the view on Lagos
  const INITIAL_PHI = -6.5244;

  const root = document.querySelector<HTMLElement>('[data-globe]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-globe-canvas]');
  const fallback = root?.querySelector<SVGElement>('[data-globe-fallback]');

  // Stable colour per country: integer hash of the numeric ISO code.
  // Roughly 6 in 11 slots are lime or yellow, the rest grey (about 55/45).
  function colourFor(id: number): string {
    const key = KEY_COLOURS[id];
    if (key) return key;
    const h = Math.abs(Math.imul(id, 2654435761)) % 11;
    return h < 6 ? LIME_YELLOW[h % LIME_YELLOW.length] : GREY[(h - 6) % GREY.length];
  }

  function hasCanvas(): boolean {
    try {
      return !!document.createElement('canvas').getContext('2d');
    } catch {
      return false;
    }
  }

  async function start() {
    if (!root || !canvas || !fallback) return;
    if (!hasCanvas()) {
      canvas.remove();
      fallback.classList.remove('hidden');
      return;
    }

    const [{ geoOrthographic, geoPath, geoInterpolate, geoDistance }, { feature }, topoModule] = await Promise.all([
      import('d3-geo'),
      import('topojson-client'),
      import('world-atlas/countries-110m.json'),
    ]);
    const topo: any = (topoModule as any).default ?? topoModule;
    const countries = feature(topo, topo.objects.countries).features as any[];

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isSmall = window.innerWidth < 768;
    const dpr = isSmall ? 1 : Math.min(2, window.devicePixelRatio || 1);
    const size = Math.round(canvas.getBoundingClientRect().width) || 300;
    canvas.width = size * dpr;
    canvas.height = size * dpr;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.scale(dpr, dpr);

    const projection = geoOrthographic()
      .scale(size / 2 - 6)
      .translate([size / 2, size / 2])
      .clipAngle(90)
      .precision(0.5);
    const path = geoPath(projection, ctx);
    const sphere = { type: 'Sphere' } as any;

    let lambda = INITIAL_LAMBDA;
    let phi = INITIAL_PHI;
    const home = CITIES[0];
    const arcs = CITIES.slice(1).map((c) => {
      const interp = geoInterpolate([home.lng, home.lat], [c.lng, c.lat]);
      const coords = Array.from({ length: 65 }, (_, i) => interp(i / 64));
      return { type: 'LineString', coordinates: coords } as any;
    });

    function draw() {
      projection.rotate([-lambda, -phi]);
      const centre: [number, number] = [-lambda, -phi];
      ctx!.clearRect(0, 0, size, size);

      // Ocean
      ctx!.beginPath();
      path(sphere);
      ctx!.fillStyle = '#0A0B0D';
      ctx!.fill();

      // Countries, each in its own colour
      ctx!.lineWidth = 0.35;
      ctx!.strokeStyle = 'rgba(10, 11, 13, 0.7)';
      for (const f of countries) {
        const id = +f.id;
        ctx!.beginPath();
        path(f);
        ctx!.globalAlpha = 0.62;
        ctx!.fillStyle = colourFor(id);
        ctx!.fill();
        ctx!.globalAlpha = 1;
        ctx!.stroke();
      }

      // Key markets on top: full-strength fill and a bright outline so they stand out
      ctx!.lineWidth = 1;
      for (const f of countries) {
        const id = +f.id;
        if (!KEY_COLOURS[id]) continue;
        ctx!.beginPath();
        path(f);
        ctx!.fillStyle = KEY_COLOURS[id];
        ctx!.globalAlpha = 0.95;
        ctx!.fill();
        ctx!.globalAlpha = 1;
        ctx!.strokeStyle = '#F5F7FA';
        ctx!.stroke();
      }

      // Arcs from Lagos
      ctx!.lineWidth = 1.6;
      ctx!.strokeStyle = CYAN;
      ctx!.globalAlpha = 0.85;
      ctx!.shadowColor = CYAN;
      ctx!.shadowBlur = 6;
      for (const a of arcs) {
        ctx!.beginPath();
        path(a);
        ctx!.stroke();
      }
      ctx!.globalAlpha = 1;
      ctx!.shadowBlur = 0;

      // City markers, on the visible side only
      for (const c of CITIES) {
        const visible = geoDistance([c.lng, c.lat], centre) < Math.PI / 2;
        if (!visible) continue;
        const [x, y] = projection([c.lng, c.lat]) as [number, number];
        ctx!.beginPath();
        ctx!.arc(x, y, c.home ? 4.5 : 2.6, 0, Math.PI * 2);
        ctx!.fillStyle = c.home ? '#B7FF00' : '#FFFFFF';
        ctx!.shadowColor = c.home ? '#B7FF00' : CYAN;
        ctx!.shadowBlur = c.home ? 14 : 8;
        ctx!.fill();
        ctx!.shadowBlur = 0;
      }

      // Soft cyan atmosphere
      ctx!.beginPath();
      path(sphere);
      ctx!.lineWidth = 2;
      ctx!.strokeStyle = CYAN;
      ctx!.shadowColor = CYAN;
      ctx!.shadowBlur = 16;
      ctx!.globalAlpha = 0.6;
      ctx!.stroke();
      ctx!.globalAlpha = 1;
      ctx!.shadowBlur = 0;
    }

    draw();
    if (reduceMotion) return;

    let dragging = false;
    let lastX = 0;
    let visible = true;
    canvas.addEventListener('pointerdown', (e) => {
      dragging = true;
      lastX = e.clientX;
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      lambda += (e.clientX - lastX) * 0.35;
      lastX = e.clientX;
      draw();
    });
    const endDrag = () => {
      dragging = false;
    };
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointercancel', endDrag);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    }).observe(canvas);

    const tick = () => {
      if (visible && !dragging) {
        lambda -= 0.14;
        draw();
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  if (document.readyState === 'complete') {
    start();
  } else {
    window.addEventListener('load', () => start(), { once: true });
  }
</script>
