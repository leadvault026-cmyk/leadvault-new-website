---
import { Quote } from '@lucide/astro';

interface Props {
  quote: string;
  attribution: string;
}
const { quote, attribution } = Astro.props;
---

<figure class="card flex h-full flex-col gap-4">
  <Quote size={26} class="text-[var(--color-teal)]" aria-hidden="true" />
  <blockquote class="flex-1 text-sm leading-relaxed text-white/85">
    "{quote}"
  </blockquote>
  <figcaption class="text-sm font-semibold text-white">— {attribution}</figcaption>
</figure>
