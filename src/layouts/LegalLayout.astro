---
// Shared chrome for the 5 legal pages (Privacy, Terms, Data Sourcing, Removal
// Request, Refund & Replacement) — same BaseLayout, plus consistent long-form
// typography for the semantic HTML (h2/p/ul/a) each page writes directly,
// so individual pages stay clean markup instead of repeating utility classes
// on every paragraph.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  lastUpdated: string;
}

const { title, description, path, heading, lastUpdated } = Astro.props;
---

<BaseLayout title={title} description={description} path={path}>
  <section class="section">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">Legal</p>
      <h1 class="mt-2 text-3xl font-extrabold text-white sm:text-4xl">{heading}</h1>
      <p class="mt-3 text-sm text-white/50">Last updated: {lastUpdated}</p>
      <div class="legal-content mt-10">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-content :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
  }
  .legal-content :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-content :global(p) {
    margin-top: 1rem;
    color: rgb(255 255 255 / 0.75);
    line-height: 1.7;
  }
  .legal-content :global(ul) {
    margin-top: 1rem;
    padding-left: 1.25rem;
    list-style-type: disc;
    color: rgb(255 255 255 / 0.75);
  }
  .legal-content :global(li) {
    margin-top: 0.5rem;
    line-height: 1.7;
  }
  .legal-content :global(li)::marker {
    color: var(--color-lime);
  }
  .legal-content :global(a) {
    color: var(--color-lime);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-content :global(a:hover) {
    color: white;
  }
  .legal-content :global(strong) {
    color: white;
    font-weight: 600;
  }
</style>
