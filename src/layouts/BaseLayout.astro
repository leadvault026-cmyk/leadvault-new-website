---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '../styles/global.css';
import { SITE_URL } from '../data/site';

// ---- Analytics placeholder IDs (CLAUDE.md: leave clearly-commented slots) ----
// Real GA4 Measurement ID (handoff brief §5A).
const GA4_MEASUREMENT_ID = 'G-RVMGVR05JD';
// Real Meta Pixel/Dataset ID (handoff brief §5C).
const META_PIXEL_ID = '901363379491498';

interface Props {
  title: string;
  description: string;
  path: string; // e.g. "/services" — used to build the canonical + OG URL
  noindex?: boolean;
  ogImage?: string;
  includeOrgSchema?: boolean;
}

const {
  title,
  description,
  path,
  noindex = false,
  ogImage = '/og-image.png',
  includeOrgSchema = false,
} = Astro.props;

const canonicalURL = new URL(path, SITE_URL).toString();
const ogImageURL = new URL(ogImage, SITE_URL).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LeadVault" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {includeOrgSchema && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'LeadVault',
        url: 'https://leadvaultdata.com',
        founder: {
          '@type': 'Person',
          name: 'Steven Ehimigbai',
        },
      })} />
    )}

    <!--
      GA4 (Google Analytics 4) — handoff brief §5A.
      Paste the real Measurement ID above in GA4_MEASUREMENT_ID; this snippet
      no-ops (does not load) while the ID is still the placeholder.
    -->
    {GA4_MEASUREMENT_ID !== 'G-XXXXXXXXXX' && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}></script>
        {/*
          The measurement ID is inlined as a literal string (not a JS variable
          reference) on purpose: Search Console's "Google Analytics" ownership
          verification method does a literal text scan for
          gtag('config', '<ID>') and does not resolve variables, so a
          gtag('config', GA4_MEASUREMENT_ID) call — functionally identical at
          runtime — was silently failing that specific check. set:html (built
          at compile time, not define:vars) is what lets the real ID land in
          the source text here instead of a variable name.
        */}
        <script set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', '${GA4_MEASUREMENT_ID}');
          window.gtag = gtag;
        `} />
      </>
    )}

    <!--
      Meta Pixel — handoff brief §5C.
      Paste the real Pixel/Dataset ID above in META_PIXEL_ID; this snippet
      no-ops (does not load) while the ID is still the placeholder.
    -->
    {META_PIXEL_ID !== 'PIXEL_ID_TBD' && (
      /*
        Pixel ID inlined as a literal string (set:html, not define:vars) for the
        same reason as the GA4 snippet above: Meta's domain-verification and
        Pixel Helper checks expect fbq('init', '<ID>') as literal text, matching
        Meta's own canonical snippet — a variable reference is functionally
        identical at runtime but can fail a static/literal scan.
      */
      <script set:html={`
        !(function (f, b, e, v, n, t, s) {
          if (f.fbq) return;
          n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = !0;
          n.version = '2.0';
          n.queue = [];
          t = b.createElement(e);
          t.async = !0;
          t.src = v;
          s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '${META_PIXEL_ID}');
        fbq('track', 'PageView');
      `} />
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-[var(--color-cyan)] focus:px-4 focus:py-2 focus:font-semibold focus:text-[var(--color-cyan-ink)]"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <script>
      // Sitewide CTA click tracking (credibility-pass round — see ASSUMPTIONS.md).
      // Any element with data-cta="..." fires a GA4/Meta event on click, guarded
      // exactly like the /thank-you conversion events: gtag/fbq only exist once
      // BaseLayout's real GA4_MEASUREMENT_ID/META_PIXEL_ID replace the
      // placeholders, so this silently no-ops until analytics is actually live.
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement)?.closest<HTMLElement>('[data-cta]');
        if (!el) return;
        const cta = el.dataset.cta;
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'cta_click', { cta_id: cta });
        }
        if (typeof (window as any).fbq === 'function') {
          (window as any).fbq('trackCustom', 'CTAClick', { cta_id: cta });
        }
      });
    </script>
  </body>
</html>
