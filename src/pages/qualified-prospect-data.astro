---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { DATASET_TIERS } from '../data/catalog';
import { CTA_PRIMARY, CTA_SAMPLE_DATA, CTA_SAMPLE_HREF } from '../data/site';
import {
  ArrowRight,
  Database,
  MapPin,
  Building2,
  UserCheck,
  Calendar,
  Globe,
  Layers,
  ShieldCheck,
  Sparkles,
  UserCog,
  RefreshCw,
  FileX,
  Target,
  Search,
  ClipboardCheck,
  Users,
  CheckCircle2,
  Send,
  Ban,
} from '@lucide/astro';

// Master commercial copy package (2026-10-01) — content-depth implementation.
// Ties into the existing, unchanged DATASET_TIERS pricing ladder (Round 15)
// rather than repeating numbers.

const bestFor = [
  { icon: Building2, label: 'Defined ICPs' },
  { icon: MapPin, label: 'Territory building' },
  { icon: Layers, label: 'Account-list development' },
  { icon: UserCheck, label: 'Decision-maker lists' },
  { icon: Calendar, label: 'Event or campaign targeting' },
  { icon: Globe, label: 'Geographic expansion' },
  { icon: Database, label: 'Niche industry prospecting' },
];

const icpCriteria = [
  'Industry or niche', 'Geography', 'Company size or operating profile', 'Business model',
  'Relevant department', 'Job function', 'Seniority', 'Specific titles', 'Required fields', 'Exclusions',
];

const fields = [
  'Company name', 'Website', 'Contact name', 'Contact title', 'Business email',
  'Phone number where available', 'Address', 'City', 'State/region', 'Industry/provider type',
  'Company attributes', 'Professional profile URL where required', 'Custom fields', 'Qualification notes',
];

const buildSteps = [
  { icon: Target, label: 'Define', body: 'Confirm the ICP, contact requirement, geography, exclusions, quantity and delivery fields.' },
  { icon: Search, label: 'Research', body: 'Identify companies matching the account-level criteria.' },
  { icon: Users, label: 'Contact', body: 'Research the relevant people or functions where contact-level data is required.' },
  { icon: ShieldCheck, label: 'Verify', body: 'Review available business contact information and critical fields within the agreed scope.' },
  { icon: CheckCircle2, label: 'Clean', body: 'Normalize formats, remove duplicates and prepare the records consistently.' },
  { icon: Send, label: 'Deliver', body: 'Provide the finished dataset in the agreed file format for review, CRM import or outreach.' },
];

const exclusionCategories = [
  'Unsuitable industries', 'Unsuitable business models', 'Company sizes', 'Geographies',
  'Franchise structures', 'Government entities', 'Subsidiaries', 'Existing customers',
  'Competitors', 'Generic role accounts', 'Companies failing another agreed criterion',
];

const related = [
  { icon: Sparkles, title: 'Requirement too specific for a filter?', body: 'If fit depends on evidence or qualitative criteria a standard filter can\'t test, the flagship service is the better starting point.', cta: { label: 'See Prospect Intelligence', href: '/prospect-intelligence' } },
  { icon: Globe, title: "Don't know your target market yet?", body: "If you're still translating an ICP into a defined, addressable market, map it first.", cta: { label: 'See Market & ICP Research', href: '/market-icp-research' } },
  { icon: UserCog, title: 'Need help acting on the data?', body: 'If you want the research put into a controlled outreach campaign, not just delivered.', cta: { label: 'See Intelligence-Led Outreach', href: '/managed-outreach' } },
];

const faqs = [
  {
    question: 'How is this different from buying access to a database platform?',
    answer: "You don't get a login to search yourself. You give us the specification — industry, geography, company profile, roles — and we research, verify, and deliver a dataset built specifically for that request, rather than an export from a stored, aging database.",
  },
  {
    question: 'What fields do I get with each record?',
    answer: 'Standard fields are company name, website, contact name, contact title, business email where available, phone where available, location, industry, and company/provider type — plus any custom fields you specify.',
  },
  {
    question: 'How accurate is the contact data?',
    answer: 'Every record is verified at the time of research using the applicable verification process. We don\'t claim permanent deliverability — people change roles and companies over time — which is why every delivery carries our replacement guarantee. See the full pricing tiers below.',
  },
  {
    question: 'Can I start small and scale up?',
    answer: 'Yes — the pricing ladder below is built around testing a specification at a small volume before committing to a larger order.',
  },
  {
    question: 'Can I get a dataset every month instead of a one-time order?',
    answer: 'Yes — recurring prospect research is available for teams that need a continuing supply of fresh prospect research rather than one large one-time file. The targeting specification remains the same discipline either way.',
  },
];
---

<BaseLayout
  title="Qualified B2B Prospect Data & Custom Lead Lists | LeadVault"
  description="Get qualified B2B prospect data researched to your ICP, including target companies, relevant decision-makers and verified available business contact information."
  path="/qualified-prospect-data"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Qualified Prospect Data',
    name: 'Qualified Prospect Data',
    description: 'Custom B2B prospect data researched to a defined specification, including company, contact, and decision-maker fields.',
    provider: { '@type': 'Organization', name: 'LeadVault', url: 'https://leadvaultdata.com' },
  })} />

  <section class="section text-center">
    <p class="eyebrow">Qualified Prospect Data</p>
    <h1 class="mt-2 text-4xl font-extrabold text-white sm:text-5xl">You Know Who You Want. We Build the Dataset.</h1>
    <p class="mx-auto mt-5 max-w-2xl text-white/75">
      When your target market is already clear, LeadVault can research the companies and contacts
      that match it. Define the geography, industry, company profile, relevant roles, exclusions
      and fields you need. We turn that specification into a clean, structured prospect dataset
      built for your campaign or workflow.
    </p>
    <div class="mt-8">
      <a href="/contact?need=qualified-prospect-data" data-cta="qpd-hero" class="btn-primary">Request Prospect Data <ArrowRight size={18} /></a>
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Best For</h2>
      <ul class="mx-auto mt-8 grid max-w-3xl gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {bestFor.map((b) => (
          <li class="card flex items-center gap-3 text-sm font-medium text-white/85">
            <b.icon size={20} class="shrink-0 text-[var(--color-lime)]" aria-hidden="true" />
            {b.label}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">A Good List Starts With a Good Specification</h2>
      <p class="mt-4 text-white/75">
        The quality of a prospect dataset depends on the definition used to build it. "Technology
        companies in the United States" can describe an enormous and commercially inconsistent
        market. "U.S. B2B SaaS companies within an agreed size range, excluding agencies and
        consumer apps, with a relevant revenue or marketing leader" is a much more useful research
        instruction.
      </p>
      <p class="mt-4 text-white/75">LeadVault can work from criteria such as:</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {icpCriteria.map((c) => (
          <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-sm text-white/80">{c}</span>
        ))}
      </div>
      <p class="mt-5 text-white/75">
        The clearer the specification, the less time your team spends sorting irrelevant records
        after delivery.
      </p>
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-2xl font-bold text-white sm:text-3xl">Company Fit and Contact Fit Are Different Questions</h2>
        <p class="mt-4 text-white/75">
          A company can fit the ICP while the first person found inside it is still the wrong
          contact. Qualified Prospect Data therefore separates account-level criteria from
          contact-level criteria.
        </p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <div class="rounded-lg border border-white/10 bg-white/5 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-white/50">Account Criteria</p>
            <p class="mt-1.5 text-sm text-white/80">Which organizations belong in the target market?</p>
          </div>
          <div class="rounded-lg border border-white/10 bg-white/5 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-white/50">Contact Criteria</p>
            <p class="mt-1.5 text-sm text-white/80">Which people or functions inside those organizations are relevant to the campaign?</p>
          </div>
        </div>
        <p class="mt-5 text-white/75">
          For simple projects, one contact per company may be enough. For other projects, several
          functions or stakeholders may be appropriate. The contact requirement should follow the
          customer's sales motion rather than a generic "CEO for every company" rule.
        </p>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-2">
        <div>
          <h2 class="text-xl font-bold text-white">What You Can Receive</h2>
          <p class="mt-3 text-sm text-white/60">Depending on the specification:</p>
          <ul class="mt-4 space-y-2">
            {fields.map((f) => (
              <li class="flex gap-2 text-sm text-white/75">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-lime)]"></span>
                {f}
              </li>
            ))}
          </ul>
          <p class="mt-4 text-xs text-white/50">The final schema is agreed before delivery.</p>
        </div>
        <div class="space-y-6">
          <div class="card">
            <h2 class="flex items-center gap-2 text-lg font-bold text-white"><FileX size={18} class="text-[var(--color-lime)]" /> Not Every Record Belongs in Your Campaign</h2>
            <p class="mt-3 text-sm leading-relaxed text-white/75">
              A company can match the industry and still be wrong for your offer. A person can have
              the right-sounding title and still be irrelevant. A contact record can exist and still
              be stale. That is why LeadVault combines targeting, research, verification and quality
              control rather than treating every discovered record as deliverable.
            </p>
          </div>
          <div class="card">
            <h2 class="flex items-center gap-2 text-lg font-bold text-white"><RefreshCw size={18} class="text-[var(--color-lime)]" /> One-Time or Recurring</h2>
            <p class="mt-3 text-sm leading-relaxed text-white/75">
              Use a one-time project when you need a defined dataset for a campaign, market test,
              event, launch, territory or specific sales initiative. Use recurring prospect research
              when the need continues month after month — the important principle is consistency:
              the recurring work should continue to follow an agreed ICP, exclusions and delivery
              structure. "Monthly" should not mean random records that happen to fit a broad
              industry.
            </p>
          </div>
        </div>
      </div>

      <div class="mx-auto mt-12 max-w-5xl">
        <h2 class="text-center text-xl font-bold text-white">How the Dataset Is Built</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {buildSteps.map((s, i) => (
            <div class="card flex items-start gap-3">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
                <s.icon size={18} stroke-width={1.75} aria-hidden="true" />
              </div>
              <div>
                <p class="text-sm font-semibold text-white">{i + 1}. {s.label}</p>
                <p class="mt-1 text-sm text-white/70">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="mx-auto mt-12 max-w-3xl">
        <h2 class="flex items-center justify-center gap-2 text-center text-xl font-bold text-white"><Ban size={20} class="text-[var(--color-lime)]" /> What We Exclude</h2>
        <p class="mt-3 text-center text-sm text-white/70">
          A useful prospect list is partly defined by what it leaves out. Depending on the project,
          exclusions may cover:
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-2">
          {exclusionCategories.map((c) => (
            <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-sm text-white/80">{c}</span>
          ))}
        </div>
        <p class="mt-5 text-center text-sm text-white/60">
          Exclusions should be defined before research where possible. They prevent the customer
          from paying for records the team already knows it cannot use.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Pricing Tiers</h2>
    <p class="mx-auto mt-3 max-w-xl text-center text-sm text-white/60">Start small and scale up as a specification proves out.</p>
    <div class="mx-auto mt-8 flex max-w-3xl flex-wrap justify-center gap-3">
      {DATASET_TIERS.map((t) => (
        <span class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/80">
          {t.name} — {t.records} · <strong class="text-white">{t.price}</strong>
        </span>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="/pricing" class="btn-outline">See Full Pricing <ArrowRight size={18} /></a>
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <div class="card mx-auto max-w-2xl text-center">
        <h2 class="text-lg font-bold text-white">When You Need More Than a Defined List</h2>
        <p class="mt-3 text-sm leading-relaxed text-white/75">
          If your requirement includes conditions that must be investigated, unusual qualification
          signals, evidence or custom intelligence fields, move up to Prospect Intelligence.
        </p>
        <a href="/prospect-intelligence" class="mt-4 inline-block text-sm font-semibold text-[var(--color-lime)] hover:underline">See Prospect Intelligence →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Is This the Right Service?</h2>
    <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-3">
      {related.map((r) => (
        <div class="card flex flex-col gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
            <r.icon size={22} stroke-width={1.75} aria-hidden="true" />
          </div>
          <h3 class="text-base font-semibold text-white">{r.title}</h3>
          <p class="flex-1 text-sm leading-relaxed text-white/70">{r.body}</p>
          <a href={r.cta.href} class="text-sm font-semibold text-[var(--color-lime)] hover:underline">{r.cta.label} →</a>
        </div>
      ))}
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Frequently Asked Questions</h2>
      <div class="mx-auto mt-10 max-w-3xl">
        <FaqAccordion items={faqs} />
      </div>
    </div>
  </section>

  <section class="section text-center">
    <h2 class="text-2xl font-bold text-white sm:text-3xl">Know Exactly Who You Need? Let's Build the List.</h2>
    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <a href="/contact?need=qualified-prospect-data" data-cta="qpd-final" class="btn-primary">{CTA_PRIMARY} <ArrowRight size={18} /></a>
      <a href={CTA_SAMPLE_HREF} class="btn-outline">{CTA_SAMPLE_DATA}</a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  })} />
</BaseLayout>
