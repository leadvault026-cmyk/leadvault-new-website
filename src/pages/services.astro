---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Database, Sparkles, Handshake, CalendarCheck, Terminal, Compass, Send, MailCheck, ArrowRight } from '@lucide/astro';

const services = [
  {
    icon: Database,
    title: 'Custom Fresh Datasets',
    flagship: true,
    body: "Tell us exactly who you need — industry, job titles, locations, company sizes, buying signals. We source the data fresh, verify every record, and deliver a clean CSV within days. Not pulled from storage; harvested for you.",
    detail: 'What you receive per record: name, job title, company, verified email, phone (where available), location, industry — plus any custom fields you specify.',
    price: 'From $99 per 500 verified records.',
  },
  {
    id: 'managed-email-campaigns',
    icon: MailCheck,
    title: 'Managed Email Campaigns & Deliverability Engineering',
    body: "For agencies and outbound teams running client or in-house campaigns: sending bulk email like it's 2010 is why your campaigns disappear. Most businesses gather a list and blast every address in one campaign — Gmail, Office 365, IONOS, and every other provider mixed together. That approach is dead. Today's mailbox providers use machine-learning filters, and each one judges your email differently: a message that lands perfectly in a Gmail inbox can vanish silently at Office 365. Send to them all identically, and your results — and sender reputation — suffer everywhere at once.",
    listIntro: 'LeadVault runs your campaigns the way deliverability professionals do, using our own in-house engineered tools:',
    list: [
      'Clean & verify first — every address passes our verification pipeline before anything is sent.',
      'MX-sort the list — our sorting software separates your list by mail provider (Gmail, Office 365, IONOS, and every other MX record type) into individual segments, because each provider must be approached on its own terms.',
      'Test deliverability per provider — before full send, we test how each segment performs at its provider and tune accordingly.',
      'Warm up properly — new or under-used domains are warmed on a controlled schedule; a cold domain sent at volume is a campaign lost in the air.',
      'Send with best practices — provider-appropriate pacing, authentication (SPF/DKIM/DMARC), honest sender identity, and working opt-outs on every message.',
      'Report everything — you receive a real campaign report: delivered, opened, bounced, by provider segment. No more sending into the void and hearing nothing back.',
    ],
    body2: 'Most companies running campaigns today have no idea whether their emails ever landed. Our clients know — because we engineered the landing.',
    detail: 'Compliance note: we run permission-appropriate, regulation-compliant B2B outreach only (CAN-SPAM and applicable laws). We decline campaigns designed to deceive.',
    price: 'Setup from $499 one-time · campaigns from $299 · managed monthly from $699.',
  },
  {
    icon: Sparkles,
    title: 'Email List Cleaning & Hygiene',
    body: 'Lists age fast — independent research puts B2B contact decay at roughly 22–23% per year (see the citation on our homepage). Send us any list (bought anywhere, or built in-house) and we return it healthy:',
    list: [
      'MX record verification across Office 365, Google Workspace, and every provider type',
      'Bounce and dead-address removal before you ever hit "send"',
      'Duplicate & error scrubbing',
      'Your sender reputation, protected.',
    ],
    price: 'From $39 per 5,000 contacts cleaned.',
  },
  {
    icon: Handshake,
    title: 'Verified Buyer–Seller Matching',
    subtitle: 'The Trade Desk — our specialized research service for international trade',
    body: 'The service that built LeadVault. For importers, exporters, and freight forwarders: we locate and verify genuine counterparties — buyers for your goods, suppliers you can trust, shippers who need forwarding — across international markets. Includes a strategist consultation on your trade lane.',
    price: 'From $449 per engagement.',
    cta: { label: 'Full details →', href: '/trade' },
  },
  {
    icon: CalendarCheck,
    title: 'Monthly Lead Subscriptions',
    body: 'A steady pipeline, on schedule. Fresh, verified leads matching your profile, delivered weekly or monthly — with a strategy report and priority support on higher tiers.',
    price: 'From $129/month.',
    cta: { label: 'See Plans →', href: '/pricing' },
  },
  {
    icon: Terminal,
    title: 'Custom Data Projects (Python-Powered)',
    body: 'Our engineers write purpose-built Python scripts for every complex project — filtering massive datasets to your precise specification: decision-makers only, niche industries, unusual geographies, special formats. If it can be defined, it can be delivered.',
    price: 'Custom quote.',
  },
  {
    icon: Compass,
    title: 'Data Strategy & Recommendations',
    body: 'Not sure what data you need? Complete our 10-minute survey. A strategist analyses your business, market, and goals — then delivers a written recommendation: what to buy, how much, and how to use it for maximum response.',
    price: 'Free with any order; $49 standalone (credited back if you purchase within 30 days).',
  },
  {
    icon: Send,
    title: 'Outreach Best-Practice Support',
    subtitle: 'Add-on',
    body: 'Clean data deserves clean usage. We advise on sending best practices, warm-up schedules, message templates, and follow-up sequences — so your campaigns land in inboxes, not spam folders, and comply with the rules of every market you contact.',
  },
];
---

<BaseLayout
  title="B2B Prospect Research & Custom Data Services | LeadVault"
  description="Custom prospect research, email list cleaning, custom-filtered datasets, buyer–seller matching, and data strategy — LeadVault's complete research and sourcing suite for businesses worldwide."
  path="/services"
>
  <section class="section text-center">
    <p class="eyebrow">Services</p>
    <h1 class="mt-2 text-4xl font-extrabold text-white sm:text-5xl">One Vault. Every Data Service Your Business Needs.</h1>
    <p class="mx-auto mt-5 max-w-3xl text-white/75">
      We don't just hand over lists. We source, verify, clean, filter, match, and advise — and when
      your challenge is unusual, we build the tool that solves it.
    </p>
  </section>

  <section class="section-alt">
    <div class="section">
      <div class="columns-1 gap-6 lg:columns-2">
      {services.map((service) => (
        <div id={service.id} class:list={['card mb-6 flex flex-col gap-4 break-inside-avoid-column scroll-mt-28', service.flagship && 'ring-1 ring-[var(--color-lime)]/50']}>
          <div class="flex items-start justify-between gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
              <service.icon size={24} stroke-width={1.75} aria-hidden="true" />
            </div>
            {service.flagship && (
              <span class="rounded-full bg-[var(--color-lime)] px-3 py-1 text-xs font-bold text-[var(--color-lime-dark)]">Flagship</span>
            )}
          </div>
          <div>
            <h2 class="text-xl font-bold text-white">{service.title}</h2>
            {service.subtitle && <p class="text-sm font-medium text-[var(--color-lime)]">{service.subtitle}</p>}
          </div>
          <p class="text-sm leading-relaxed text-white/75">{service.body}</p>
          {service.listIntro && <p class="text-sm font-medium text-white">{service.listIntro}</p>}
          {service.list && (
            <ul class="space-y-2">
              {service.list.map((item) => (
                <li class="flex gap-2 text-sm text-white/70">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-lime)]"></span>
                  {item}
                </li>
              ))}
            </ul>
          )}
          {service.body2 && <p class="text-sm leading-relaxed text-white/75">{service.body2}</p>}
          {service.detail && <p class="text-xs italic text-white/50">{service.detail}</p>}
          <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-2">
            <div>
              {service.price && <p class="font-semibold text-white">{service.price}</p>}
              {service.priceNote && <p class="text-xs text-white/50">{service.priceNote}</p>}
            </div>
            {service.cta && (
              <a href={service.cta.href} class="text-sm font-semibold text-[var(--color-lime)] hover:underline">
                {service.cta.label}
              </a>
            )}
          </div>
        </div>
      ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/contact" data-cta="services-not-sure" class="btn-primary">Not Sure Where to Start? Tell Us What You Need <ArrowRight size={18} /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({
    '@type': 'Service',
    position: i + 1,
    name: s.title,
    description: s.body,
    provider: { '@type': 'Organization', name: 'LeadVault' },
  })),
})} />
