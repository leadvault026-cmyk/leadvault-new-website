---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CTA_SAMPLE_DATA, CTA_SAMPLE_HREF } from '../data/site';
import {
  Database,
  Sparkles,
  Handshake,
  CalendarCheck,
  Compass,
  UserCheck,
  Send,
  MailCheck,
  Filter,
  Lightbulb,
  ArrowRight,
  ShieldCheck,
  Target,
} from '@lucide/astro';

// Repositioning master brief §13 — reworked from a flat 8-card catalogue into
// the Solutions overview hub connecting the five new dedicated pages plus the
// services that don't need one of their own (owner-approved architecture).
// "Data Cleaning & Enrichment" stays here rather than getting a dedicated
// page — its content is real but narrower in scope than the four research
// tiers, and a full hero/use-cases/FAQ page would be padding, not substance
// (owner's explicit "do not create a thin page merely to satisfy the menu").

const solutions = [
  {
    id: 'prospect-intelligence',
    icon: Sparkles,
    flagship: true,
    title: 'Prospect Intelligence',
    frame: "We know what makes a prospect valuable, but it cannot be found with simple filters.",
    who: 'Teams whose requirement cannot be solved by ordinary database filters.',
    problem: 'Standard filters tell you who exists. They don\'t tell you which companies actually fit, or who inside them matters.',
    body: 'We investigate target markets, qualify companies against project-specific criteria, identify relevant decision-makers, and verify available contact data — with supporting evidence where the assignment requires it.',
    price: 'Custom quote, scoped to research complexity.',
    cta: { label: 'See full Prospect Intelligence page →', href: '/prospect-intelligence' },
  },
  {
    id: 'qualified-prospect-data',
    icon: Database,
    title: 'Qualified Prospect Data',
    frame: 'We know the ICP. We need the companies and contacts.',
    who: 'Teams that already know exactly whom they need to reach.',
    problem: "Off-the-shelf databases give you what's already in storage, not necessarily who you actually need.",
    body: 'Tell us the industry, geography, company profile, and roles. We research it against your specification, verify every record, and deliver a clean Google Sheet (CSV and Excel also available).',
    price: 'From $29 per 100 verified prospects — see the full ladder on Pricing.',
    cta: { label: 'See full Qualified Prospect Data page →', href: '/qualified-prospect-data' },
  },
  {
    id: 'market-icp-research',
    icon: Compass,
    title: 'Market & ICP Research',
    frame: "We're not completely sure who the best target is.",
    who: 'Teams entering a new territory or validating a niche market before they prospect it.',
    problem: "You can't prospect a market you haven't defined yet.",
    body: 'We translate an ideal-customer description into a researched, addressable target market — geographic segmentation, company qualification, and decision-maker mapping included.',
    price: 'Custom quote.',
    cta: { label: 'See full Market & ICP Research page →', href: '/market-icp-research' },
  },
  {
    id: 'decision-maker-intelligence',
    icon: UserCheck,
    title: 'Decision-Maker Intelligence',
    frame: 'We know the companies. We need the right people.',
    who: 'Teams that already have the companies, but need the right person inside each one.',
    problem: 'A valid email is not valuable if it belongs to the wrong person.',
    body: 'We research the roles and people most relevant to your commercial objective — owners, executives, procurement, technical buyers — then enrich with available verified contact information.',
    price: 'Custom quote.',
    cta: { label: 'See full Decision-Maker Intelligence page →', href: '/decision-maker-intelligence' },
  },
  {
    id: 'monthly-research',
    icon: CalendarCheck,
    title: 'Monthly Research Retainer',
    who: 'Teams with an ongoing, recurring need for fresh prospects — not a one-time project.',
    problem: 'A single dataset ages; a team that prospects continuously needs a continuous supply, freshly researched each cycle.',
    body: 'A recurring research engagement covering Qualified Prospect Data or Prospect Intelligence on a monthly cycle — with a strategy report and priority support on higher tiers.',
    price: 'From $199/month.',
    cta: { label: 'See plans →', href: '/pricing' },
  },
  {
    id: 'trade-desk',
    icon: Handshake,
    title: 'Trade & Counterparty Intelligence',
    frame: 'We need to identify potential buyers, suppliers, importers, distributors or other commercial counterparties.',
    subtitle: 'Powered by the LeadVault Trade Desk',
    body: 'For importers, exporters, and freight forwarders: we research and verify genuine counterparties — buyers, suppliers, and shippers — across international markets, with a strategist consultation on your trade lane.',
    price: 'From $449 per engagement.',
    cta: { label: 'See full Trade Desk page →', href: '/trade' },
  },
  {
    id: 'managed-outreach',
    icon: MailCheck,
    title: 'Intelligence-Led Outreach',
    frame: 'We have the audience. We need help taking it to market.',
    subtitle: 'Managed campaign execution',
    body: 'For businesses that want the research put into action: campaign preparation, controlled B2B email outreach, and reporting — built on qualified prospect data, not a generic list.',
    price: 'Custom quote, based on campaign requirements.',
    cta: { label: 'See full Managed Outreach page →', href: '/managed-outreach' },
  },
  {
    id: 'data-cleaning-card',
    icon: Filter,
    title: 'Data Cleaning & Enrichment',
    frame: 'We already have the records. We need better data.',
    who: 'Anyone holding a list — bought, inherited, or built in-house — that has started to bounce.',
    problem: 'An aging or unverified list damages sender reputation before you ever see the results.',
    body: 'Independent research puts B2B contact decay at roughly 22–23% per year (see the citation on our homepage). Send us any list and we return it healthy:',
    list: [
      'Deliverability verification across Office 365, Google Workspace, and every provider type',
      'Bounce and dead-address removal before you ever hit "send"',
      'Duplicate & error scrubbing',
    ],
    price: 'From $39 per 5,000 contacts cleaned.',
    cta: { label: 'Clean my list →', href: '/contact' },
  },
  {
    icon: Lightbulb,
    title: 'Data Strategy & Recommendations',
    body: 'Not sure what you need? Complete our short survey. A strategist reviews your business, market, and goals, then delivers a written recommendation — what to order, how much, and how to use it for maximum response.',
    price: 'Free with any order; $49 standalone (credited back if you order within 30 days).',
  },
  {
    icon: Send,
    title: 'Outreach Best-Practice Support',
    subtitle: 'Add-on',
    body: 'Clean data deserves clean usage. We advise on sending best practices, warm-up schedules, message templates, and follow-up sequences — so your campaigns land in inboxes, not spam folders.',
  },
];

// V2 copy (2026-10-01) — Data Cleaning & Enrichment is listed as its own
// page in the master's inventory (route /services#data-cleaning) with much
// fuller content than a single catalogue card can hold. Implemented as an
// expanded section below the grid rather than a 16th dedicated route, per
// the master's own routing — the compact card above still introduces it.
const cleaningProblems = [
  'Duplicate companies or contacts', 'Inconsistent company names', 'Broken or missing websites',
  'Inconsistent location formats', 'Missing job titles', 'Missing or outdated company/contact fields',
  'Generic categories that need better classification', 'Existing account lists that need decision-maker research',
  'Business contact information that needs review', 'Customer-defined fields that need research',
];

const decisionGuide = [
  { text: 'Already know exactly who you need — industry, roles, geography?', href: '#qualified-prospect-data', label: 'Qualified Prospect Data' },
  { text: "Requirement involves evidence or criteria a standard filter can't test?", href: '#prospect-intelligence', label: 'Prospect Intelligence' },
  { text: "Haven't defined your target market yet?", href: '#market-icp-research', label: 'Market & ICP Research' },
  { text: 'Know the companies, need the right person inside each one?', href: '#decision-maker-intelligence', label: 'Decision-Maker Intelligence' },
  { text: 'Need an ongoing supply of prospects, not a one-time list?', href: '#monthly-research', label: 'Monthly Research Retainer' },
  { text: 'Need a verified buyer, supplier, or trade counterparty?', href: '#trade-desk', label: 'Trade Desk' },
  { text: 'Want the research put into an actual outreach campaign?', href: '#managed-outreach', label: 'Intelligence-Led Outreach' },
  { text: 'Have an existing list that needs cleaning and verification?', href: '#data-cleaning', label: 'Data Cleaning & Enrichment' },
];
---

<BaseLayout
  title="B2B Prospect Intelligence Solutions | LeadVault"
  description="The complete LeadVault solution architecture — Prospect Intelligence, Qualified Prospect Data, Market & ICP Research, Decision-Maker Intelligence, Trade & Counterparty Intelligence, and Managed Outreach."
  path="/services"
>
  <section class="section text-center">
    <p class="eyebrow">Solutions</p>
    <h1 class="mt-2 text-4xl font-extrabold text-white sm:text-5xl">One Vault. Every Way to Reach the Right Prospects.</h1>
    <p class="mx-auto mt-5 max-w-3xl text-white/75">
      LeadVault researches, qualifies, enriches, and — where you want it — acts on prospect
      intelligence. Every solution below starts with the same discipline: research initiated for
      your request, not retrieved from a prebuilt list.
    </p>

    <div class="card mx-auto mt-10 max-w-3xl text-left">
      <h2 class="text-lg font-bold text-white">Not Sure Where to Start?</h2>
      <ul class="mt-4 space-y-3">
        {decisionGuide.map((d) => (
          <li class="flex flex-wrap items-baseline gap-x-2 text-sm text-white/75">
            <span>{d.text}</span>
            <a href={d.href} class="font-semibold text-[var(--color-lime)] hover:underline">{d.label} →</a>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-xs text-white/50">Still not sure? <a href="/contact" class="underline hover:text-[var(--color-lime)]">Tell us what you need</a> and a strategist will point you to the right one.</p>
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <div class="columns-1 gap-6 lg:columns-2">
      {solutions.map((service) => (
        <div id={service.id} class:list={['card mb-6 flex flex-col gap-4 break-inside-avoid-column scroll-mt-28', service.flagship && 'ring-1 ring-[var(--color-lime)]/50']}>
          <div class="flex items-start justify-between gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
              <service.icon size={24} stroke-width={1.75} aria-hidden="true" />
            </div>
            {service.flagship && (
              <span class="rounded-full bg-[var(--color-lime)] px-3 py-1 text-xs font-bold text-[var(--color-lime-dark)]">Flagship</span>
            )}
          </div>
          <div>
            <h2 class="text-xl font-bold text-white">{service.title}</h2>
            {service.subtitle && <p class="text-sm font-medium text-[var(--color-lime)]">{service.subtitle}</p>}
          </div>
          {service.frame && <p class="text-sm font-medium italic text-white/60">{service.frame}</p>}
          {(service.who || service.problem) && (
            <dl class="space-y-1.5 border-l-2 border-[var(--color-lime)]/40 pl-3 text-xs">
              {service.who && (
                <div class="flex gap-1.5"><dt class="shrink-0 font-semibold uppercase tracking-wide text-white/50">Who it's for:</dt><dd class="text-white/70">{service.who}</dd></div>
              )}
              {service.problem && (
                <div class="flex gap-1.5"><dt class="shrink-0 font-semibold uppercase tracking-wide text-white/50">The problem:</dt><dd class="text-white/70">{service.problem}</dd></div>
              )}
            </dl>
          )}
          <p class="text-sm leading-relaxed text-white/75">{service.body}</p>
          {service.list && (
            <ul class="space-y-2">
              {service.list.map((item) => (
                <li class="flex gap-2 text-sm text-white/70">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-lime)]"></span>
                  {item}
                </li>
              ))}
            </ul>
          )}
          <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-2">
            <div>
              {service.price && <p class="font-semibold text-white">{service.price}</p>}
            </div>
            {service.cta && (
              <a href={service.cta.href} class="text-sm font-semibold text-[var(--color-lime)] hover:underline">
                {service.cta.label}
              </a>
            )}
          </div>
        </div>
      ))}
      </div>
    </div>
  </section>

  <section id="data-cleaning" class="section scroll-mt-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Data Cleaning & Enrichment, In Depth</p>
      <h2 class="mt-2 text-2xl font-bold text-white sm:text-3xl">Already Have the Records? Make Them More Usable.</h2>
      <p class="mt-5 text-white/75">
        You do not always need a new prospect list. If your team already owns a business dataset,
        LeadVault can help improve its structure, consistency and completeness. The work is scoped
        around the fields you already have, the fields you need and the quality problems preventing
        the file from being used effectively.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-3xl">
      <h3 class="text-center text-lg font-bold text-white">Common Problems We Can Address</h3>
      <div class="mt-5 flex flex-wrap justify-center gap-2">
        {cleaningProblems.map((p) => (
          <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-sm text-white/80">{p}</span>
        ))}
      </div>
    </div>

    <div class="mx-auto mt-10 grid max-w-4xl gap-6 sm:grid-cols-2">
      <div class="card">
        <h3 class="flex items-center gap-2 text-base font-bold text-white"><Filter size={18} class="text-[var(--color-lime)]" /> Cleaning and Enrichment Are Different</h3>
        <p class="mt-3 text-sm leading-relaxed text-white/70">
          Cleaning improves the structure and consistency of information already present.
          Enrichment researches additional information to complete or improve the record. A project
          can involve one or both — the scope should specify which fields are being cleaned, which
          are being researched and what counts as an acceptable completed record.
        </p>
      </div>
      <div class="card">
        <h3 class="flex items-center gap-2 text-base font-bold text-white"><ShieldCheck size={18} class="text-[var(--color-lime)]" /> Customer-Owned Data Comes First</h3>
        <p class="mt-3 text-sm leading-relaxed text-white/70">
          LeadVault preserves the customer's original identifiers and avoids silently changing
          important business information without a research basis. Where a field is uncertain, it is
          better to flag the issue than manufacture certainty.
        </p>
      </div>
    </div>

    <div class="card mx-auto mt-10 max-w-3xl">
      <h3 class="flex items-center gap-2 text-base font-bold text-white"><Target size={18} class="text-[var(--color-lime)]" /> When Decision-Maker Intelligence Is the Better Fit</h3>
      <p class="mt-3 text-sm leading-relaxed text-white/75">
        If the main problem is that the companies are correct but the people are missing, the
        project may be better framed as <a href="/decision-maker-intelligence" class="font-medium text-[var(--color-lime)] hover:underline">Decision-Maker Intelligence</a>. If the main
        problem is inconsistent, duplicate or incomplete records across many fields, Data Cleaning &
        Enrichment is the better starting point.
      </p>
    </div>

    <div class="mt-10 text-center">
      <a href="/contact" data-cta="services-data-cleaning" class="btn-primary">Discuss Data Cleaning & Enrichment <ArrowRight size={18} /></a>
    </div>
  </section>

  <section class="section-alt">
    <div class="section text-center">
      <p class="mx-auto max-w-xl text-sm text-white/60">
        Or skip the labels entirely. Tell us what you are trying to accomplish and we will help
        determine the appropriate research approach.
      </p>
      <div class="mt-5 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a href="/contact" data-cta="services-not-sure" class="btn-primary">Not Sure Where to Start? Tell Us What You Need <ArrowRight size={18} /></a>
        <a href={CTA_SAMPLE_HREF} class="btn-outline">{CTA_SAMPLE_DATA}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: solutions.map((s, i) => ({
    '@type': 'Service',
    position: i + 1,
    name: s.title,
    description: s.body,
    provider: { '@type': 'Organization', name: 'LeadVault' },
  })),
})} />
