---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { CATALOG_CATEGORIES } from '../data/catalog';
import { ArrowRight, Clock } from '@lucide/astro';
---

<BaseLayout
  title="Browse Data Categories — Request Verified B2B Datasets | LeadVault"
  description="Explore LeadVault's data categories — trade & logistics, e-commerce, executives, insurance, real estate and more. Request any dataset; sourced fresh and delivered by email."
  path="/data-catalog"
>
  <section class="section text-center">
    <p class="eyebrow">Data Catalog</p>
    <h1 class="mt-2 text-4xl font-extrabold text-white sm:text-5xl">The Catalog: Tell Us What You Need. We Source It Fresh.</h1>
    <p class="mx-auto mt-5 max-w-3xl text-white/75">
      Because LeadVault data is harvested on request — not stored in a warehouse — this catalog
      shows what we source, not what's sitting on a shelf. Choose a category, tell us your
      specification, and receive a quote within 24 hours. Datasets are delivered to your email as
      verified, bounce-free CSV files.
    </p>
    <p class="mx-auto mt-3 max-w-2xl text-sm italic text-white/45">
      Phase 2 preview: a full self-serve client portal with instant purchase and download is in
      development. Join the waitlist at the bottom of this page.
    </p>
  </section>

  <section class="section !pt-0">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {CATALOG_CATEGORIES.map((cat) => (
        <div class="card flex flex-col gap-4">
          <ImagePlaceholder caption={`Sample: ${cat.name}`} ratio="aspect-video" class="!rounded-lg" />
          <div class="flex items-start justify-between gap-2">
            <h2 class="text-lg font-semibold text-white">{cat.name}</h2>
            {cat.highDemand && (
              <span class="shrink-0 rounded-full bg-[var(--color-teal)] px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-[var(--color-teal-dark)]">
                High demand
              </span>
            )}
          </div>
          <p class="flex-1 text-sm leading-relaxed text-white/70">{cat.description}</p>
          <p class="flex items-center gap-1.5 text-xs text-white/50">
            <Clock size={14} aria-hidden="true" /> {cat.turnaround}
          </p>
          <a href={`/contact?need=${cat.slug}`} class="btn-teal w-full !py-2.5 text-sm">
            Request This Dataset
          </a>
        </div>
      ))}
    </div>

    <p class="mx-auto mt-10 max-w-2xl text-center text-sm text-white/60">
      Every delivery includes: verification report summary · replacement guarantee · optional
      strategist notes.
    </p>

    <div class="card mx-auto mt-10 flex max-w-2xl flex-col items-center gap-4 text-center">
      <h2 class="text-xl font-bold text-white">Join the Portal Waitlist</h2>
      <p class="text-sm text-white/70">
        Be first to know when instant self-serve purchase and download launches in Phase 2.
      </p>
      <form
        name="portal-waitlist"
        method="POST"
        data-netlify="true"
        netlify-honeypot="company-website"
        class="flex w-full flex-col gap-3 sm:flex-row"
      >
        <input type="hidden" name="form-name" value="portal-waitlist" />
        <div class="hidden">
          <label>
            Don't fill this out if you're human: <input name="company-website" />
          </label>
        </div>
        <label class="sr-only" for="waitlist-email">Email</label>
        <input
          id="waitlist-email"
          name="email"
          type="email"
          required
          placeholder="you@company.com"
          class="w-full min-w-0 rounded-md border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder:text-white/40 focus:border-[var(--color-teal)] focus:outline-none"
        />
        <button type="submit" class="btn-teal whitespace-nowrap text-sm">Join Waitlist <ArrowRight size={16} /></button>
      </form>
    </div>

    <div class="mt-8 text-center">
      <a href="/contact" class="btn-outline">Request a Dataset <ArrowRight size={18} /></a>
    </div>
  </section>
</BaseLayout>
