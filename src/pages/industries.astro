---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  ShoppingCart,
  Megaphone,
  Ship,
  Code,
  Users,
  TrendingUp,
  Stethoscope,
  ArrowRight,
  Building2,
  UserCheck,
  CheckCircle2,
  Database,
  Factory,
  AlertTriangle,
  HelpCircle,
} from '@lucide/astro';
import { CTA_PRIMARY } from '../data/site';

// Master commercial copy package (2026-10-01) — this page is now structured
// to match the master's 7 named industry sections exactly (title, body,
// "Typical research," "Relevant roles") rather than the earlier 5-group,
// 17-item hub. The earlier grouped approach was a deliberate choice against
// per-item padding (see prior ASSUMPTIONS.md entries), but the master
// supplies real per-industry depth for exactly 7 named markets — including a
// Healthcare & Specialist Services section with a concrete example that
// didn't exist on this page before — so master wins on structure here.
// Markets the master doesn't name individually (fintech, insurance, real
// estate, market research, call centers, events, wholesalers) are preserved
// as a compact link-out list rather than dropped, since they're genuine,
// already-served markets (see Data Catalog) — full card treatment for each
// would reintroduce the templated-padding problem the master guards against.
const industries = [
  {
    icon: Megaphone,
    title: 'Marketing Agencies',
    body: "Agencies rarely have one permanent ICP. Each client can bring a different market, geography, offer, decision-maker and campaign objective. LeadVault can operate as a research layer behind those campaigns: turning the client's targeting brief into account criteria, researching matching companies, identifying relevant stakeholders and delivering the fields the agency needs for outreach or campaign operations.",
    questions: ['Which businesses fit this client\'s exact niche?', 'Which locations or company characteristics matter?', 'Which titles/functions are appropriate for this offer?', 'What should be excluded before the list reaches campaign production?'],
    typical: ['Client-specific ICP lists', 'Local or national businesses', 'Industry segmentation', 'Decision-maker mapping', 'Custom qualification criteria', 'Recurring campaign data', 'Enrichment of agency-owned lists'],
    roles: 'Owners and founders for smaller businesses; marketing, sales, operations or commercial leaders for larger organizations; and other functions defined by the client\'s offer.',
    deeper: 'When the agency\'s client asks for a niche that cannot be represented cleanly by standard filters, Prospect Intelligence can investigate the condition before records are delivered.',
  },
  {
    icon: Code,
    title: 'SaaS & Technology',
    body: 'Technology companies often have access to prospecting software already. The challenge is frequently not finding records; it is defining the right accounts and understanding which organizations have the characteristics that make the product relevant.',
    questions: ['Which sub-segments of our market are the strongest fit?', 'Which company sizes or operating models should be prioritized?', 'Which publicly observable capabilities or business characteristics matter?', 'Do we need one persona or several stakeholders?'],
    typical: ['ICP account lists', 'Market segmentation', 'Company-size and geography criteria', 'Business-model research', 'Observable technology or capability signals where appropriate', 'Department mapping', 'Stakeholder research', 'Recurring outbound datasets'],
    roles: 'Depending on the product: IT, engineering, security, operations, finance, revenue, sales, marketing, customer success, procurement or executive leadership.',
    example: 'A SaaS company selling compliance software to manufacturers may need more than "manufacturing companies + CEO." The account criteria may require certain operating characteristics, while the relevant buying group could include compliance, quality, operations, IT and procurement.',
  },
  {
    icon: Stethoscope,
    title: 'Healthcare & Specialist Providers',
    body: '"Medical providers" can include hospitals, clinics, chiropractors, imaging centers, dental practices, behavioral-health providers and many other organizations with different operating models and decision structures.',
    questions: ['Which provider types actually fit the offer?', 'Which states or cities matter?', 'Does the provider publicly indicate a specific service, payment arrangement or referral model?', 'Which business or administrative contact is relevant?'],
    typical: ['Provider-type segmentation', 'Location research', 'Specialty research', 'Practice qualification', 'Public evidence capture', 'Administrator/owner/business contact research', 'Custom healthcare-related fields that are legitimate and commercially relevant'],
    example: 'Identify providers in selected U.S. states that publicly indicate they accept Letters of Protection, medical liens or attorney-referred injury patients. Include provider type, qualification basis, supporting source and a relevant business contact where available.',
    important: "LeadVault's work here is B2B prospect research. It is not patient-data research and should not involve private medical information.",
  },
  {
    icon: Users,
    title: 'Recruitment & Staffing',
    body: "Recruitment businesses can have two distinct research problems: identifying organizations likely to become clients and researching the people responsible for hiring or workforce decisions.",
    questions: ['Which companies fit our staffing specialization?', 'Which locations or industries are most relevant?', 'Which organizations show an observable hiring or expansion signal where such research is part of scope?', 'Who owns recruitment, HR, talent acquisition or the relevant department?'],
    typical: ['Target-employer lists', 'Industry/location segmentation', 'Employer qualification', 'HR and talent contacts', 'Department leadership', 'Company enrichment', 'Recurring business-development datasets'],
    roles: 'Owners in smaller businesses; HR leaders; talent-acquisition professionals; operations leaders; department heads; and executive stakeholders depending on the staffing proposition.',
    deeper: 'When the agency wants companies meeting a specific operational or hiring condition rather than every employer in a broad industry.',
  },
  {
    icon: TrendingUp,
    title: 'Financial & Professional Services',
    body: 'Professional-service firms often need targeting based on business characteristics that are more nuanced than industry alone. An accounting service, legal-service provider, insurance-related business, consulting firm or specialist B2B service may each define a valuable account differently.',
    questions: ['Which ownership or operating profiles fit?', 'Which company sizes or locations are commercially viable?', 'Which specialties or customer types matter?', 'Who controls the relevant financial, operational or executive decision?'],
    typical: ['Professional practices', 'Owner-led businesses', 'Finance/operations stakeholder research', 'Niche company qualification', 'Location and size criteria', 'Evidence-backed specialist research', 'Custom data projects'],
    roles: 'Owners, partners, finance leaders, operations leaders, administrators, procurement and executives depending on the offer.',
  },
  {
    icon: Ship,
    title: 'Trade, Import, Export & Distribution',
    body: 'Trade research focuses on commercial relationships rather than simply job titles. The customer may need to know who imports a product, who distributes it, who supplies it, who wholesales it or which companies could be credible commercial buyers in a target market.',
    questions: ['Does the company actually operate in the product category?', 'What commercial role does it appear to play?', 'Is it a buyer, supplier, distributor, wholesaler, importer, exporter or manufacturer?', 'Which business contact is relevant to a commercial approach?'],
    typical: ['Importers', 'Exporters', 'Distributors', 'Wholesalers', 'Manufacturers', 'Commercial buyers', 'Suppliers', 'Counterparties', 'Product relevance', 'Company verification', 'Public evidence', 'Commercial contact research'],
    example: 'A request for U.S. rice-related businesses should not become a generic list of food companies. The research should distinguish companies with meaningful relevance to rice import, distribution, wholesale or commercial purchasing from businesses that merely sit inside a broad food category.',
    cta: { label: 'See the dedicated Trade Desk page', href: '/trade' },
  },
  {
    icon: ShoppingCart,
    title: 'E-commerce, Retail & Consumer-Facing Businesses',
    body: 'Businesses selling services or technology into e-commerce and retail markets often need to segment targets by channel, product category, geography, operating model or footprint.',
    questions: ['Is the company primarily online, physical retail or omnichannel?', 'Which product category does it operate in?', 'How large or geographically distributed is the business?', 'Which functions own e-commerce, marketing, operations or technology?'],
    typical: ['Brands', 'Retailers', 'Online sellers', 'Multi-location operators', 'Product/category segmentation', 'Store or location research', 'E-commerce and marketing stakeholders', 'Operations leaders', 'Company enrichment'],
    roles: 'E-commerce, digital, marketing, operations, technology, merchandising, commercial leadership and executive roles depending on the offer.',
  },
  {
    icon: Factory,
    title: 'Industrial, Manufacturing & B2B Services',
    body: 'Industrial markets frequently contain specialized capabilities that broad industry codes do not capture well. A supplier may care about a manufacturing process, certification, product category, facility type, customer market or operating footprint. A service provider may need organizations with a specific physical or operational requirement.',
    typical: ['Manufacturers by niche', 'Facility or capability research', 'Distributors and suppliers', 'Company-size/location criteria', 'Operations and procurement stakeholders', 'Evidence-backed qualification', 'Custom account fields'],
    roles: 'Operations, plant/facility leadership, engineering, procurement, supply chain, quality, compliance, finance and executive leadership depending on the proposition.',
  },
];

const otherMarkets = ['Fintech, Lending & Payments', 'Insurance Brokers & Agents', 'Real Estate & Property Marketing', 'Market Research & Consulting', 'Call Centers & Telemarketing', 'Events & Trade Shows'];

const researchChain = [
  { icon: Building2, label: 'Company' },
  { icon: UserCheck, label: 'Decision-Maker' },
  { icon: CheckCircle2, label: 'Verified Contact' },
  { icon: Database, label: 'Research Dataset' },
];
---

<BaseLayout
  title="Prospect Intelligence by Industry | LeadVault"
  description="See how LeadVault applies B2B prospect intelligence, decision-maker research and qualification across agencies, SaaS, recruitment, financial services, trade, e-commerce and specialist markets."
  path="/industries"
>
  <section class="section text-center">
    <p class="eyebrow">Prospect Intelligence by Industry</p>
    <h1 class="mt-2 text-4xl font-extrabold text-white sm:text-5xl">Different Markets. One Research Discipline.</h1>
    <p class="mx-auto mt-5 max-w-2xl text-white/75">
      Industry tells us where to look. Your commercial requirement tells us what to research.
      LeadVault adapts the same discover, qualify, enrich, verify and deliver method to different
      markets without pretending that every industry can be prospected the same way.
    </p>
    <div class="mt-8">
      <a href="/contact" data-cta="industries-hero" class="btn-primary">{CTA_PRIMARY} <ArrowRight size={18} /></a>
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <div class="mx-auto grid max-w-4xl grid-cols-1 items-stretch gap-3 sm:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr]">
        {researchChain.map((step, i) => (
          <>
            <div class="card flex flex-col items-center gap-2 py-4 text-center">
              <step.icon size={22} class="text-[var(--color-lime)]" aria-hidden="true" />
              <span class="text-xs font-semibold text-white">{step.label}</span>
            </div>
            {i < researchChain.length - 1 && (
              <div class="hidden items-center justify-center sm:flex" aria-hidden="true">
                <ArrowRight size={18} class="text-white/30" />
              </div>
            )}
          </>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-2">
      {industries.map((ind) => (
        <div class="card flex flex-col gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
            <ind.icon size={22} stroke-width={1.75} aria-hidden="true" />
          </div>
          <h2 class="text-lg font-bold text-white">{ind.title}</h2>
          <p class="text-sm leading-relaxed text-white/75">{ind.body}</p>
          {ind.questions && (
            <div>
              <p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-white/50"><HelpCircle size={13} /> Common research questions</p>
              <ul class="mt-1.5 space-y-1">
                {ind.questions.map((q) => (
                  <li class="text-sm italic text-white/70">“{q}”</li>
                ))}
              </ul>
            </div>
          )}
          {ind.typical && (
            <div class="rounded-lg border border-white/10 bg-white/5 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-white/50">Typical research</p>
              <p class="mt-1.5 text-sm text-white/80">{ind.typical.join('; ')}</p>
            </div>
          )}
          {ind.example && (
            <div class="rounded-lg border border-white/10 bg-white/5 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-white/50">Example</p>
              <p class="mt-1.5 text-sm text-white/80">{ind.example}</p>
            </div>
          )}
          {ind.roles && (
            <p class="text-xs text-white/60"><span class="font-semibold text-white/80">Relevant roles:</span> {ind.roles}</p>
          )}
          {ind.deeper && (
            <p class="text-xs text-white/60"><span class="font-semibold text-white/80">When deeper intelligence helps:</span> {ind.deeper}</p>
          )}
          {ind.important && (
            <p class="flex items-start gap-1.5 text-xs italic text-white/50"><AlertTriangle size={13} class="mt-0.5 shrink-0" /> {ind.important}</p>
          )}
          {ind.note && <p class="text-xs italic text-white/50">{ind.note}</p>}
          {ind.cta && (
            <a href={ind.cta.href} class="mt-auto text-sm font-semibold text-[var(--color-lime)] hover:underline">{ind.cta.label} →</a>
          )}
        </div>
      ))}
    </div>

    <div class="card mx-auto mt-10 max-w-3xl text-center">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-white/50">Other Markets We Support</h3>
      <p class="mt-3 text-sm text-white/70">{otherMarkets.join(' · ')}</p>
      <a href="/data-catalog" class="mt-3 inline-block text-sm font-semibold text-[var(--color-lime)] hover:underline">Browse Research Capabilities →</a>
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-xl font-bold text-white">What Changes by Industry — and What Does Not</h2>
        <p class="mt-4 text-sm leading-relaxed text-white/75">
          The sources, terminology, qualification signals and relevant roles can change dramatically
          between markets. What does not change is the discipline: define the requirement, discover
          candidates, qualify fit, enrich the record, verify available information and deliver a
          usable result.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="card mx-auto flex max-w-2xl flex-col items-center gap-4 text-center">
      <h2 class="text-xl font-bold text-white">Do Not See Your Industry?</h2>
      <p class="text-white/70">
        This page shows examples, not the boundaries of LeadVault's research. If your market is
        legitimate B2B and the qualification can be researched responsibly from business and public
        information, send us the requirement — we will assess whether the project is feasible and
        what research depth it needs.
      </p>
      <a href="/contact" class="btn-primary">{CTA_PRIMARY} <ArrowRight size={18} /></a>
    </div>
  </section>
</BaseLayout>
