---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  ShoppingCart,
  Megaphone,
  Mail,
  Ship,
  Code,
  Users,
  Home as HomeIcon,
  CreditCard,
  TrendingUp,
  Shield,
  BarChart3,
  Phone,
  Calendar,
  Package,
  ArrowRight,
} from '@lucide/astro';

// Grouped rather than a flat list (credibility-pass round — see ASSUMPTIONS.md).
// The "Sales & Growth Teams" group leads because it contains the three ICPs
// this acquisition push is prioritizing (marketing/lead-gen agencies, SaaS,
// and — pending validation — recruitment sits in its own group below rather
// than folded in here). This is a strategic ordering choice, not a claim
// about actual demand: nothing on this page says these are "highest-demand"
// or "most popular," since that isn't something we can currently prove.
const groups = [
  {
    label: 'Sales & Growth Teams',
    items: [
      {
        icon: Megaphone,
        title: 'Marketing & Advertising Agencies',
        body: "Buy verified data for your clients' campaigns and white-label our delivery. One agency partner, unlimited client use cases.",
        note: '(Ask about Agency Partner Plans.)',
      },
      {
        icon: Mail,
        title: 'Cold Email & Outreach Teams',
        body: 'Deliverability is your lifeblood. Freshly verified prospects and our own MX-sorting and cleaning pipeline protect your domains and reply rates.',
      },
      {
        icon: Code,
        title: 'SaaS & Software Companies',
        body: 'Decision-maker data filtered by role, company size, and tech-relevant signals for your outbound engine.',
      },
      {
        icon: ShoppingCart,
        title: 'E-commerce & Online Retail',
        body: 'Reach suppliers, wholesale buyers, affiliates, and B2B customers. Clean data powers your cold campaigns and partnership outreach.',
      },
    ],
  },
  {
    label: 'Talent & Recruitment',
    items: [
      {
        icon: Users,
        title: 'Recruitment & Staffing',
        body: 'Source both sides: hiring decision-makers as clients, and candidate pools by profession and region.',
      },
    ],
  },
  {
    label: 'Professional & Financial Services',
    items: [
      {
        icon: TrendingUp,
        title: 'Investment & Financial Services',
        body: 'Verified investor leads, high-net-worth prospects, financial advisors, and capital-seeking businesses — for firms raising funds, selling investment products, or building client books.',
      },
      {
        icon: CreditCard,
        title: 'Fintech, Lending & Payments',
        body: 'Verified SME and merchant data for product outreach — compliant and current.',
      },
      {
        icon: Shield,
        title: 'Insurance Brokers & Agents',
        body: 'Individuals and businesses matching your policy products, fresh enough to still be shopping.',
      },
      {
        icon: HomeIcon,
        title: 'Real Estate & Property Marketing',
        body: 'Investor lists, buyer prospects, and developer contacts in your target locations.',
      },
      {
        icon: BarChart3,
        title: 'Market Research & Consulting',
        body: "Custom datasets built to your study's exact specification, delivered research-ready.",
      },
    ],
  },
  {
    label: 'Trade & Distribution',
    items: [
      {
        icon: Ship,
        title: 'Importers, Exporters & Freight Forwarders',
        body: 'Our founding specialty.',
        cta: { label: 'Dedicated page →', href: '/trade' },
      },
      {
        icon: Package,
        title: 'Wholesalers & Distributors',
        body: 'Retailer and reseller contacts across your product categories and territories.',
      },
    ],
  },
  {
    label: 'Outreach & Events',
    items: [
      {
        icon: Phone,
        title: 'Call Centers & Telemarketing',
        body: 'Volume with validity: contact data that keeps agents talking to real people.',
      },
      {
        icon: Calendar,
        title: 'Events & Trade Shows',
        body: 'Fill rooms and exhibitor lists with verified industry contacts.',
      },
    ],
  },
];
---

<BaseLayout
  title="Prospect Research Examples by Industry | LeadVault"
  description="From marketing agencies and recruiters to SaaS, insurance, and real estate — examples of the prospect research LeadVault can support, industry by industry."
  path="/industries"
>
  <section class="section text-center">
    <p class="eyebrow">Prospect Research Examples</p>
    <h1 class="mt-2 text-4xl font-extrabold text-white sm:text-5xl">Examples of the Research We Support.</h1>
    <p class="mx-auto mt-5 max-w-3xl text-white/75">
      LeadVault can research prospects across industries — this page shows what that looks like for
      the businesses we work with most. Every example below shares one trait: growth depends on
      reaching the right people, reliably. Don't see your exact situation? We can still likely help —
      tell us the requirement.
    </p>
  </section>

  <section class="section-alt">
    <div class="section space-y-14">
      {groups.map((group) => (
        <div>
          <h2 class="text-xl font-bold text-white sm:text-2xl">{group.label}</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((ind) => (
              <div class="card flex flex-col gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
                  <ind.icon size={22} stroke-width={1.75} aria-hidden="true" />
                </div>
                <h3 class="text-lg font-semibold text-white">{ind.title}</h3>
                <p class="text-sm leading-relaxed text-white/70">{ind.body}</p>
                {ind.note && <p class="text-xs italic text-white/50">{ind.note}</p>}
                {ind.cta && (
                  <a href={ind.cta.href} class="mt-auto text-sm font-semibold text-[var(--color-lime)] hover:underline">
                    {ind.cta.label}
                  </a>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="card flex flex-col items-center gap-4 text-center">
        <h2 class="text-xl font-bold text-white">Don't see your industry?</h2>
        <p class="max-w-xl text-white/70">If your growth depends on reaching people, we can source for you.</p>
        <a href="/contact" class="btn-primary">Ask Us <ArrowRight size={18} /></a>
      </div>
    </div>
  </section>
</BaseLayout>
