---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { ShieldCheck, ListFilter, Search, Database, UserCheck, Terminal, Wrench, Sparkles, MailCheck, ArrowRight } from '@lucide/astro';

// Repositioning master brief §15 — reframed around outcomes (multi-source
// discovery, qualification, evidence capture, decision-maker enrichment,
// verification, normalization, deduplication, quality control, human review)
// rather than email/campaign infrastructure. "Campaign Infrastructure" was
// removed from this list — sending infrastructure is now Managed Outreach's
// own domain (/managed-outreach); two new cards (Qualification & Evidence
// Capture, Decision-Maker Enrichment) were added in its place so the count
// stays at 7. No vendor names, credentials, or proprietary architecture named.
const tools = [
  {
    icon: Database,
    title: 'Multi-Source Discovery',
    body: 'We research companies and public business information from multiple sources rather than treating any single source as authoritative.',
  },
  {
    icon: ShieldCheck,
    title: 'Qualification & Evidence Capture',
    body: 'Where a project requires it, we apply qualification rules and capture the public evidence supporting why a company fits — not just whether it matches a filter.',
  },
  {
    icon: UserCheck,
    title: 'Decision-Maker Enrichment',
    body: 'We identify the roles relevant to the commercial decision, then enrich the record with available business contact and company information.',
  },
  {
    icon: MailCheck,
    title: 'Email Verification',
    body: 'Confirms every address is real and deliverable — checked across all provider types (Office 365, Google Workspace, independent and broker mail servers), so "verified" means exactly that.',
  },
  {
    icon: ListFilter,
    title: 'Deliverability & Hygiene',
    body: 'Separates any verified list into per-provider segments and detects likely bounces, dormant mailboxes, and dead domains before anything reaches you.',
  },
  {
    icon: Terminal,
    title: 'Precision Filtering & Normalization',
    body: 'A purpose-built filtering process that narrows large datasets to precise specifications — roles, industries, geographies, company sizes — with deduplication and normalization before delivery.',
  },
  {
    icon: Wrench,
    title: 'Human Review & Custom Tools',
    body: "Ambiguous cases get human review, not an automated guess. Some projects also need instruments that don't exist yet — we design and build them, and the next challenge teaches us something new.",
  },
];

const pipelineStages = [
  { icon: Search, label: 'RESEARCH', desc: 'Companies and prospects discovered to your exact specification' },
  { icon: ListFilter, label: 'QUALIFY', desc: 'Checked against your criteria — not just an industry label' },
  { icon: Sparkles, label: 'ENRICH', desc: 'Decision-makers identified, contact and company details added' },
  { icon: ShieldCheck, label: 'VERIFY', desc: 'Deliverability checks, bounce & activity screening' },
  { icon: MailCheck, label: 'DELIVER', desc: 'Clean Google Sheet or CSV, straight to your inbox' },
];
---

<BaseLayout
  title="Research & Verification Engine | LeadVault"
  description="The research and verification engine behind LeadVault: multi-source discovery, qualification, decision-maker enrichment, email verification, and human review — built in-house, not rented."
  path="/tools"
>
  <section class="section grid items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Research & Verification Engine</p>
      <h1 class="mt-2 text-4xl font-extrabold leading-tight text-white sm:text-5xl">The Research & Verification Engine Behind LeadVault</h1>
      <p class="mt-5 text-white/75">
        A LeadVault project can combine multiple discovery, qualification, enrichment,
        verification, and quality-control methods depending on the assignment. Most data companies
        rent their capabilities. LeadVault engineers its own — and when a client's challenge doesn't
        fit an existing method, we build a new one.
      </p>
      <p class="mt-4 text-sm text-white/50">
        No single source has to determine the final result.
      </p>
    </div>
    <ImagePlaceholder
      caption="IMAGE: multi-monitor engineering desk, dark blue tones"
      alt="Multi-monitor engineering desk with code on screen, dark blue tones"
      ratio="aspect-[4/3]"
      src="/photos/engineering-desk.jpg"
      width={1400}
      height={933}
    />
  </section>

  <section class="section-alt">
    <div class="section">
      <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Inside the Toolbox</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool) => (
          <div class="card flex flex-col gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
              <tool.icon size={22} stroke-width={1.75} aria-hidden="true" />
            </div>
            <h3 class="text-lg font-semibold text-white">{tool.title}</h3>
            <p class="text-sm leading-relaxed text-white/70">{tool.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">How the Data Pipeline Works</h2>
    <div class="mt-10">
      <div class="grid grid-cols-1 items-stretch gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {pipelineStages.map((stage) => (
          <div class="card flex flex-col items-center gap-3 text-center">
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
              <stage.icon size={26} stroke-width={1.75} aria-hidden="true" />
            </div>
            <div class="eyebrow">{stage.label}</div>
            <p class="text-sm text-white/70">{stage.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Why This Matters to You</h2>
      <p class="mx-auto mt-5 max-w-3xl text-center text-white/75">
        Every dataset is researched against your exact specification, then reviewed before it
        reaches you. When you buy from a reseller, you inherit their shortcuts. When you buy from
        LeadVault, your data has passed through a process we designed, understand, and
        continuously improve. Quality isn't a promise on a website — it's built into the process.
      </p>
      <div class="mx-auto mt-10 grid max-w-3xl gap-6 sm:grid-cols-3">
        <div class="card text-center">
          <h3 class="font-semibold text-white">Precision</h3>
          <p class="mt-2 text-sm text-white/70">Every record is filtered to your specific criteria, not a generic category.</p>
        </div>
        <div class="card text-center">
          <h3 class="font-semibold text-white">Freshness</h3>
          <p class="mt-2 text-sm text-white/70">Sourced and verified for your order — not pulled from a stored, aging database.</p>
        </div>
        <div class="card text-center">
          <h3 class="font-semibold text-white">Quality Control</h3>
          <p class="mt-2 text-sm text-white/70">Deliverability checks, bounce screening, and duplicate removal happen before anything reaches you.</p>
        </div>
      </div>
      <div class="mt-10 text-center">
        <a href="/about#data-standards" class="btn-primary">See Our Data Standards <ArrowRight size={18} /></a>
      </div>
    </div>
  </section>
</BaseLayout>
