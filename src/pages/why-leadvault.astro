---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import { CTA_PRIMARY, CTA_SAMPLE_DATA, CTA_SAMPLE_HREF } from '../data/site';
import { ArrowRight, Search, Target, UserCheck, ShieldCheck, Layers, ListChecks, XCircle, Compass, Scale, AlertOctagon } from '@lucide/astro';

// Repositioning master brief (2026-09-30) §14 + owner decision on the audit's
// conflict #4: retires the "Warehouse vs. Harvest" thesis (the brief
// explicitly prohibits "harvest" framing) in favor of "Software gives you the
// search tools, LeadVault does the research" — developed substantially on
// this page rather than just repeating the homepage's compact version of the
// same comparison (owner's explicit instruction). See ASSUMPTIONS.md.

const reasons = [
  {
    icon: Search,
    title: 'We Start With the Business Requirement',
    body: 'The first question is not "Which list do you want?" It is "What makes a company relevant to you?" That changes the entire workflow. Industry, geography and title can be part of the specification, but they do not have to be the whole specification.',
  },
  {
    icon: ListChecks,
    title: 'Qualification Comes Before Delivery',
    body: 'A discovered company is a candidate, not automatically a prospect. LeadVault checks candidates against the agreed criteria and excludes records that do not fit — especially important in niche markets where broad category matching produces false positives.',
  },
  {
    icon: ShieldCheck,
    title: "We Can Research the 'Why'",
    body: 'For suitable projects, the deliverable can include a qualification basis and supporting source — context for why a company was included. Evidence does not guarantee buyer intent; it supports the research decision.',
  },
  {
    icon: UserCheck,
    title: 'Decision-Maker Research Follows the Opportunity',
    body: 'We do not assume one universal title is correct for every company. Where the project requires it, LeadVault researches the function, responsibility and seniority most relevant to the commercial problem.',
  },
  {
    icon: Layers,
    title: 'Fresh Research for the Project',
    body: "LeadVault's proposition is research performed around the current requirement rather than simply handing over an untouched prebuilt list. That doesn't mean every fact on the internet was created today, nor can any provider guarantee data will never change — it means the project is actively researched and prepared for the current delivery.",
  },
  {
    icon: Target,
    title: 'Deliverables Are Built to Be Used',
    body: 'The result is structured for practical business use: Excel, CSV or another agreed format; consistent fields; normalized records; and project-specific columns where required. You should be able to review, import, prioritize and act on the work.',
  },
];
---

<BaseLayout
  title="Why LeadVault — B2B Prospect Intelligence vs. Database Platforms"
  description="A balanced comparison: how LeadVault's research-led prospect intelligence differs from self-service database platforms like Apollo, ZoomInfo, Hunter, Cognism, and Clay — and when each approach fits."
  path="/why-leadvault"
>
  <section class="section text-center">
    <p class="eyebrow">Why LeadVault</p>
    <h1 class="mt-2 text-4xl font-extrabold text-white sm:text-5xl">Software Gives You the Search Tools. LeadVault Does the Research.</h1>
    <p class="mx-auto mt-5 max-w-3xl text-white/75">
      Apollo, ZoomInfo, Hunter, Cognism, Clay — these are serious companies with genuinely useful
      database platforms, and for some use cases they're a reasonable choice. Why use LeadVault when
      tools like these already exist? Because sometimes the difficult part isn't finding records. It's
      deciding which records actually represent the opportunity.
    </p>
  </section>

  <section class="section-alt">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">The Category Distinction</p>
        <h2 class="mt-2 text-2xl font-bold text-white sm:text-3xl">A Database Gives You a Search Box. LeadVault Gives You an Answer.</h2>
      </div>
      <div class="mx-auto mt-10 grid max-w-4xl gap-6 sm:grid-cols-2">
        <div class="card">
          <h3 class="font-semibold text-white">Self-Service Database Platform</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/75">
            You define filters → search → export → investigate → determine fit → verify →
            prioritize → conduct outreach. The software hands you the tools; the judgment calls
            stay with you.
          </p>
        </div>
        <div class="card ring-1 ring-[var(--color-lime)]/50">
          <h3 class="font-semibold text-white">LeadVault</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/75">
            You give us the commercial brief → we discover → investigate → qualify → enrich →
            verify → prioritize → deliver. The research and the judgment calls are the service.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Six Reasons</p>
      <h2 class="mt-2 text-2xl font-bold text-white sm:text-3xl">Why Use LeadVault When B2B Databases Already Exist?</h2>
    </div>
    <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {reasons.map((r, i) => (
        <div class="card flex flex-col gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
            <r.icon size={22} stroke-width={1.75} aria-hidden="true" />
          </div>
          <h3 class="text-base font-semibold text-white">{i + 1}. {r.title}</h3>
          <p class="text-sm leading-relaxed text-white/70">{r.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Side by Side</h2>
      <div class="mt-10">
        <ComparisonTable
          caption="Database platforms versus LeadVault, factor by factor"
          headers={['Factor', 'Database Platforms', 'LeadVault']}
          rows={[
            ['Access model', 'Self-serve login & search', 'Sourced on request, delivered to you'],
            ['Qualification depth', 'Limited to standard database filters', 'Evidence-backed, project-specific criteria'],
            ['Data age at delivery', 'Not disclosed per record — periodic verification cycles, not per order', 'Verified for your order'],
            ['Bounce handling', 'Bounce rates vary by plan and provider', 'Bounces removed before delivery'],
            ['Customization', 'Limited to database filters', 'Any specification we can define, we can source'],
            ['Human guidance', 'None — software subscription', 'Strategist consultation with every engagement'],
            ['African & emerging-market coverage', 'Generally thinner, per public market reports', 'Deep, current, on-the-ground capability'],
            ['Pricing model', 'Per-seat subscriptions (commonly $600–$1,800+/yr per user; enterprise contracts far higher)', 'Pay per project or flexible monthly plans'],
            ['Best for', 'Large teams needing instant self-serve volume', "Assignments where the right answer isn't a simple filter away"],
          ]}
        />
      </div>
      <p class="mx-auto mt-6 max-w-2xl text-center text-sm text-white/60">
        These are different operating models. One is not automatically better than the other.
      </p>
    </div>
  </section>

  <section class="section">
    <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">When to Use Them — and When to Use Us</h2>
    <div class="mx-auto mt-10 grid max-w-4xl gap-6 sm:grid-cols-2">
      <div class="card">
        <h3 class="font-semibold text-white">Choose a database platform if:</h3>
        <p class="mt-3 text-sm leading-relaxed text-white/75">
          you need thousands of self-serve lookups daily, your targeting criteria fit ordinary
          filters, and your team can tolerate bounce rates and stale records as a cost of speed.
        </p>
      </div>
      <div class="card ring-1 ring-[var(--color-lime)]/50">
        <h3 class="font-semibold text-white">Choose LeadVault if:</h3>
        <p class="mt-3 text-sm leading-relaxed text-white/75">
          your target definition contains unusual or qualitative criteria; you need to identify
          the relevant person rather than any available contact; you're entering an unfamiliar
          market; or you need a smaller set of better-qualified opportunities rather than a very
          large generic list.
        </p>
      </div>
    </div>
    <p class="mx-auto mt-8 max-w-2xl text-center text-white/70">
      Some teams use both models: a database platform for instant self-serve searches, and
      LeadVault when an assignment needs research, qualification, and judgment a filter can't provide.
    </p>
  </section>

  <section class="section-alt">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <Scale size={28} class="mx-auto text-[var(--color-lime)]" aria-hidden="true" />
        <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">Why Not Just Buy More Data?</h2>
        <p class="mt-5 text-white/75">
          More data can be valuable when volume is the constraint. But if the real constraint is
          relevance, increasing the number of records can increase the amount of manual review your
          team has to perform. A 10,000-record export is not automatically better than a 500-record
          researched dataset if the sales team must investigate most of the larger file before
          knowing who actually fits.
        </p>
        <p class="mt-4 text-white/75">
          LeadVault is most useful where qualification and context matter enough to justify research
          before outreach.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="card mx-auto flex max-w-2xl items-start gap-4 text-center sm:text-left">
      <AlertOctagon size={28} class="mt-0.5 hidden shrink-0 text-[var(--color-lime)] sm:block" aria-hidden="true" />
      <div>
        <h2 class="text-lg font-bold text-white">When LeadVault Is Probably Not the Right Choice</h2>
        <p class="mt-3 text-sm leading-relaxed text-white/75">
          If your team wants unrestricted self-service access to millions of contacts every day, a
          large sales-intelligence platform may be the better fit. If your target is extremely broad
          and you do not need qualification beyond basic filters, a simple data provider may be
          sufficient. If you need private personal information, deceptive sourcing or information
          that cannot be researched legitimately, LeadVault is not the right service.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-white/75">
          LeadVault is strongest when the customer values a defined, researched result.
        </p>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <div class="card mx-auto flex max-w-2xl items-start gap-4 text-center sm:text-left">
        <XCircle size={28} class="mt-0.5 hidden shrink-0 text-[var(--color-lime)] sm:block" aria-hidden="true" />
        <div>
          <h2 class="text-lg font-bold text-white">What We Will Not Claim</h2>
          <p class="mt-3 text-sm leading-relaxed text-white/75">
            LeadVault will not promise that every qualified prospect is ready to buy, that every
            email will remain valid forever, that outreach will always receive a response, or that
            research can establish facts that are not publicly or legitimately available. Credibility
            matters more than inflated promises.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="mx-auto max-w-3xl text-center">
      <Compass size={28} class="mx-auto text-[var(--color-lime)]" aria-hidden="true" />
      <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">A Research Partner for Difficult Requirements</h2>
      <p class="mt-5 text-white/75">
        The strongest reason to use LeadVault is not that we can find a company name. Modern
        prospecting tools can do that at enormous scale. The value appears when the requirement needs
        interpretation, investigation, qualification, evidence, contact mapping or a finished
        deliverable that your team does not want to build manually.
      </p>
    </div>
  </section>

  <section class="border-t border-white/10 bg-[var(--color-bg-dark)]">
    <div class="section text-center">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">The Bottom Line</h2>
      <p class="mx-auto mt-5 max-w-3xl text-white/75">
        This combination is uncommon among self-serve database platforms:
        <strong class="text-white"> on-request research, evidence-backed qualification, decision-maker
        relevance, multi-source verification, and strategist service.</strong> That combination —
        not any single feature — is the case for choosing LeadVault when a project needs the right
        answer, not just a longer list.
      </p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a href="/contact" class="btn-primary">{CTA_PRIMARY} <ArrowRight size={18} /></a>
        <a href={CTA_SAMPLE_HREF} class="btn-outline">{CTA_SAMPLE_DATA}</a>
      </div>
      <p class="mx-auto mt-6 max-w-2xl text-xs italic text-white/50">
        This comparison reflects LeadVault's general understanding of how self-serve database
        platforms typically operate, based on publicly available information; individual vendor
        practices, data freshness, and pricing vary by provider and plan.
      </p>
    </div>
  </section>
</BaseLayout>
