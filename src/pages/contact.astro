---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { PRIORITY_COUNTRIES, OTHER_COUNTRIES } from '../data/countries';
import { NEED_OPTIONS } from '../data/catalog';
import { CONTACT_EMAIL, PHONE_DISPLAY, WHATSAPP_LINK, OFFICE_ADDRESSES } from '../data/site';
import { ArrowRight, ListChecks, ClipboardCheck, MessageCircleQuestion, ShieldCheck } from '@lucide/astro';

const industries = [
  'Import/Export & Trade',
  'Freight & Logistics',
  'E-commerce',
  'Marketing Agency',
  'SaaS/Software',
  'Recruitment',
  'Real Estate',
  'Insurance',
  'Finance/Fintech',
  'Market Research',
  'Events',
  'Wholesale/Distribution',
  'Other',
];

const volumes = ['Under 500', '500–2,500', '2,500–10,000', '10,000+'];
const budgets = ['Under $200', '$200–$500', '$500–$1,500', '$1,500+'];
const outreachOptions = ['Not sure yet', 'No — data/intelligence only', 'Yes — discuss managed outreach'];

const whatToInclude = [
  'What type of companies are you trying to reach?',
  'Which countries, states, cities or regions matter?',
  'What makes a company qualified?',
  'What should be excluded?',
  'Which people or departments matter?',
  'Which fields do you need?',
  'Approximately how many records/accounts do you need?',
  'Do you need supporting evidence?',
  'Do you need outreach support after the research?',
  'Do you have a target timeline or budget range you want us to consider?',
];

const afterSubmit = [
  'We review the requirement.',
  'We clarify anything that materially affects feasibility or scope.',
  'For suitable projects, we may research a small sample or explain the proposed approach.',
  'We confirm the appropriate service, scope, price and delivery expectation before paid work begins.',
  'Research starts after the project is approved.',
];

const briefExamples = [
  "We sell a service to independent dental practices in Florida and Georgia. We need practice owners or administrators and want to exclude large hospital groups.",
  "We export a food product and need distributors and wholesalers in Texas that actually handle the product category.",
  "We know the 150 companies we want to target but do not know which people inside them are responsible for compliance.",
];
---

<BaseLayout
  title="Research Project Brief — Start a B2B Prospect Intelligence Project | LeadVault"
  description="Tell LeadVault the market, companies, or people you need to reach. A strategist reviews your brief and responds within 24 hours with the appropriate research approach and quote."
  path="/contact"
>
  <section class="section grid gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Research Project Brief</p>
      <h1 class="mt-2 text-4xl font-extrabold leading-tight text-white sm:text-5xl">
        Tell Us Who You Need. We'll Tell You Exactly How to Reach Them.
      </h1>
      <p class="mt-5 text-white/75">
        Describe the market, companies, or people you need to reach — it takes under 10 minutes. A
        LeadVault strategist will review the brief and respond within 24 hours with the appropriate
        research approach, volume, and price. No obligation.
      </p>

      <div class="mt-8 hidden lg:block">
        <ImagePlaceholder
          caption="IMAGE: strategist on a call, world-clock motif"
          alt="Business strategist on a phone call"
          ratio="aspect-[4/3]"
          src="/photos/strategist-call.jpg"
          width={1400}
          height={933}
        />
      </div>

      <div class="card mt-8">
        <h2 class="text-lg font-bold text-white">A Useful Brief Can Be Simple</h2>
        <p class="mt-2 text-sm text-white/60">You can start with a few sentences. For example:</p>
        <ul class="mt-3 space-y-2.5">
          {briefExamples.map((ex) => (
            <li class="rounded-lg border border-white/10 bg-white/5 p-3 text-sm italic text-white/75">“{ex}”</li>
          ))}
        </ul>
        <p class="mt-3 text-xs text-white/50">Those are enough to begin a conversation. LeadVault can help turn the request into a more precise research specification.</p>
      </div>

      <div class="card mt-6">
        <h2 class="flex items-center gap-2 text-lg font-bold text-white"><ListChecks size={18} class="text-[var(--color-lime)]" /> What to Include</h2>
        <p class="mt-2 text-sm text-white/60">The more specific the requirement, the faster we can understand it. Helpful information includes:</p>
        <ul class="mt-3 space-y-1.5">
          {whatToInclude.map((item) => (
            <li class="flex items-start gap-2 text-sm text-white/75">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-lime)]"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="card mt-6">
        <h2 class="text-lg font-bold text-white">Direct Contact</h2>
        <dl class="mt-4 space-y-2 text-sm text-white/75">
          <div class="flex gap-2">
            <dt class="font-medium text-white/50">Email:</dt>
            <dd><a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-[var(--color-lime)]">{CONTACT_EMAIL}</a></dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-medium text-white/50">Phone / WhatsApp:</dt>
            <dd>
              <a href={WHATSAPP_LINK} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-lime)]">
                {PHONE_DISPLAY}
              </a>
            </dd>
          </div>
          <div class="flex gap-2">
            <dt class="shrink-0 font-medium text-white/50">Offices:</dt>
            <dd>
              {OFFICE_ADDRESSES.map((o) => (
                <p>
                  <span class="text-white/50">{o.label}:</span> {o.address}
                </p>
              ))}
            </dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-medium text-white/50">Hours:</dt>
            <dd>Mon–Fri, 9am–6pm — Lagos (WAT) &amp; Houston (CST)</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="card">
      <p class="mb-5 rounded-md border border-[var(--color-lime)]/30 bg-[var(--color-lime)]/10 px-4 py-3 text-sm text-white/85">
        <strong class="text-[var(--color-lime)]">Free, no-obligation quote.</strong> We'll review
        your requirements and recommend the right option — nothing is charged until you approve it.
      </p>
      <form
        id="lead-survey-form"
        name="lead-survey"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thank-you"
        class="space-y-5"
      >
        <input type="hidden" name="form-name" value="lead-survey" />
        <p class="hidden">
          <label>
            Don't fill this out if you're human: <input name="bot-field" />
          </label>
        </p>

        <div>
          <label for="full-name" class="mb-1.5 block text-sm font-medium text-white">Full Name *</label>
          <input id="full-name" name="Full Name" type="text" required class="lv-input" />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="business-name" class="mb-1.5 block text-sm font-medium text-white">Business Name</label>
            <input id="business-name" name="Business Name" type="text" class="lv-input" />
          </div>
          <div>
            <label for="website" class="mb-1.5 block text-sm font-medium text-white">Website</label>
            <input id="website" name="Website" type="text" placeholder="yourcompany.com" class="lv-input" />
          </div>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="email" class="mb-1.5 block text-sm font-medium text-white">Email Address *</label>
            <input id="email" name="Email Address" type="email" required class="lv-input" />
          </div>
          <div>
            <label for="phone" class="mb-1.5 block text-sm font-medium text-white">Phone / WhatsApp *</label>
            <input id="phone" name="Phone / WhatsApp" type="tel" required placeholder="+1 555 123 4567" class="lv-input" />
          </div>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="country" class="mb-1.5 block text-sm font-medium text-white">Country *</label>
            <select id="country" name="Country" required class="lv-input">
              <option value="" disabled selected>Select your country</option>
              {PRIORITY_COUNTRIES.map((c) => <option value={c}>{c}</option>)}
              <option disabled>──────────</option>
              {OTHER_COUNTRIES.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
          <div>
            <label for="industry" class="mb-1.5 block text-sm font-medium text-white">Industry *</label>
            <select id="industry" name="Industry" required class="lv-input">
              <option value="" disabled selected>Select your industry</option>
              {industries.map((i) => <option value={i}>{i}</option>)}
            </select>
          </div>
        </div>

        <div>
          <label for="need" class="mb-1.5 block text-sm font-medium text-white">What do you need? *</label>
          <select id="need" name="What do you need" required class="lv-input">
            <option value="" disabled selected>Select an option</option>
            {NEED_OPTIONS.map((n) => <option value={n.value}>{n.label}</option>)}
          </select>
        </div>

        <div>
          <label for="ideal-customer" class="mb-1.5 block text-sm font-medium text-white">
            Who is your ideal customer, counterparty, or decision-maker?
          </label>
          <input id="ideal-customer" name="Ideal Customer" type="text" placeholder="e.g. VP of Sales at 50–200 person SaaS companies" class="lv-input" />
        </div>

        <div>
          <label for="target-locations" class="mb-1.5 block text-sm font-medium text-white">Target locations</label>
          <input id="target-locations" name="Target Locations" type="text" placeholder="Countries / states / cities" class="lv-input" />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="volume" class="mb-1.5 block text-sm font-medium text-white">Approximate volume needed</label>
            <select id="volume" name="Approximate Volume" class="lv-input">
              <option value="" disabled selected>Select a range</option>
              {volumes.map((v) => <option value={v}>{v}</option>)}
            </select>
          </div>
          <div>
            <label for="budget" class="mb-1.5 block text-sm font-medium text-white">Budget range</label>
            <select id="budget" name="Budget Range" class="lv-input">
              <option value="" disabled selected>Select a range</option>
              {budgets.map((b) => <option value={b}>{b}</option>)}
            </select>
          </div>
        </div>

        <div>
          <label for="outreach-support" class="mb-1.5 block text-sm font-medium text-white">Do you need outreach support too?</label>
          <select id="outreach-support" name="Outreach Support" class="lv-input">
            <option value="" disabled selected>Select an option</option>
            {outreachOptions.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>

        <div>
          <label for="challenge" class="mb-1.5 block text-sm font-medium text-white">
            What are you trying to achieve?
          </label>
          <textarea id="challenge" name="Biggest Challenge" rows="4" class="lv-input" placeholder="e.g. your biggest challenge in reaching these prospects right now"></textarea>
        </div>

        <button type="submit" class="btn-primary w-[calc(100%-2rem)] !px-4 text-sm sm:text-base">Submit My Data Request <ArrowRight size={18} /></button>

        <p class="text-xs text-white/50">
          By submitting, you agree to be contacted by LeadVault via email, phone, or WhatsApp. We
          don't sell your personal information — your submission is handled in accordance with our
          <a href="/privacy-policy" class="underline hover:text-[var(--color-lime)]">Privacy Policy</a>.
        </p>
      </form>
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-2">
        <div>
          <h2 class="flex items-center gap-2 text-lg font-bold text-white"><ClipboardCheck size={20} class="text-[var(--color-lime)]" /> What Happens After You Submit</h2>
          <ol class="mt-4 space-y-3">
            {afterSubmit.map((step, i) => (
              <li class="flex gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-lime)] text-xs font-bold text-[var(--color-lime-dark)]">{i + 1}</span>
                <p class="text-sm text-white/75">{step}</p>
              </li>
            ))}
          </ol>
        </div>
        <div>
          <h2 class="flex items-center gap-2 text-lg font-bold text-white"><MessageCircleQuestion size={20} class="text-[var(--color-lime)]" /> You Can Start With an Imperfect Brief</h2>
          <p class="mt-4 text-sm leading-relaxed text-white/75">
            If you know the market but are unsure how to express the qualification criteria, that is
            okay — <a href="/market-icp-research" class="font-medium text-[var(--color-lime)] hover:underline">Market & ICP Research</a> exists for exactly that situation.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-white/75">
            Tell us what you sell, who you believe should buy it and what makes those organizations
            valuable. We can help turn that into a researchable specification.
          </p>

          <h3 class="mt-6 text-sm font-bold uppercase tracking-wide text-white">If You Already Have the Companies</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/75">
            If your account list already exists, describe it and explain what is missing. The
            project may be <a href="/decision-maker-intelligence" class="font-medium text-[var(--color-lime)] hover:underline">Decision-Maker Intelligence</a>, <a href="/services#data-cleaning" class="font-medium text-[var(--color-lime)] hover:underline">Data Cleaning & Enrichment</a> or another
            focused research task rather than a new prospect-discovery project.
          </p>

          <h3 class="mt-6 text-sm font-bold uppercase tracking-wide text-white">If You Need Outreach Too</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/75">
            Tell us whether you want the project to end with the research deliverable or continue
            into <a href="/managed-outreach" class="font-medium text-[var(--color-lime)] hover:underline">managed email outreach</a>. Research and outreach can be connected, but the audience
            should be qualified before campaign execution begins.
          </p>

          <div class="mt-6 flex items-start gap-3 rounded-lg border border-white/10 bg-white/5 p-4">
            <ShieldCheck size={18} class="mt-0.5 shrink-0 text-[var(--color-lime)]" aria-hidden="true" />
            <p class="text-xs leading-relaxed text-white/60">
              <strong class="text-white/80">Privacy and Responsible Use:</strong> Only request business
              information you have a legitimate reason to use. LeadVault's research and delivery
              remain subject to the site's Terms and Privacy Policy and the agreed project scope.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { NEED_SLUG_TO_OPTION, CATALOG_CATEGORIES, DATASET_TIERS } from '../data/catalog';

  const params = new URLSearchParams(window.location.search);
  const needSelect = document.getElementById('need') as HTMLSelectElement | null;
  const idealCustomer = document.getElementById('ideal-customer') as HTMLInputElement | null;

  // Data Catalog "Request This Dataset" buttons link to /contact?need=<category-slug>
  // (CLAUDE.md). Pre-fill "What do you need?" + the "ideal customer" field from it.
  const slug = params.get('need');
  if (slug) {
    const category = CATALOG_CATEGORIES.find((c) => c.slug === slug);
    const needOption = NEED_SLUG_TO_OPTION[slug] ?? (category ? 'Fresh custom dataset' : undefined);

    if (needSelect && needOption) {
      needSelect.value = needOption;
    }
    if (idealCustomer && category && !idealCustomer.value) {
      idealCustomer.value = `Interested in: ${category.name}`;
    }
  }

  // Pricing's "Request This Tier" links use /contact?tier=<slug> so a visitor's
  // exact dataset and price carry over unambiguously (payment/pricing audit
  // round — see ASSUMPTIONS.md). Pre-fills "What do you need?", "Approximate
  // volume needed", and names the tier in "ideal customer" for the strategist.
  const tierSlug = params.get('tier');
  if (tierSlug) {
    const tier = DATASET_TIERS.find((t) => t.slug === tierSlug);
    const volumeSelect = document.getElementById('volume') as HTMLSelectElement | null;

    if (tier) {
      if (needSelect) needSelect.value = 'Fresh custom dataset';
      if (volumeSelect) volumeSelect.value = tier.volumeBucket;
      if (idealCustomer && !idealCustomer.value) {
        idealCustomer.value = `Requesting: ${tier.name} — ${tier.records} prospects, ${tier.price}`;
      }
    }
  }
</script>
