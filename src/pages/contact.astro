---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { PRIORITY_COUNTRIES, OTHER_COUNTRIES } from '../data/countries';
import { NEED_OPTIONS } from '../data/catalog';
import { CONTACT_EMAIL, PHONE_DISPLAY, WHATSAPP_LINK, OFFICE_ADDRESSES } from '../data/site';
import { ArrowRight } from '@lucide/astro';

const industries = [
  'Import/Export & Trade',
  'Freight & Logistics',
  'E-commerce',
  'Marketing Agency',
  'SaaS/Software',
  'Recruitment',
  'Real Estate',
  'Insurance',
  'Finance/Fintech',
  'Market Research',
  'Events',
  'Wholesale/Distribution',
  'Other',
];

const volumes = ['Under 500', '500–2,500', '2,500–10,000', '10,000+'];
const budgets = ['Under $200', '$200–$500', '$500–$1,500', '$1,500+'];
---

<BaseLayout
  title="Get Started — Free Data Recommendation in 24 Hours | LeadVault"
  description="Tell LeadVault who you need to reach. A strategist responds within 24 hours with a tailored, no-obligation data recommendation."
  path="/contact"
>
  <section class="section grid gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Get Started</p>
      <h1 class="mt-2 text-4xl font-extrabold leading-tight text-white sm:text-5xl">
        Tell Us Who You Need. We'll Tell You Exactly How to Reach Them.
      </h1>
      <p class="mt-5 text-white/75">
        Complete the survey below — it takes under 10 minutes. Within 24 hours, a LeadVault
        strategist will send your free recommendation: the right data, the right volume, the right
        price. No obligation.
      </p>

      <div class="mt-8 hidden lg:block">
        <ImagePlaceholder
          caption="IMAGE: strategist on a call, world-clock motif"
          alt="Business strategist on a phone call"
          ratio="aspect-[4/3]"
          src="/photos/strategist-call.jpg"
          width={1400}
          height={933}
        />
      </div>

      <div class="card mt-8">
        <h2 class="text-lg font-bold text-white">Direct Contact</h2>
        <dl class="mt-4 space-y-2 text-sm text-white/75">
          <div class="flex gap-2">
            <dt class="font-medium text-white/50">Email:</dt>
            <dd><a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-[var(--color-lime)]">{CONTACT_EMAIL}</a></dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-medium text-white/50">Phone / WhatsApp:</dt>
            <dd>
              <a href={WHATSAPP_LINK} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-lime)]">
                {PHONE_DISPLAY}
              </a>
            </dd>
          </div>
          <div class="flex gap-2">
            <dt class="shrink-0 font-medium text-white/50">Offices:</dt>
            <dd>
              {OFFICE_ADDRESSES.map((o) => (
                <p>
                  <span class="text-white/50">{o.label}:</span> {o.address}
                </p>
              ))}
            </dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-medium text-white/50">Hours:</dt>
            <dd>Mon–Fri, 9am–6pm — Lagos (WAT) &amp; Houston (CST)</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="card">
      <form
        id="lead-survey-form"
        name="lead-survey"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thank-you"
        class="space-y-5"
      >
        <input type="hidden" name="form-name" value="lead-survey" />
        <p class="hidden">
          <label>
            Don't fill this out if you're human: <input name="bot-field" />
          </label>
        </p>

        <div>
          <label for="full-name" class="mb-1.5 block text-sm font-medium text-white">Full Name *</label>
          <input id="full-name" name="Full Name" type="text" required class="lv-input" />
        </div>

        <div>
          <label for="business-name" class="mb-1.5 block text-sm font-medium text-white">Business Name</label>
          <input id="business-name" name="Business Name" type="text" class="lv-input" />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="email" class="mb-1.5 block text-sm font-medium text-white">Email Address *</label>
            <input id="email" name="Email Address" type="email" required class="lv-input" />
          </div>
          <div>
            <label for="phone" class="mb-1.5 block text-sm font-medium text-white">Phone / WhatsApp *</label>
            <input id="phone" name="Phone / WhatsApp" type="tel" required placeholder="+1 555 123 4567" class="lv-input" />
          </div>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="country" class="mb-1.5 block text-sm font-medium text-white">Country *</label>
            <select id="country" name="Country" required class="lv-input">
              <option value="" disabled selected>Select your country</option>
              {PRIORITY_COUNTRIES.map((c) => <option value={c}>{c}</option>)}
              <option disabled>──────────</option>
              {OTHER_COUNTRIES.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
          <div>
            <label for="industry" class="mb-1.5 block text-sm font-medium text-white">Industry *</label>
            <select id="industry" name="Industry" required class="lv-input">
              <option value="" disabled selected>Select your industry</option>
              {industries.map((i) => <option value={i}>{i}</option>)}
            </select>
          </div>
        </div>

        <div>
          <label for="need" class="mb-1.5 block text-sm font-medium text-white">What do you need? *</label>
          <select id="need" name="What do you need" required class="lv-input">
            <option value="" disabled selected>Select an option</option>
            {NEED_OPTIONS.map((n) => <option value={n}>{n}</option>)}
          </select>
        </div>

        <div>
          <label for="ideal-customer" class="mb-1.5 block text-sm font-medium text-white">
            Who is your ideal customer or counterparty?
          </label>
          <input id="ideal-customer" name="Ideal Customer" type="text" class="lv-input" />
        </div>

        <div>
          <label for="target-locations" class="mb-1.5 block text-sm font-medium text-white">Target locations</label>
          <input id="target-locations" name="Target Locations" type="text" placeholder="Countries / states / cities" class="lv-input" />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="volume" class="mb-1.5 block text-sm font-medium text-white">Approximate volume needed</label>
            <select id="volume" name="Approximate Volume" class="lv-input">
              <option value="" disabled selected>Select a range</option>
              {volumes.map((v) => <option value={v}>{v}</option>)}
            </select>
          </div>
          <div>
            <label for="budget" class="mb-1.5 block text-sm font-medium text-white">Budget range</label>
            <select id="budget" name="Budget Range" class="lv-input">
              <option value="" disabled selected>Select a range</option>
              {budgets.map((b) => <option value={b}>{b}</option>)}
            </select>
          </div>
        </div>

        <div>
          <label for="challenge" class="mb-1.5 block text-sm font-medium text-white">
            Your biggest challenge in reaching customers right now
          </label>
          <textarea id="challenge" name="Biggest Challenge" rows="4" class="lv-input"></textarea>
        </div>

        <button type="submit" class="btn-primary w-full">Submit — Get My Free Recommendation <ArrowRight size={18} /></button>

        <p class="text-xs text-white/50">
          By submitting, you agree to be contacted by LeadVault via email, phone, or WhatsApp. We
          never share your information with third parties.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { NEED_SLUG_TO_OPTION, CATALOG_CATEGORIES } from '../data/catalog';

  // Data Catalog "Request This Dataset" buttons link to /contact?need=<category-slug>
  // (CLAUDE.md). Pre-fill "What do you need?" + the "ideal customer" field from it.
  const params = new URLSearchParams(window.location.search);
  const slug = params.get('need');
  if (slug) {
    const needSelect = document.getElementById('need') as HTMLSelectElement | null;
    const idealCustomer = document.getElementById('ideal-customer') as HTMLInputElement | null;
    const category = CATALOG_CATEGORIES.find((c) => c.slug === slug);
    const needOption = NEED_SLUG_TO_OPTION[slug] ?? (category ? 'Fresh custom dataset' : undefined);

    if (needSelect && needOption) {
      needSelect.value = needOption;
    }
    if (idealCustomer && category && !idealCustomer.value) {
      idealCustomer.value = `Interested in: ${category.name}`;
    }
  }
</script>
