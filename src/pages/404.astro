---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight } from '@lucide/astro';
---

<BaseLayout
  title="Page Not Found | LeadVault"
  description="The page you're looking for doesn't exist."
  path="/404"
  noindex
>
  <section class="section flex flex-col items-center py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-2 text-3xl font-extrabold text-white sm:text-4xl">We Couldn't Find That Page.</h1>
    <p class="mt-4 max-w-xl text-white/70">
      The page you're looking for may have moved or no longer exists.
    </p>
    <div class="mt-8">
      <a href="/" class="btn-teal">Back to Home <ArrowRight size={18} /></a>
    </div>
  </section>
</BaseLayout>
