---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroWorldGraphic from '../components/HeroWorldGraphic.astro';
import PipelineGraphic from '../components/PipelineGraphic.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import StatsSection from '../components/StatsSection.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import Testimonial from '../components/Testimonial.astro';
import { ArrowRight, Check } from '@lucide/astro';

const industries = [
  'E-commerce & online retail',
  'Marketing & advertising agencies',
  'Cold email & outreach teams',
  'Importers, exporters & freight forwarders',
  'SaaS & software companies',
  'Recruitment agencies',
  'Real estate marketers',
  'Fintech & lending',
  'Investment & financial services',
  'Insurance brokers',
  'B2B sales teams',
  'Market research firms',
  'Call centers',
  'Event & trade show organizers',
  'Wholesalers & distributors',
];

const trustItems = [
  'Verified Before Delivery',
  'Fresh — As Recent As 3 Days',
  'Bounce-Free Guarantee',
  'Decision-Makers Only',
  'Worldwide Coverage',
];

const testimonials = [
  {
    quote:
      "I run an export business from Houston, and for years my biggest headache was finding genuine buyers back home and verified suppliers I could trust. Steve connected me with both. The contacts were real, the businesses were active, and deals actually closed. I've recommended him to everyone in my circle.",
    attribution: 'A.O., Exporter — Houston, USA',
  },
  {
    quote:
      "Finding verified buyers for international trade is nearly impossible on your own — most contacts online are dead ends or scams. LeadVault's data was different: fresh, verified, and exactly the type of businesses I asked for.",
    attribution: 'C.E., Freight Forwarder — Atlanta, USA',
  },
  {
    quote:
      "Every list I bought elsewhere was half dead — bounced emails, disconnected numbers. LeadVault's data connects. You can tell it was verified days before delivery, not years.",
    attribution: 'T.M., Digital Marketing Agency Owner — Lagos',
  },
  {
    quote:
      'We needed decision-maker contacts in a very specific niche. LeadVault built a custom dataset to our exact specification and delivered it clean, in days. The response rate spoke for itself.',
    attribution: 'R.A., B2B Sales Director — Dubai, UAE',
  },
];
---

<BaseLayout
  title="LeadVault — Fresh, Verified B2B Leads & Data | Sourced On Request, Delivered in Days"
  description="LeadVault delivers fresh, verified business leads and custom datasets to companies worldwide. Sourced on request, verified within days — not pulled from a stale database. Get your data today."
  path="/"
  includeOrgSchema
>
  <!-- Hero -->
  <section class="section grid items-center gap-12 lg:grid-cols-2">
    <div>
      <h1 class="text-4xl font-extrabold leading-tight text-white sm:text-5xl">
        Every Business Needs Leads. Every Lead Starts Here.
      </h1>
      <p class="mt-5 text-lg font-semibold text-[var(--color-teal)]">
        Fresh, verified leads — sourced on request, delivered in days.
      </p>
      <p class="mt-4 text-white/75">
        Most data companies sell you records collected months — even years — ago. LeadVault is
        different. When you order from us, we source and verify your data <strong class="text-white">fresh</strong>,
        to your exact specification, and deliver it within days. Real people. Working contacts. Ready to buy.
      </p>
      <p class="mt-4 text-white/75">
        From importers and freight forwarders to e-commerce brands and marketing agencies —
        businesses on four continents trust LeadVault to find the customers they can't find themselves.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/contact" class="btn-teal">Get Your Data <ArrowRight size={18} /></a>
        <a href="#how-it-works" class="btn-outline">See How It Works</a>
      </div>
      <p class="mt-6 text-sm italic text-white/50">
        Serving businesses across the USA, UK, Canada, Nigeria, and worldwide.
      </p>
    </div>
    <HeroWorldGraphic />
  </section>

  <!-- Plain-language bar -->
  <section class="border-y border-white/10 bg-[var(--color-navy-mid)]">
    <div class="section !py-12 text-center">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">First — What Is Lead Generation? (In Plain English)</h2>
      <p class="mx-auto mt-4 max-w-3xl text-white/80">
        <strong class="text-white">Lead generation simply means finding the people most likely to buy from you —
        and giving you their verified contact details so you can reach them directly.</strong>
      </p>
      <p class="mx-auto mt-3 max-w-3xl text-white/70">
        No jargon. No mystery. You tell us who your ideal customer is. We find them, confirm their
        details are real and current, and deliver them to you — so you spend your time selling, not searching.
      </p>
    </div>
  </section>

  <!-- Trust bar -->
  <section class="section !py-8">
    <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
      {trustItems.map((item) => (
        <li class="flex items-center gap-2 text-sm font-medium text-white/85">
          <Check size={16} class="text-[var(--color-teal)]" aria-hidden="true" />
          {item}
        </li>
      ))}
    </ul>
  </section>

  <!-- The Problem -->
  <section class="section">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">The Problem</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">The Data You're Buying Is Older Than You Think.</h2>
      <p class="mt-5 text-white/75">
        Here's the industry's open secret: the big data platforms — the ones where you log in,
        search a giant database, and download a list — collected many of those records months or
        years ago. People change jobs. Companies close. Emails die. Industry research consistently
        shows B2B contact data decays by roughly a quarter to a third <strong class="text-white">every year</strong>.
      </p>
      <p class="mt-4 text-white/75">
        So when your emails bounce, your calls hit dead numbers, and your "decision-maker" left the
        company in 2024 — that's not bad luck. That's the warehouse model doing what warehouses do:
        storing things that age.
      </p>
      <p class="mt-4 text-white/75">
        Meanwhile, the customers you actually need — the active buyer, the genuine supplier, the
        decision-maker with budget right now — are out there. Somebody just has to go find them.
        <strong class="text-white"> Freshly.</strong>
      </p>
    </div>
  </section>

  <!-- The Solution -->
  <section id="how-it-works" class="border-y border-white/10 bg-[var(--color-navy-mid)]">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">The Solution</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">We Don't Store Data. We Harvest It Fresh — For You.</h2>
        <p class="mt-5 text-white/75">
          LeadVault works on request. Your order triggers our pipeline:
        </p>
      </div>
      <div class="mt-12">
        <PipelineGraphic />
      </div>
      <p class="mx-auto mt-10 max-w-2xl text-center text-lg text-white/80">
        Think of the big platforms as a warehouse of tinned goods.
        <strong class="text-[var(--color-teal)]"> LeadVault is the farmer's market.</strong>
      </p>
      <div class="mt-8 text-center">
        <a href="/contact" class="btn-teal">Order Fresh Data <ArrowRight size={18} /></a>
      </div>
    </div>
  </section>

  <!-- Born From Real Trade -->
  <section class="section grid items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Our Origin</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">This Company Began With Real Deals — Not a Business Plan.</h2>
      <p class="mt-5 text-white/75">
        Before LeadVault had a name, our founder <strong class="text-white">Steve Ehimigbai</strong> spent
        years doing one difficult thing extremely well: connecting Nigerian import/export businesses —
        many run by Nigerians in the American diaspora — with <strong class="text-white">verified buyers
        and sellers</strong> across borders.
      </p>
      <p class="mt-4 text-white/75">
        International traders face a brutal problem: most "buyer lists" online are dead ends or
        outright scams. Steve solved it the hard way — sourcing, checking, and matching real
        counterparties, deal after deal, year after year. The reviews and referrals piled up. The
        method became a system. The system became LeadVault.
      </p>
      <p class="mt-4 text-white/75">
        Today, that same fresh-sourcing discipline serves every industry that runs on data — worldwide.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/about" class="btn-teal">Read Our Story <ArrowRight size={18} /></a>
        <a href="/trade" class="btn-outline">For Importers & Freight Forwarders</a>
      </div>
    </div>
    <ImagePlaceholder caption="IMAGE: container port at dusk with data-line overlay" ratio="aspect-[4/3]" />
  </section>

  <!-- Data In Numbers -->
  <section class="border-y border-white/10 bg-[var(--color-navy-mid)]">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">By The Numbers</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">The Numbers Behind the Vault</h2>
      </div>
      <div class="mt-12">
        <StatsSection />
      </div>
    </div>
  </section>

  <!-- Who Buys From Us -->
  <section class="section">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Who We Serve</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Built for Businesses That Run on Data.</h2>
      <p class="mt-5 text-white/75">
        Some businesses need data occasionally. Others live on it daily. We serve both — but we're
        built for the second kind:
      </p>
    </div>
    <div class="mx-auto mt-10 flex max-w-4xl flex-wrap justify-center gap-3">
      {industries.map((industry) => (
        <span class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/80">
          {industry}
        </span>
      ))}
    </div>
    <p class="mx-auto mt-6 max-w-2xl text-center text-white/60">
      …and every other business that needs to reach the right people, reliably.
    </p>
    <div class="mt-8 text-center">
      <a href="/industries" class="btn-teal">Explore Industries <ArrowRight size={18} /></a>
    </div>
  </section>

  <!-- Why Not Just Use The Big Platforms -->
  <section class="border-y border-white/10 bg-[var(--color-navy-mid)]">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">The Comparison</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">"Can't I Just Log Into a Database Platform?"</h2>
        <p class="mt-5 text-white/75">You can. Millions do. Here's the difference:</p>
      </div>
      <div class="mt-10">
        <ComparisonTable
          caption="Database platforms versus LeadVault"
          headers={['', 'Database Platforms (Apollo, ZoomInfo, RocketReach & similar)', 'LeadVault']}
          rows={[
            ['How it works', 'Log in, search a stored database, download', 'We source your data fresh, on request'],
            ['Data age', 'Verified months or years ago', 'Sourced & verified within days — as fresh as 3 days'],
            ['Verification', 'Periodic bulk checks; bounces included', 'Every batch re-verified before delivery; bounces removed'],
            ['Guidance', "Software only — you're on your own", 'A strategist reviews your need and recommends the right data'],
            ['Emerging markets', 'Thin, outdated coverage', 'Deep, current coverage — including African markets others can\'t reach'],
          ]}
        />
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-lg text-white/80">
        The platforms sell access to a warehouse. <strong class="text-[var(--color-teal)]">We deliver the fresh harvest.</strong>
      </p>
      <div class="mt-8 text-center">
        <a href="/why-leadvault" class="btn-teal">See the Full Comparison <ArrowRight size={18} /></a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Testimonials</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Trusted by Traders, Agencies, and Growth Teams Worldwide</h2>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {testimonials.map((t) => <Testimonial quote={t.quote} attribution={t.attribution} />)}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="border-t border-white/10 bg-[var(--color-navy-dark)]">
    <div class="section text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Your Next Customer Exists. We'll Find Them This Week.</h2>
      <p class="mx-auto mt-5 max-w-2xl text-white/75">
        Tell us who you're looking for. A LeadVault strategist will come back within 24 hours with a
        free recommendation — the right data, the right volume, the right price. No obligation.
      </p>
      <div class="mt-8">
        <a href="/contact" class="btn-teal">Get My Free Recommendation <ArrowRight size={18} /></a>
      </div>
    </div>
  </section>
</BaseLayout>
