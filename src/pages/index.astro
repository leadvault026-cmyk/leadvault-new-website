---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroWorldGraphic from '../components/HeroWorldGraphic.astro';
import PipelineGraphic from '../components/PipelineGraphic.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import SampleDataSection from '../components/SampleDataSection.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import { PRIMARY_TAGLINE } from '../data/site';
import { ArrowRight, Check, Megaphone, Users, Code, Compass } from '@lucide/astro';

// Positioning-pass round (see ASSUMPTIONS.md) — lets the three priority ICPs
// self-identify near the top of the page, before Problem/Solution. No card
// links to a dedicated landing page (none exist yet — that's a later phase);
// all three point at the same real next step everyone else on the page uses.
const icpGroups = [
  {
    icon: Megaphone,
    title: 'Marketing & Lead-Generation Agencies',
    body: "Give us a client's ICP — industry, geography, company size, role — and we research the matching prospect list, ready for outreach.",
  },
  {
    icon: Users,
    title: 'Recruitment Agencies',
    body: "Tell us the roles you're hiring for or the employers you're targeting, and we research the companies and decision-makers that match.",
  },
  {
    icon: Code,
    title: 'B2B SaaS & Sales Teams',
    body: 'Define your ideal customer by industry, company size, role, and geography — we research and deliver the matching prospect data.',
  },
  {
    icon: Compass,
    title: 'Other B2B Research Needs',
    body: "Doesn't fit a category above? Tell us what you need — if it can be defined, we can research it.",
  },
];

const industries = [
  'E-commerce & online retail',
  'Marketing & advertising agencies',
  'Cold email & outreach teams',
  'Importers, exporters & freight forwarders',
  'SaaS & software companies',
  'Recruitment agencies',
  'Real estate marketers',
  'Fintech & lending',
  'Investment & financial services',
  'Insurance brokers',
  'B2B sales teams',
  'Market research firms',
  'Call centers',
  'Event & trade show organizers',
  'Wholesalers & distributors',
];

const trustItems = [
  'Verified Before Delivery',
  'Fresh — As Recent As 3 Days',
  'Replacement Guarantee',
  'Decision-Makers Only',
  'Worldwide Coverage',
];

// Replaces the removed testimonials section (see ASSUMPTIONS.md — no
// consent trail could be confirmed for the previous quotes, so rather than
// publish unverified social proof this explains the real, factual process
// instead. Every step here matches what the site already states elsewhere
// (verification pipeline on /tools, the 5%/14-day guarantee on /pricing).
const processSteps = [
  'You tell us exactly who you need to reach — industry, role, location, company size, or any custom criteria.',
  'We source the records fresh for your order — not pulled from a stored, aging database.',
  'Every record passes our verification pipeline: MX checks, bounce and hygiene screening, duplicate removal.',
  'You receive a clean CSV, plus a short summary of what was checked and how.',
  'If more than 5% of a delivery proves invalid within 14 days, we replace it — see our Refund & Replacement Policy.',
];
---

<BaseLayout
  title="B2B Prospect Research & Custom Data Sourcing | LeadVault"
  description="Tell LeadVault who you need to reach. We research the companies and decision-makers that match, verify them, and deliver a usable dataset — sourced fresh, not pulled from a stale database."
  path="/"
  includeOrgSchema
>
  <!-- Hero -->
  <section class="section grid gap-12 lg:grid-cols-2 lg:items-center">
    <div>
      <h1 class="text-4xl font-extrabold leading-tight text-white sm:text-5xl">
        {PRIMARY_TAGLINE}
      </h1>
      <p class="mt-5 text-lg font-semibold text-[var(--color-lime)]">
        B2B prospect research and custom data sourcing — verified, and delivered in a usable format.
      </p>
      <p class="mt-4 text-white/75">
        Give us your target industry, company size, job roles, location, or any other criteria. We
        research the companies and decision-makers that match, verify what we find, and deliver a
        clean dataset — not pulled from storage, <strong class="text-white">sourced fresh for your
        request.</strong>
      </p>
      <p class="mt-4 text-white/75">
        From marketing agencies and SaaS sales teams to recruiters and importers — businesses across
        the USA, UK, Canada, Nigeria, and beyond trust LeadVault to research the prospects they can't
        find themselves.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/data-catalog" data-cta="hero-sample-data" class="btn-primary">Request Sample Data <ArrowRight size={18} /></a>
        <a href="/contact" data-cta="hero-custom-dataset" class="btn-outline">Request a Custom Dataset</a>
      </div>
      <p class="mt-6 text-sm italic text-white/50">
        Serving businesses across the USA, UK, Canada, Nigeria, and worldwide.
      </p>
    </div>
    <div>
      <HeroWorldGraphic />
      <p class="mt-4 text-center text-sm font-semibold text-white">Prospect research across markets worldwide.</p>
      <p class="mt-1 text-center text-xs text-white/50">From North America and Europe to Africa, the Middle East, Asia, and beyond.</p>
    </div>
  </section>

  <!-- Plain-language bar -->
  <section class="border-y border-white/10 bg-[var(--color-bg-mid)]">
    <div class="section !py-12 text-center">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">First — What Does LeadVault Actually Do?</h2>
      <p class="mx-auto mt-4 max-w-3xl text-white/80">
        <strong class="text-white">You tell us who you need to reach. We research the companies and
        decision-makers that match your criteria and deliver the data in a usable format.</strong>
      </p>
      <p class="mx-auto mt-3 max-w-3xl text-white/70">
        Tell us your target industry, location, company size, job roles, or other requirements. We
        research the right prospects, verify the available contact details, and build a dataset
        around your actual prospecting needs — so your team spends less time searching and more time
        selling.
      </p>
      <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 border-t border-white/10 pt-8">
        {trustItems.map((item) => (
          <li class="flex items-center gap-2 text-sm font-medium text-white/85">
            <Check size={16} class="text-[var(--color-lime)]" aria-hidden="true" />
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Built For The Way You Prospect -->
  <section class="section">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Who We Research For</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Built for the Way You Prospect.</h2>
      <p class="mt-5 text-white/75">
        Whatever you're selling, recruiting for, or building — tell us the prospects you need, and we
        research them to your specification.
      </p>
    </div>
    <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {icpGroups.map((g) => (
        <div class="card flex flex-col gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
            <g.icon size={22} stroke-width={1.75} aria-hidden="true" />
          </div>
          <h3 class="text-base font-semibold text-white">{g.title}</h3>
          <p class="text-sm leading-relaxed text-white/70">{g.body}</p>
        </div>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="/contact" data-cta="icp-section-custom-dataset" class="btn-primary">Tell Us What You Need <ArrowRight size={18} /></a>
    </div>
  </section>

  <!-- The Problem -->
  <section class="border-y border-white/10 bg-[var(--color-bg-mid)]">
    <div class="section">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">The Problem</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">The Data You're Buying Is Older Than You Think.</h2>
      <p class="mt-5 text-white/75">
        Here's the industry's open secret: the big data platforms — the ones where you log in,
        search a giant database, and download a list — collected many of those records months or
        years ago. People change jobs. Companies close. Emails die. Independent research puts B2B
        contact data decay at roughly <strong class="text-white">22–23% every year</strong> —
        <a href="https://www.cleanlist.ai/blog/2026-01-22-b2b-data-decay-statistics" target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--color-lime)]">see the research</a>.
      </p>
      <p class="mt-4 text-white/75">
        So when your emails bounce, your calls hit dead numbers, and your "decision-maker" left the
        company in 2024 — that's not bad luck. That's the warehouse model doing what warehouses do:
        storing things that age.
      </p>
      <p class="mt-4 text-white/75">
        Meanwhile, the customers you actually need — the active buyer, the genuine supplier, the
        decision-maker with budget right now — are out there. Somebody just has to go find them.
        <strong class="text-white"> Freshly.</strong>
      </p>
    </div>
    </div>
  </section>

  <!-- The Solution -->
  <section id="how-it-works" class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">The Solution</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">We Don't Store Data. We Harvest It Fresh — For You.</h2>
        <p class="mt-5 text-white/75">
          LeadVault works on request. Your order triggers our pipeline:
        </p>
      </div>
      <div class="mt-12">
        <PipelineGraphic />
      </div>
      <p class="mx-auto mt-10 max-w-2xl text-center text-lg text-white/80">
        Think of the big platforms as a warehouse of tinned goods.
        <strong class="text-[var(--color-lime)]"> LeadVault is the farmer's market.</strong>
      </p>
      <div class="mt-8 text-center">
        <a href="/contact" class="btn-primary">Order Fresh Data <ArrowRight size={18} /></a>
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-white/70">
        <a href="/services#managed-email-campaigns" class="font-semibold text-[var(--color-lime)] hover:underline">Managed Email Campaigns</a> —
        we MX-sort, warm, send, and report your campaigns with our own deliverability tools — so
        your emails land, not vanish.
      </p>
  </section>

  <!-- Why Not Just Use The Big Platforms -->
  <section class="border-y border-white/10 bg-[var(--color-bg-mid)]">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">The Comparison</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">"Can't I Just Log Into a Database Platform?"</h2>
        <p class="mt-5 text-white/75">You can. Millions do. Here's the difference:</p>
      </div>
      <div class="mt-10">
        <ComparisonTable
          caption="Database platforms versus LeadVault"
          headers={['', 'Database Platforms (Apollo, ZoomInfo, RocketReach & similar)', 'LeadVault']}
          rows={[
            ['How it works', 'Log in, search a stored database, download', 'We source your data fresh, on request'],
            ['Data age', 'Verified months or years ago', 'Sourced & verified within days — as fresh as 3 days'],
            ['Verification', 'Periodic bulk checks; bounces included', 'Every batch re-verified before delivery; bounces removed'],
            ['Guidance', "Software only — you're on your own", 'A strategist reviews your need and recommends the right data'],
            ['Emerging markets', 'Thin, outdated coverage', 'Deep, current coverage — including African markets others can\'t reach'],
          ]}
        />
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-lg text-white/80">
        The platforms sell access to a warehouse. <strong class="text-[var(--color-lime)]">We deliver the fresh harvest.</strong>
      </p>
      <div class="mt-8 text-center">
        <a href="/why-leadvault" class="btn-primary">See the Full Comparison <ArrowRight size={18} /></a>
      </div>
    </div>
  </section>

  <!-- Sample Data -->
  <section id="sample-data" class="section scroll-mt-24">
    <SampleDataSection />
  </section>

  <!-- Born From Real Trade -->
  <section class="border-y border-white/10 bg-[var(--color-bg-mid)]">
    <div class="section grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Our Origin</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">This Company Began With Real Deals — Not a Business Plan.</h2>
        <p class="mt-5 text-white/75">
          Before LeadVault had a name, our founder <strong class="text-white">Steven Ehimigbai</strong> spent
          years doing one difficult thing extremely well: connecting Nigerian import/export businesses —
          many run by Nigerians in the American diaspora — with <strong class="text-white">verified buyers
          and sellers</strong> across borders.
        </p>
        <p class="mt-4 text-white/75">
          International traders face a brutal problem: most "buyer lists" online are dead ends or
          outright scams. Steven solved it the hard way — sourcing, checking, and matching real
          counterparties, deal after deal, year after year. The reviews and referrals piled up. The
          method became a system. The system became LeadVault.
        </p>
        <p class="mt-4 text-white/75">
          Today, that same fresh-sourcing discipline serves every industry that runs on data — worldwide.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/about" class="btn-primary">Read Our Story <ArrowRight size={18} /></a>
          <a href="/trade" class="btn-outline">For Importers & Freight Forwarders</a>
        </div>
      </div>
      <ImagePlaceholder
        caption="IMAGE: container port at dusk with data-line overlay"
        alt="Container port at dusk, cranes loading cargo containers"
        ratio="aspect-[4/3]"
        src="/photos/container-port-dusk.jpg"
        width={1400}
        height={933}
      />
    </div>
  </section>

  <!-- Who Buys From Us -->
  <section class="section">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Who We Serve</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Built for Businesses That Run on Data.</h2>
      <p class="mt-5 text-white/75">
        Some businesses need data occasionally. Others live on it daily. We serve both — but we're
        built for the second kind:
      </p>
    </div>
    <div class="mx-auto mt-10 flex max-w-4xl flex-wrap justify-center gap-3">
      {industries.map((industry) => (
        <span class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/80">
          {industry}
        </span>
      ))}
    </div>
    <p class="mx-auto mt-6 max-w-2xl text-center text-white/60">
      …and every other business that needs to reach the right people, reliably.
    </p>
    <div class="mt-8 text-center">
      <a href="/industries" class="btn-primary">Explore Industries <ArrowRight size={18} /></a>
    </div>
  </section>

  <!-- How It Works -->
  <section class="border-y border-white/10 bg-[var(--color-bg-mid)]">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">What Working With LeadVault Looks Like</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">No Guesswork. Just A Clear Process.</h2>
      </div>
      <ol class="mx-auto mt-10 max-w-2xl space-y-5">
        {processSteps.map((item, i) => (
          <li class="flex gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--color-lime)] text-sm font-bold text-[var(--color-lime-dark)]">
              {i + 1}
            </span>
            <p class="text-white/80">{item}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section-alt">
    <div class="section text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Your Next Customer Exists. We'll Find Them This Week.</h2>
      <p class="mx-auto mt-5 max-w-2xl text-white/75">
        Tell us who you're looking for. A LeadVault strategist will review the specification and
        respond within 24 hours with the right data, the right volume, the right price. No obligation.
      </p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a href="/data-catalog" data-cta="final-sample-data" class="btn-primary">Request Sample Data <ArrowRight size={18} /></a>
        <a href="/contact" data-cta="final-custom-dataset" class="btn-outline">Request a Custom Dataset</a>
      </div>
    </div>
  </section>
</BaseLayout>
