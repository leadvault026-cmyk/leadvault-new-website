---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroWorldGraphic from '../components/HeroWorldGraphic.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import SampleDataSection from '../components/SampleDataSection.astro';
import {
  PRIMARY_TAGLINE,
  CTA_PRIMARY,
  CTA_SAMPLE_DATA,
  CTA_SAMPLE_HREF,
  CTA_HIGH_INTENT,
} from '../data/site';
import {
  ArrowRight,
  Check,
  Search,
  ClipboardCheck,
  Layers,
  ShieldCheck,
  Send,
  MapPin,
  UserCheck,
  Lightbulb,
  Ship,
  Globe,
  Database,
  Sparkles,
  Megaphone,
  Stethoscope,
  Code,
  Handshake,
  Compass,
  Filter,
  MessageCircleQuestion,
} from '@lucide/astro';

// Master commercial copy package (2026-10-01) — content-depth implementation
// pass. Builds on the repositioning phase's structure/positioning (unchanged)
// with the master's fuller explanations, example briefs, and field-level
// detail. See ASSUMPTIONS.md for section-by-section notes.

// "Your Target Market Is More Specific Than a Database Filter" — master's
// opening expansion of the problem statement.
const specificExamples = [
  'Healthcare providers that accept a particular type of case',
  'Distributors handling a specific product',
  'Manufacturers using a particular process',
  'Businesses serving a defined customer group',
  'Companies showing evidence of a certain capability',
  'Decision-makers whose responsibilities cannot be identified from a job title alone',
];

// "A Lead Tells You Who Exists. Intelligence Tells You Why They Matter." —
// the chain + the questions evidence is meant to answer.
const intelligenceChain = ['Company', 'Qualification', 'Evidence', 'Relevant Person', 'Role', 'Contact Data', 'Research Context'];
const intelligenceQuestions = [
  'Does this company actually match our requirement?',
  'What evidence supports the match?',
  'Who inside the company is most relevant?',
  'What information do we have for reaching them?',
  'What context should our team know before taking action?',
];

const waysToWork = [
  {
    icon: Database,
    title: 'Qualified Prospect Data',
    body: 'When you already know exactly who you want. Give us the geography, industries, company characteristics, job functions, seniority, exclusions and required fields. We research matching companies and contacts and deliver a clean prospect dataset.',
    cta: { label: 'Explore Qualified Prospect Data', href: '/qualified-prospect-data' },
  },
  {
    icon: Sparkles,
    title: 'Prospect Intelligence',
    body: 'When qualification requires investigation. If the requirement cannot be solved reliably with ordinary filters, we research the condition itself — including relevant public evidence, capabilities, services, market activity and other signals.',
    cta: { label: 'Explore Prospect Intelligence', href: '/prospect-intelligence' },
  },
  {
    icon: Megaphone,
    title: 'Intelligence-Led Outreach',
    body: 'When you want the research carried into execution. LeadVault can take qualified prospect intelligence further by helping structure and manage B2B email outreach around the audience we researched.',
    cta: { label: 'Explore Intelligence-Led Outreach', href: '/managed-outreach' },
  },
];

// "How LeadVault Research Works" — master's 5-stage process (Discover,
// Qualify, Enrich, Verify, Deliver). Supersedes the repositioning phase's
// Discover/Qualify/Enrich/Prioritize/Act wording with the master's version.
const processSteps = [
  { icon: Search, label: 'Discover', body: 'Define the search universe and identify potential companies from relevant public and business sources.' },
  { icon: ClipboardCheck, label: 'Qualify', body: 'Check candidates against the agreed criteria and exclude companies that do not fit.' },
  { icon: Layers, label: 'Enrich', body: 'Research company details and, where required, identify relevant people or roles.' },
  { icon: ShieldCheck, label: 'Verify', body: 'Check and normalize available contact information and key fields.' },
  { icon: Send, label: 'Deliver', body: 'Provide structured data in a practical format, with project-specific fields and supporting evidence where required.' },
];

// "What a LeadVault Research Brief Can Look Like" — 4 example briefs,
// clearly labeled as examples, not named customer case studies.
const exampleBriefs = [
  {
    icon: Stethoscope,
    label: 'Healthcare',
    body: 'Identify medical providers in selected U.S. states that publicly indicate they accept Letters of Protection, medical liens or attorney-referred injury cases. Qualify the practice, identify a relevant business contact where available and provide the public source supporting qualification.',
  },
  {
    icon: Code,
    label: 'SaaS',
    body: 'Identify U.S. companies within an agreed size range that match a defined business model and operating profile. Research relevant commercial or technology stakeholders and provide the fields required for outbound prospecting.',
  },
  {
    icon: Ship,
    label: 'Trade & Distribution',
    body: 'Identify importers, distributors, wholesalers or commercial buyers associated with a specified product and market. Distinguish relevant counterparties from unrelated companies and research available commercial contacts.',
  },
  {
    icon: Megaphone,
    label: 'Agencies',
    body: "Build a campaign-ready audience for a client's exact ICP, including company criteria, relevant decision-makers, available business contact information and campaign-specific enrichment fields.",
  },
];

const useCases = [
  { icon: Search, title: 'Specialized Prospect Discovery', body: 'Find businesses matching criteria that do not exist as a simple database filter.' },
  { icon: MapPin, title: 'Market & ICP Mapping', body: 'Map a target market and identify companies that match a defined ideal-customer profile.' },
  { icon: UserCheck, title: 'Decision-Maker Research', body: 'Identify the people most relevant to a purchasing, partnership or commercial decision.' },
  { icon: Lightbulb, title: 'Opportunity Intelligence', body: 'Research public evidence indicating that a company may fit a particular commercial opportunity.' },
  { icon: Handshake, title: 'Trade & Counterparty Intelligence', body: 'Research buyers, suppliers, importers, exporters, distributors and other commercial counterparties.' },
  { icon: Globe, title: 'Geographic Prospect Mapping', body: 'Build qualified prospect coverage around defined cities, states, countries or regions.' },
];

// A single fictional, illustrative intelligence record — ties back to the
// Problem section's own healthcare example and the Healthcare example brief
// above, so the page tells one coherent story from problem to deliverable.
// Never real customer data — masked/fictional per this site's established
// sample-data convention (see Data Catalog).
const exampleRecord = [
  { field: 'Company Name', value: 'Meridian Behavioral Health Group' },
  { field: 'Website', value: 'meridianbhg-example.com' },
  { field: 'Contact Name', value: 'Daniel Whitfield' },
  { field: 'Contact Title', value: 'Director of Patient Intake' },
  { field: 'Email Address', value: 'd.****@mer*****.com' },
  { field: 'Phone Number', value: '+1 (XXX) XXX-4471' },
  { field: 'Address', value: '1200 Harborview Drive, Suite 300' },
  { field: 'City', value: 'Charlotte' },
  { field: 'State/Region', value: 'North Carolina' },
  { field: 'Provider/Company Type', value: 'Multi-location outpatient clinic' },
  { field: 'Qualification Basis', value: 'Publicly lists personal-injury case coordination as a service line' },
  { field: 'Evidence', value: 'Public service-line page (illustrative)' },
  { field: 'Priority/Fit', value: 'High — matches all 3 target criteria' },
  { field: 'Recommended Approach', value: 'Lead with the referral-coordination angle, not a general sales pitch' },
];

// "Research Designed for Action" — the field list a project's schema is
// drawn from, agreed per project.
const deliverableFields = [
  'Company name', 'Website', 'Contact name', 'Contact title', 'Business email',
  'Phone number', 'Address', 'City', 'State/region', 'Industry/provider type',
  'Qualification basis', 'Evidence/source URL', 'Custom project fields',
];

// V2 copy (2026-10-01) — "What Can Define a Target?" input-criteria list,
// distinct from deliverableFields below (which is the output schema).
const targetDefinitionFactors = [
  'Industry, sub-industry, specialty or business type',
  'Country, state, city, region or multi-market geography',
  'Company size, operating footprint or observable business characteristics',
  'Products, services, capabilities or commercial activities',
  'Customer type or business model',
  'Public evidence that a company provides, accepts, distributes, manufactures, carries or specializes in something',
  'Relevant department, function, title, seniority or stakeholder role',
  'Trade role such as importer, exporter, distributor, wholesaler, supplier or buyer',
  'Project-specific fields required by your sales process or CRM',
  'Exclusions that prevent irrelevant companies from entering the final dataset',
];

// V2 copy — full 7-service router, text-based (distinct presentation from
// the 3-card "Three Ways to Work With LeadVault" above it).
const startingPoints = [
  { label: 'MARKET & ICP RESEARCH', body: 'the market itself is still unclear.', href: '/market-icp-research' },
  { label: 'QUALIFIED PROSPECT DATA', body: 'the ICP is already clear.', href: '/qualified-prospect-data' },
  { label: 'PROSPECT INTELLIGENCE', body: 'fit cannot be established reliably through ordinary filters.', href: '/prospect-intelligence' },
  { label: 'DECISION-MAKER INTELLIGENCE', body: 'you know the target companies but need to understand who inside them is relevant.', href: '/decision-maker-intelligence' },
  { label: 'TRADE & COUNTERPARTY INTELLIGENCE', body: 'the commercial question concerns buyers, suppliers, importers, exporters, distributors or other counterparties.', href: '/trade' },
  { label: 'INTELLIGENCE-LED OUTREACH', body: 'you want the researched audience carried into managed B2B email outreach.', href: '/managed-outreach' },
  { label: 'DATA CLEANING & ENRICHMENT', body: 'you already own the records and need them cleaned, standardized, verified or enriched.', href: '/services#data-cleaning' },
];

const qualityPrinciples = [
  'Project-specific research — not a prebuilt list treated as the finished answer',
  'Multi-source discovery where appropriate',
  'Evidence-backed qualification',
  'Relevant decision-maker research',
  'Contact verification where available',
  'Deduplication and normalization',
  'Human review for ambiguous cases',
  'Clear delivery structure, built around the decision you need to make',
];
---

<BaseLayout
  title="LeadVault - B2B Prospect Intelligence & Prospect Research"
  description="LeadVault researches target markets, qualifies companies, identifies decision-makers and delivers verified B2B prospect intelligence built around your exact requirements."
  path="/"
  includeOrgSchema
>
  <!-- Hero -->
  <section class="section grid gap-12 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="eyebrow">B2B Prospect Intelligence</p>
      <h1 class="mt-2 text-4xl font-extrabold leading-tight text-white sm:text-5xl">
        {PRIMARY_TAGLINE}
      </h1>
      <p class="mt-5 text-white/75">
        LeadVault researches the companies that match your opportunity, determines why they
        qualify, identifies the people who matter inside those organizations, and delivers
        structured prospect intelligence your team can use for sales, outreach, market development
        and business research.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/contact" data-cta="hero-start-project" class="btn-primary">{CTA_PRIMARY} <ArrowRight size={18} /></a>
        <a href={CTA_SAMPLE_HREF} data-cta="hero-get-sample" class="btn-outline">{CTA_SAMPLE_DATA}</a>
      </div>
      <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-white/10 pt-6">
        {['Fresh Research', 'Evidence-Backed Qualification', 'Decision-Maker Research', 'Verified Contact Data', 'Worldwide Coverage'].map((item) => (
          <li class="flex items-center gap-1.5 text-sm font-medium text-white/80">
            <Check size={15} class="text-[var(--color-lime)]" aria-hidden="true" />
            {item}
          </li>
        ))}
      </ul>
    </div>
    <div>
      <HeroWorldGraphic />
      <p class="mt-4 text-center text-sm font-semibold text-white">Prospect intelligence across markets worldwide.</p>
      <p class="mt-1 text-center text-xs text-white/50">From North America and Europe to Africa, the Middle East, Asia, and beyond.</p>
    </div>
  </section>

  <!-- Your Target Market Is More Specific Than a Database Filter -->
  <section class="section-alt">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">The Problem</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Your Target Market Is More Specific Than a Database Filter.</h2>
        <p class="mt-5 text-white/75">
          Finding companies is easy when the requirement is simply an industry, location or job
          title. Real prospecting is often harder. You may need:
        </p>
      </div>
      <ul class="mx-auto mt-8 grid max-w-3xl gap-3 sm:grid-cols-2">
        {specificExamples.map((q) => (
          <li class="card text-sm leading-relaxed text-white/80">{q}</li>
        ))}
      </ul>
      <div class="mx-auto mt-8 max-w-2xl space-y-4 text-center text-white/75">
        <p>
          LeadVault works from your actual business requirement. We translate that requirement into
          research criteria, investigate potential companies, qualify the ones that fit, identify
          relevant contacts, verify available business contact information and structure the
          findings for action.
        </p>
        <p>You do not have to reduce a complex opportunity to whatever filters happen to exist inside a database.</p>
        <p class="text-lg font-semibold text-white">You tell us what makes a prospect valuable. We research for that.</p>
      </div>
    </div>
  </section>

  <!-- A Lead Tells You Who Exists. Intelligence Tells You Why They Matter. -->
  <section class="section">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">The Distinction</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">A Lead Tells You Who Exists. Intelligence Tells You Why They Matter.</h2>
      <p class="mt-5 text-white/75">
        A conventional prospect record might contain Company, Contact, Job Title, Email and Phone.
        Those fields are useful, and sometimes they are all you need. When the targeting requirement
        is more complex, LeadVault can go further:
      </p>
    </div>
    <div class="mx-auto mt-8 flex max-w-4xl flex-wrap items-center justify-center gap-2">
      {intelligenceChain.map((step, i) => (
        <>
          <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-sm font-medium text-white/85">{step}</span>
          {i < intelligenceChain.length - 1 && <ArrowRight size={14} class="text-white/30" aria-hidden="true" />}
        </>
      ))}
    </div>
    <div class="mx-auto mt-10 max-w-3xl">
      <p class="text-center text-sm font-medium text-white">That additional layer helps answer the questions that matter before your team spends time on outreach:</p>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {intelligenceQuestions.map((q) => (
          <li class="flex items-start gap-2 text-sm text-white/80">
            <Check size={15} class="mt-0.5 shrink-0 text-[var(--color-lime)]" aria-hidden="true" />
            {q}
          </li>
        ))}
      </ul>
      <p class="mt-6 text-center text-white/75">That is the difference between receiving records and receiving prospect intelligence.</p>
    </div>
  </section>

  <!-- Three Ways to Work With LeadVault -->
  <section class="section-alt">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Three Ways to Work With LeadVault</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Choose the Level of Research Your Project Needs.</h2>
      </div>
      <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-3">
        {waysToWork.map((w) => (
          <div class="card flex flex-col gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
              <w.icon size={22} stroke-width={1.75} aria-hidden="true" />
            </div>
            <h3 class="text-lg font-bold text-white">{w.title}</h3>
            <p class="flex-1 text-sm leading-relaxed text-white/70">{w.body}</p>
            <a href={w.cta.href} class="text-sm font-semibold text-[var(--color-lime)] hover:underline">{w.cta.label} →</a>
          </div>
        ))}
      </div>

      <div class="card mx-auto mt-10 max-w-3xl">
        <h3 class="flex items-center gap-2 text-base font-bold text-white"><Compass size={18} class="text-[var(--color-lime)]" /> Choose the Starting Point That Matches Your Problem</h3>
        <ul class="mt-4 space-y-3">
          {startingPoints.map((s) => (
            <li class="flex flex-wrap items-baseline gap-x-2 text-sm text-white/75">
              <a href={s.href} class="font-semibold text-[var(--color-lime)] hover:underline">{s.label}</a>
              <span>— Use this when {s.body}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- How LeadVault Research Works -->
  <section class="section">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">How It Works</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">How LeadVault Research Works.</h2>
    </div>
    <div class="mt-12 grid grid-cols-1 items-stretch gap-4 sm:grid-cols-2 lg:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr_auto_1fr]">
      {processSteps.map((step, i) => (
        <>
          <div class="card flex flex-col items-center gap-3 text-center">
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
              <step.icon size={24} stroke-width={1.75} aria-hidden="true" />
            </div>
            <div class="eyebrow">{i + 1}. {step.label}</div>
            <p class="text-sm text-white/70">{step.body}</p>
          </div>
          {i < processSteps.length - 1 && (
            <div class="hidden items-center justify-center lg:flex" aria-hidden="true">
              <ArrowRight size={18} class="text-white/30" />
            </div>
          )}
        </>
      ))}
    </div>
  </section>

  <!-- What Can Define a Target? -->
  <section class="section-alt">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Scope</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">What Can Define a Target?</h2>
        <p class="mt-5 text-white/75">
          A target can be defined by more than industry and location. Depending on the assignment,
          LeadVault can research combinations of:
        </p>
      </div>
      <ul class="mx-auto mt-8 grid max-w-4xl gap-3 sm:grid-cols-2">
        {targetDefinitionFactors.map((f) => (
          <li class="flex items-start gap-2 text-sm text-white/80">
            <Check size={15} class="mt-0.5 shrink-0 text-[var(--color-lime)]" aria-hidden="true" />
            {f}
          </li>
        ))}
      </ul>
      <p class="mx-auto mt-6 max-w-2xl text-center text-white/75">
        The important question is not whether a field appears in a standard database. It is whether
        the criterion can be researched responsibly and consistently enough to support the project.
      </p>
    </div>
  </section>

  <!-- What a LeadVault Research Brief Can Look Like -->
  <section class="section">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Illustrative Examples</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">What a LeadVault Research Brief Can Look Like.</h2>
      <p class="mt-4 text-sm text-white/50">The following are illustrative examples of project types, not named customer case studies.</p>
    </div>
    <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-2">
      {exampleBriefs.map((b) => (
        <div class="card flex flex-col gap-3">
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
              <b.icon size={22} stroke-width={1.75} aria-hidden="true" />
            </div>
            <h3 class="text-base font-bold uppercase tracking-wide text-white">{b.label}</h3>
          </div>
          <p class="text-sm leading-relaxed text-white/75">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Real-World Research Use Cases -->
  <section class="section-alt">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">When Database Filters Are Not Enough</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Real-World Research Use Cases.</h2>
      </div>
      <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {useCases.map((u) => (
          <div class="card flex flex-col gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
              <u.icon size={22} stroke-width={1.75} aria-hidden="true" />
            </div>
            <h3 class="text-base font-semibold text-white">{u.title}</h3>
            <p class="text-sm leading-relaxed text-white/70">{u.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Example Intelligence Output -->
  <section class="section">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">See the Difference in the Deliverable</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">What an Intelligence Record Actually Looks Like.</h2>
      <p class="mt-4 text-white/75">
        Continuing the Healthcare example above — here is the kind of record a Prospect Intelligence
        project would deliver for one qualifying business.
      </p>
    </div>
    <div class="card mx-auto mt-10 max-w-3xl">
      <p class="mb-4 text-xs font-medium text-white/50">Illustrative example record — not real customer data.</p>
      <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2">
        {exampleRecord.map((r) => (
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-white/50">{r.field}</dt>
            <dd class="mt-0.5 text-sm text-white/85">{r.value}</dd>
          </div>
        ))}
      </dl>
    </div>
    <p class="mx-auto mt-6 max-w-2xl text-center text-sm text-white/60">
      The exact fields depend on the assignment. LeadVault structures the deliverable around the
      decision the customer needs to make — not around a rigid database export.
    </p>
    <div class="card mx-auto mt-10 max-w-2xl">
      <h3 class="text-sm font-bold uppercase tracking-wide text-white">Research Is Not a Promise of Buyer Intent</h3>
      <p class="mt-3 text-sm leading-relaxed text-white/75">
        LeadVault qualifies prospects against research criteria. That is different from guaranteeing
        that a company is currently shopping for your product, will reply to an email, will agree to
        a meeting or will become a customer. Business information also changes — people change
        roles, websites change, companies move and contact details can become obsolete after
        research is completed.
      </p>
      <p class="mt-3 text-sm leading-relaxed text-white/75">
        Our responsibility is to define the requirement carefully, research it responsibly,
        communicate the limits honestly and deliver the strongest usable intelligence we can
        establish within the agreed scope.
      </p>
    </div>
  </section>

  <!-- Software Gives You Search Tools -->
  <section class="section-alt">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">The Comparison</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Software Gives You Search Tools. LeadVault Does the Research.</h2>
        <p class="mt-5 text-white/75">
          Self-service sales intelligence platforms can be extremely useful when your team wants
          direct access to large databases, filters and prospecting software. LeadVault serves a
          different need: you give us the business question or targeting specification, and we
          perform the research and deliver the result.
        </p>
      </div>
      <div class="mx-auto mt-10 grid max-w-4xl gap-8 lg:grid-cols-2">
        <div class="card">
          <h3 class="font-semibold text-white">Self-Service Platform</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/75">
            Your team operates the search tools. Filter-driven discovery. Your team reviews
            candidates. Subscription/software workflow.
          </p>
        </div>
        <div class="card ring-1 ring-[var(--color-lime)]/50">
          <h3 class="font-semibold text-white">LeadVault</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/75">
            Our team performs the research. Criteria-driven qualification. LeadVault researches
            candidate fit. Project or recurring research deliverable.
          </p>
        </div>
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-white/75">
        Sometimes a database is exactly what you need. Sometimes you need someone to do the
        research.
      </p>
      <div class="mt-8 text-center">
        <a href="/why-leadvault" class="btn-primary">See the Full Comparison <ArrowRight size={18} /></a>
      </div>
    </div>
  </section>

  <!-- Sample Data (existing, real evidence) -->
  <section id="sample-data" class="section scroll-mt-24">
    <SampleDataSection />
  </section>

  <!-- Built Around Your Requirement -->
  <section class="section-alt">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Not a Prebuilt List</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Built Around Your Requirement — Not Around a Prebuilt List.</h2>
        <p class="mt-5 text-white/75">
          LeadVault does not start by asking which prepackaged list you want. We start by asking
          what makes a company relevant to your business.
        </p>
        <p class="mt-4 text-white/75">
          For straightforward requirements, that may lead to a clean qualified dataset. For complex
          requirements, it may involve deeper investigation, evidence capture, company-level
          qualification and decision-maker research.
        </p>
        <p class="mt-4 font-medium text-white">
          Two projects in the same industry can require completely different research. The industry
          may be the same. The prospect definition is not.
        </p>
      </div>
    </div>
  </section>

  <!-- Research Designed for Action -->
  <section class="section">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Deliverable Fields</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Research Designed for Action.</h2>
      <p class="mt-5 text-white/75">
        Depending on the project, fields may include:
      </p>
    </div>
    <div class="mx-auto mt-8 flex max-w-3xl flex-wrap justify-center gap-2">
      {deliverableFields.map((f) => (
        <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-sm text-white/80">{f}</span>
      ))}
    </div>
    <p class="mx-auto mt-8 max-w-2xl text-center text-white/75">
      The exact schema is agreed according to the project. The goal is to deliver information your
      team can review, import, prioritize and use.
    </p>
  </section>

  <!-- Fresh Research -->
  <section class="section-alt">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Fresh Research</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Research Initiated Around Your Requirement.</h2>
        <p class="mt-5 text-white/75">
          We do not treat a prebuilt contact list as the finished answer. LeadVault starts from
          your specification and uses appropriate research, enrichment, verification and
          quality-control methods to build the deliverable.
        </p>
        <p class="mt-4 text-white/75">
          Freshness matters because people change roles and companies over time — independent
          research puts B2B contact data decay at roughly <strong class="text-white">22–23%
          every year</strong> —
          <a href="https://www.cleanlist.ai/blog/2026-01-22-b2b-data-decay-statistics" target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--color-lime)]">see the research</a>.
          That's the case for research initiated for your request, not merely retrieved from a
          prebuilt list — not a claim that any particular platform's data is stale.
        </p>
      </div>
    </div>
  </section>

  <!-- Trade / Origin story -->
  <section class="section grid items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Our Origin — Trade & Counterparty Intelligence</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">This Company Began With Real Deals — Not a Business Plan.</h2>
      <p class="mt-5 text-white/75">
        Before LeadVault had a name, our founder <strong class="text-white">Steven Ehimigbai</strong> spent
        years doing one difficult thing extremely well: researching and qualifying genuine buyers,
        suppliers, and counterparties for Nigerian import/export businesses — many run by Nigerians
        in the American diaspora.
      </p>
      <p class="mt-4 text-white/75">
        International trade prospecting often requires more than finding a company in the right
        industry. Steven's method — researching counterparties against real commercial
        requirements, not just an industry label — became the discipline behind everything
        LeadVault does today, across every market it serves.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/about" class="btn-primary">Read Our Story <ArrowRight size={18} /></a>
        <a href="/trade" class="btn-outline">Explore the Trade Desk</a>
      </div>
    </div>
    <ImagePlaceholder
      caption="IMAGE: container port at dusk with data-line overlay"
      alt="Container port at dusk, cranes loading cargo containers"
      ratio="aspect-[4/3]"
      src="/photos/container-port-dusk.jpg"
      width={1400}
      height={933}
    />
  </section>

  <!-- Quality -->
  <section class="section-alt">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Quality</p>
        <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Built for Decisions, Not Just Downloads.</h2>
      </div>
      <ul class="mx-auto mt-10 grid max-w-3xl gap-3 sm:grid-cols-2">
        {qualityPrinciples.map((item) => (
          <li class="flex items-start gap-2 text-sm text-white/80">
            <Check size={16} class="mt-0.5 shrink-0 text-[var(--color-lime)]" aria-hidden="true" />
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Who Buys From Us -->
  <section class="section">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Who We Serve</p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Built for Businesses That Run on Data.</h2>
      <p class="mt-5 text-white/75">
        Some businesses need prospect intelligence occasionally. Others live on it daily. We serve
        both — see the research examples industry by industry.
      </p>
    </div>
    <div class="mt-8 text-center">
      <a href="/industries" class="btn-primary">Explore Industries <ArrowRight size={18} /></a>
    </div>
  </section>

  <!-- You Do Not Need to Know the Service Name -->
  <section class="section-alt">
    <div class="section">
      <div class="mx-auto flex max-w-2xl flex-col items-center gap-3 text-center">
        <MessageCircleQuestion size={28} class="text-[var(--color-lime)]" aria-hidden="true" />
        <h2 class="text-2xl font-bold text-white sm:text-3xl">You Do Not Need to Know the Service Name.</h2>
        <p class="text-white/75">
          If you can explain what you are trying to accomplish, that is enough to start. Tell us
          what you sell, the type of company you believe should buy it, where those companies should
          be located, what makes one company more valuable than another and what information your
          team needs before outreach.
        </p>
        <p class="text-white/75">
          We can determine whether the right starting point is ICP research, qualified prospect
          data, deeper prospect intelligence, decision-maker research, trade intelligence or managed
          outreach.
        </p>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Tell Us the Market You Want to Reach.</h2>
      <p class="mx-auto mt-5 max-w-2xl text-white/75">
        Describe the companies, people, geography, or commercial opportunity you are targeting.
        LeadVault will assess the requirement and determine the appropriate research approach.
      </p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a href="/contact" data-cta="final-start-project" class="btn-primary">{CTA_PRIMARY} <ArrowRight size={18} /></a>
        <a href="/contact" data-cta="final-talk-strategist" class="btn-outline">{CTA_HIGH_INTENT}</a>
      </div>
  </section>
</BaseLayout>
