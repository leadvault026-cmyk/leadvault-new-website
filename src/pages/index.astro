---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import HeroGlobe from '../components/HeroGlobe.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Testimonials from '../components/Testimonials.astro';
import { VIDEOS } from '../data/videos';
import { CTA_SAMPLE_LEADS, WHATSAPP_GET_LEADS_LINK, CTA_SAMPLE_HREF } from '../data/site';
import { ArrowRight, Check, Database, Sparkles, Mail, MessageCircle, Users, Store, Megaphone, Briefcase } from '@lucide/astro';

// Phase 2 (brief 2.3): seven sections. Everything else from the old homepage was
// removed or merged into the service pages.

const services = [
  { icon: Database, title: 'Lead Lists', body: 'Ready-to-contact lists of businesses and decision-makers, built to your brief.', href: '/lead-lists' },
  { icon: Sparkles, title: 'Custom Research', body: 'For hard-to-find targets, researched and evidenced company by company.', href: '/custom-research' },
  { icon: Mail, title: 'Outreach & List Cleaning', body: 'Clean and verify the list you already have, or let us run the outreach.', href: '/outreach' },
];

const steps = [
  'Tell us who you sell to',
  'We research and verify',
  'You get a clean Google Sheet in days',
];

const whoFor = [
  { icon: Briefcase, label: 'Sales teams' },
  { icon: Megaphone, label: 'Marketing agencies' },
  { icon: Users, label: 'Freelancers' },
  { icon: Store, label: 'Exporters and importers' },
  { icon: Users, label: 'Recruiters' },
  { icon: Briefcase, label: 'Real estate' },
];

const whyPoints = [
  'Researched for your order, not an old database',
  'Verified before delivery',
  'Built to your brief',
  'Free replacement if more than 5% are invalid within 14 days',
];

const latestVideo = [...VIDEOS].sort((a, b) => b.publishedDate.localeCompare(a.publishedDate))[0];

const sampleHeaders = ['Company Name', 'Website', 'Contact Name', 'Contact Title', 'Email Address', 'Phone Number', 'Address', 'City', 'State', 'Provider Type', 'Qualification Basis', 'Evidence URL'];
const sampleRows = [
  ['Riverbend Pain & Spine', 'riverbend-pain.example', 'J. Walters', 'Personal Injury Coordinator', 'j****@riv*****.com', '(512) ***-**16', '73** Creek Dr', 'Austin', 'TX', 'Pain Management', 'Dedicated personal injury / LOP department listed on official site', 'riverbend-pain.example/personal-injury'],
  ['Lakeside Open MRI', 'lakeside-mri.example', 'R. Shaw', 'Owner', 'r****@lak*****.com', '(214) ***-**00', '14** Regal Ave', 'Dallas', 'TX', 'Diagnostic Imaging / MRI', 'Official materials describe an attorney-referral (LOP) process', 'lakeside-mri.example/attorneys'],
  ['Hillcrest Physical Therapy', 'hillcrest-pt.example', 'C. Moreno', 'Clinic Administrator', 'c****@hil*****.com', '(210) ***-**88', '51** W Loop Rd', 'San Antonio', 'TX', 'Physical Therapy / Injury Rehab', 'Official site lists Letter of Protection under payment options', 'hillcrest-pt.example/payments'],
];
const faqs = [
  { question: 'How fresh is the data?', answer: 'Researched and verified for your order, usually within days of delivery.' },
  { question: 'What if some contacts are wrong?', answer: 'If more than 5% of records are invalid within 14 days of delivery, we replace them free.' },
  { question: 'Which countries do you cover?', answer: 'The US, UK, Canada, Nigeria, wider Africa, and most other markets on request.' },
  { question: 'How do I pay?', answer: 'By bank transfer in USD.' },
  { question: 'How fast is delivery?', answer: 'Most lists are delivered in 3–5 working days. Custom research is quoted with a timeline.' },
];
---

<BaseLayout
  title="LeadVault | Verified B2B Leads and Custom Research"
  description="Tell us who buys from you and we find them. Researched lists of businesses and decision-makers, with verified emails and phone numbers. Start with 100 leads for $29."
  path="/"
  includeOrgSchema
>
  <!-- 1. Hero -->
  <section class="section grid grid-cols-1 items-start gap-10 !pt-8 lg:grid-cols-2 lg:gap-12 lg:!pt-16">
    <div>
      <h1 class="text-4xl font-extrabold leading-tight text-white sm:text-[2.5rem]">
        <span class="block sm:whitespace-nowrap">Tell us who buys from you.</span>
        <span class="block">We'll find them.</span>
      </h1>
      <p class="mt-5 text-white/75">
        Researched lists of businesses and the people who decide, with verified emails and phone
        numbers. For sales teams, agencies, freelancers and exporters in the US, UK, Nigeria and
        worldwide.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={CTA_SAMPLE_HREF} data-cta="hero-get-sample-leads" class="btn-primary">{CTA_SAMPLE_LEADS} <ArrowRight size={18} /></a>
        <a href={WHATSAPP_GET_LEADS_LINK} target="_blank" rel="noopener noreferrer" data-cta="hero-whatsapp" class="btn-outline">Chat on WhatsApp</a>
      </div>
      <p class="mt-8 border-t border-white/10 pt-6 text-sm font-medium text-white/80">
        Verified before delivery · Free replacement guarantee · Start with 100 leads for $29
      </p>
    </div>
    <div class="w-full min-w-0">
      <HeroGlobe />
    </div>
  </section>

  <!-- Sample delivery format (replaces the earlier sample card) -->
  <section class="section-alt">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-bold text-white sm:text-4xl">See what you get</h2>
        <p class="mt-3 text-white/75">This is the exact format of a real LeadVault delivery: company, decision-maker, verified contact details, and the evidence for why each business fits your brief.</p>
      </div>
      <div class="card mx-auto mt-10 max-w-6xl">
        <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
          <p class="text-xs font-semibold uppercase tracking-wide text-white/50">Real delivery format · illustrative data</p>
          <p class="text-xs text-[var(--color-lime)]">Last two columns: why each company fits, with the source.</p>
        </div>
        <div class="overflow-x-auto rounded-lg border border-white/10">
          <table class="w-max min-w-full text-left text-sm">
            <thead>
              <tr class="bg-[var(--color-bg-dark)]">
                {sampleHeaders.map((h, i) => (
                  <th scope="col" class:list={['whitespace-nowrap px-3 py-3 font-semibold text-[var(--color-lime)]', i === 0 && 'sticky left-0 z-10 bg-[var(--color-bg-dark)]', i >= 10 && 'bg-[var(--color-lime)]/10']}>{h}</th>
                ))}
              </tr>
            </thead>
            <tbody class="text-white/85">
              {sampleRows.map((row) => (
                <tr class="border-t border-white/10 align-top">
                  {row.map((cell, i) => (
                    <td class:list={['px-3 py-3', i === 0 && 'sticky left-0 z-10 bg-[var(--color-bg-mid)] font-medium text-white', i >= 10 && 'bg-[var(--color-lime)]/5 text-white/90', i === 0 ? '' : 'min-w-[9rem]']}>{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-white/50 sm:hidden">Swipe to see all 12 columns</p>
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/70">Delivered as a Google Sheet or Excel file.</p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a href={CTA_SAMPLE_HREF} data-cta="sample-section-get-sample" class="btn-primary">{CTA_SAMPLE_LEADS} <ArrowRight size={18} /></a>
        <a href="/data-catalog" data-cta="sample-section-more-samples" class="btn-outline">See more samples</a>
      </div>
    </div>
  </section>

  <!-- 2. What we do -->
  <section id="services" class="section scroll-mt-28">
    <div class="section">
      <h2 class="text-center text-3xl font-bold text-white sm:text-4xl">What We Do</h2>
      <div class="mx-auto mt-10 grid max-w-5xl gap-6 md:grid-cols-3">
        {services.map((s) => (
          <div class="card flex flex-col gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
              <s.icon size={22} stroke-width={1.75} aria-hidden="true" />
            </div>
            <h3 class="text-lg font-bold text-white">{s.title}</h3>
            <p class="flex-1 text-sm leading-relaxed text-white/70">{s.body}</p>
            <a href={s.href} class="text-sm font-semibold text-[var(--color-lime)] hover:underline">See details →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. How it works -->
  <section class="section-alt">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">How It Works</h2>
      <ol class="mt-10 grid gap-4 sm:grid-cols-3">
        {steps.map((s, i) => (
          <li class="card">
            <p class="text-sm font-semibold text-[var(--color-lime)]">Step {i + 1}</p>
            <p class="mt-2 text-base font-semibold text-white">{s.replace(/\.$/, '')}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. Who it's for -->
  <section class="section">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Who It's For</h2>
      <ul class="mx-auto mt-8 grid max-w-3xl gap-3 sm:grid-cols-3">
        {whoFor.map((w) => (
          <li class="card flex items-center justify-center gap-2 text-sm font-medium text-white/85">
            <w.icon size={16} class="text-[var(--color-lime)]" aria-hidden="true" />{w.label}
          </li>
        ))}
      </ul>
      <a href="/industries" class="mt-8 inline-block text-sm font-semibold text-[var(--color-lime)] hover:underline">See industries →</a>
    </div>
  </section>

  <!-- 6. Why LeadVault -->
  <section class="section-alt">
    <div class="section grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold text-white sm:text-4xl">Why LeadVault</h2>
        <ul class="mt-6 space-y-3">
          {whyPoints.map((p) => (
            <li class="flex items-start gap-2 text-sm text-white/85"><Check size={16} class="mt-0.5 shrink-0 text-[var(--color-lime)]" aria-hidden="true" />{p}</li>
          ))}
        </ul>
        <p class="mt-6 text-white/75">
          Idowu Ehimigbai began by helping import and export businesses find genuine buyers, suppliers
          and freight clients, one deal at a time. That hands-on method is still how LeadVault researches
          today.
        </p>
        <a href="/about" class="mt-4 inline-block text-sm font-semibold text-[var(--color-lime)] hover:underline">Read our story →</a>
      </div>
      <div>
        <ImagePlaceholder
          caption="IMAGE: professional portrait of Idowu Ehimigbai"
          alt="Idowu Ehimigbai, Founder & CEO of LeadVault"
          ratio="aspect-[3/4]"
          class="mx-auto w-full max-w-xs"
          src="/photos/founder-headshot.jpg"
          width={800}
          height={1303}
        />
        {latestVideo && (
          <div class="mt-8">
            <p class="mb-3 text-sm font-semibold text-white">Latest video</p>
            <div class="aspect-video w-full overflow-hidden rounded-lg">
              <iframe class="h-full w-full" src={`https://www.youtube-nocookie.com/embed/${latestVideo.youtubeId}`} title={latestVideo.title} loading="lazy" allowfullscreen></iframe>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Testimonials: renders only when real quotes exist (see data/testimonials.ts) -->
  <Testimonials />

  <!-- 7. Pricing teaser + FAQ + final call to action -->
  <section class="section">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Start With 100 Leads for $29.</h2>
      <p class="mt-4 text-white/75">Try a sample first. Bigger lists, custom research and monthly plans are on the pricing page.</p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a href={CTA_SAMPLE_HREF} data-cta="home-pricing-get-sample-leads" class="btn-primary">{CTA_SAMPLE_LEADS} <ArrowRight size={18} /></a>
        <a href="/pricing" class="btn-outline">See Pricing</a>
      </div>
    </div>
    <div class="mx-auto mt-16 max-w-3xl">
      <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Questions</h2>
      <div class="mt-8">
        <FaqAccordion items={faqs} />
      </div>
    </div>
    <div class="mt-16 text-center">
      <a href={CTA_SAMPLE_HREF} data-cta="home-final-get-sample-leads" class="btn-primary">{CTA_SAMPLE_LEADS} <ArrowRight size={18} /></a>
      <p class="mt-4 text-sm text-white/60">Prefer WhatsApp? <a href={WHATSAPP_GET_LEADS_LINK} target="_blank" rel="noopener noreferrer" class="text-[var(--color-lime)] hover:underline">Chat with us</a>.</p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  })} />
</BaseLayout>
