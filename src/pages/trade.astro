---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import { ArrowRight, ArrowDown, Ship, Package, Truck, Globe, Warehouse, Search, ShieldCheck, Database, Compass, FileSearch, AlertTriangle, Factory, Users2, Send } from '@lucide/astro';

const audience = [
  { icon: Ship, text: 'Exporters seeking verified international buyers for commodities and goods' },
  { icon: Package, text: 'Importers seeking genuine, checkable suppliers' },
  { icon: Truck, text: 'Freight forwarders & customs brokers seeking a pipeline of shippers and trade clients' },
  { icon: Globe, text: 'Diaspora entrepreneurs — especially Nigerians and Africans abroad — trading between markets' },
  { icon: Warehouse, text: 'Wholesalers and distributors expanding across borders' },
];

// Replaces the hero's old "IMAGE: container port" placeholder with a real
// visual workflow (commercial-completion round — see ASSUMPTIONS.md).
const workflow = [
  { icon: Package, label: 'Product / Trade Lane' },
  { icon: Globe, label: 'Target Market' },
  { icon: Search, label: 'Buyer / Supplier Research' },
  { icon: ShieldCheck, label: 'Verification' },
  { icon: Database, label: 'Counterparty Dataset' },
  { icon: Compass, label: 'Approach Guidance' },
];

const receive = [
  'A strategist consultation on your trade lane, product category, and target market',
  'A verified counterparty dataset — buyers, suppliers, or shipper prospects matching your specification, each contact checked for existence, activity, and relevance',
  'Fresh research — records gathered and verified for your order, not retrieved from a prebuilt list',
  'Guidance on approach — how to make contact, what to verify further, and red flags to watch',
];

const whatWeResearch = [
  'Buyers for a specific product or product category',
  'Suppliers and manufacturers for a specific product',
  'Freight forwarders and customs brokers active on a given trade lane',
  'Distributors and wholesalers operating in a target market',
];
---

<BaseLayout
  title="Trade & Counterparty Intelligence | LeadVault Trade Desk"
  description="Research and verify genuine international buyers, suppliers, and freight counterparties, matched to your commercial requirement — powered by the LeadVault Trade Desk."
  path="/trade"
>
  <section class="section grid items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Trade & Counterparty Intelligence</p>
      <p class="mt-1 text-sm font-medium text-white/60">Powered by the LeadVault Trade Desk</p>
      <h1 class="mt-2 text-4xl font-extrabold leading-tight text-white sm:text-5xl">Verified Buyers. Genuine Suppliers. Real Deals.</h1>
      <p class="mt-5 text-white/75">
        LeadVault researches B2B prospects for businesses of every kind — the Trade Desk is our
        specialized version of that same research process, built specifically for international
        trade. If you're looking for marketing, recruitment, or SaaS prospect research instead,
        <a href="/services" class="font-medium text-[var(--color-lime)] hover:underline">see our core services</a>.
      </p>
      <p class="mt-4 text-white/75">
        International trade runs on one thing: <strong class="text-white">knowing your counterparty is real.</strong>
        Yet every trader knows the pain — "buyers" who vanish after the invoice, "suppliers" who
        don't exist, contact lists that lead nowhere.
      </p>
      <p class="mt-4 text-white/75">
        LeadVault solves the problem the way it must be solved: <strong class="text-white">human-verified,
        freshly-sourced counterparty data</strong> — the service our founder built his name on,
        serving importers, exporters, and freight forwarders across the USA, UK, Canada, and Nigeria.
      </p>
      <div class="mt-8">
        <a href="/contact?need=trade-desk" data-cta="trade-hero" class="btn-primary">Find My Buyers/Suppliers <ArrowRight size={18} /></a>
      </div>
    </div>
    <div class="card">
      <p class="eyebrow text-center">How a Trade Desk Engagement Runs</p>
      <div class="mt-5 flex flex-col items-center gap-2">
        {workflow.map((step, i) => (
          <>
            <div class="flex w-full max-w-xs items-center gap-3 rounded-lg border border-white/10 bg-white/5 px-4 py-2.5">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
                <step.icon size={16} stroke-width={1.75} aria-hidden="true" />
              </div>
              <span class="text-sm font-medium text-white">{step.label}</span>
            </div>
            {i < workflow.length - 1 && <ArrowDown size={16} class="text-white/30" aria-hidden="true" />}
          </>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[var(--color-bg-mid)]">
    <div class="section">
      <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Who This Page Is For</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {audience.map((a) => (
          <div class="card flex flex-col items-center gap-3 text-center">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
              <a.icon size={22} stroke-width={1.75} aria-hidden="true" />
            </div>
            <p class="text-sm text-white/75">{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-2">
      <div>
        <h2 class="flex items-center gap-2 text-xl font-bold text-white"><FileSearch size={20} class="text-[var(--color-lime)]" /> What We Research</h2>
        <ul class="mt-4 space-y-2.5">
          {whatWeResearch.map((w) => (
            <li class="flex items-start gap-2 text-sm text-white/75">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-lime)]"></span>
              {w}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-bold text-white">Product and Market Relevance</h2>
        <p class="mt-4 text-sm leading-relaxed text-white/75">
          "A buyer of textiles" is not specific enough to research well. Relevant criteria include the
          product sub-category, import or export volume signals, the target market or country, the
          trade lane, and the company type — wholesaler, manufacturer, distributor, or retailer. We
          research against the specific product and market combination you give us, not a generic
          industry label.
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[var(--color-bg-mid)]">
    <div class="section">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-2xl font-bold text-white sm:text-3xl">Counterparty Research</h2>
        <p class="mt-5 text-white/75">
          We verify that a counterparty exists, is active, and is contactable — checking company
          registration signals, trade activity indicators, and direct confirmation where possible,
          rather than passing through an unverified listing.
        </p>
        <div class="card mt-6 flex items-start gap-3">
          <AlertTriangle size={20} class="mt-0.5 shrink-0 text-[var(--color-lime)]" aria-hidden="true" />
          <p class="text-sm leading-relaxed text-white/70">
            This is not legal, sanctions-screening, or credit-diligence advice. LeadVault's
            counterparty research confirms existence and activity — it does not replace your own
            legal, compliance, sanctions, or credit-risk due diligence before entering a transaction.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-xl font-bold text-white">Buyer, Supplier, Distributor — Define the Counterparty Role</h2>
      <p class="mt-4 text-white/75">
        The same company may participate in several parts of a supply chain, and the customer may
        care about only one. A sourcing project needs potential suppliers. A market-entry project
        may need distributors. An exporter may need importers or commercial buyers. A manufacturer
        may need wholesalers or channel partners. The research brief should therefore define the
        desired counterparty role before production begins.
      </p>
    </div>

    <div class="card mx-auto mt-8 max-w-3xl">
      <p class="eyebrow flex items-center gap-2"><Factory size={16} /> Example Assignment</p>
      <p class="mt-3 text-sm leading-relaxed text-white/75">
        Suppose you export parboiled rice and want to find importers in West Africa actively bringing
        in that product. "Food importers in Nigeria" is too broad — most import categories are
        unrelated to rice. We narrow the brief to the product (parboiled rice), import activity
        (recent or active), geography (Nigeria, with optional expansion to Ghana or Senegal), and
        company type (wholesale importer, not retail).
      </p>
      <p class="mt-3 text-sm font-medium text-white">
        The result: a shorter, more relevant list of importers actually positioned to buy that
        specific product — not every food company in the country.
      </p>
      <p class="mt-4 text-xs italic text-white/50">Illustrative example — not a real customer engagement.</p>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[var(--color-bg-mid)]">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="flex items-center justify-center gap-2 text-2xl font-bold text-white sm:text-3xl"><Send size={22} class="text-[var(--color-lime)]" /> From Discovery to Commercial Outreach</h2>
        <p class="mt-5 text-white/75">
          A Trade Desk engagement can stop at delivery of the verified counterparty dataset, or
          continue into outreach — introducing your business to the researched buyers or suppliers
          through LeadVault's managed outreach process. The same research-first discipline applies:
          outreach is built on researched, qualified contacts, not a generic list.
        </p>
        <a href="/managed-outreach" class="mt-4 inline-block text-sm font-semibold text-[var(--color-lime)] hover:underline">See Intelligence-Led Outreach →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="mx-auto max-w-3xl">
      <h2 class="flex items-center gap-2 text-2xl font-bold text-white sm:text-3xl"><Users2 size={22} class="text-[var(--color-lime)]" /> Powered by the LeadVault Trade Desk</h2>
      <p class="mt-5 text-white/75">
        LeadVault was born here. For years before this website existed, Steven Ehimigbai personally
        helped diaspora-run import/export businesses in the United States find what they could not
        find alone: buyers who actually pay, suppliers who actually ship, and freight clients who
        actually move cargo. Deal by deal, referral by referral, the method was refined into the
        system that now powers everything LeadVault does.
      </p>
      <p class="mt-4 text-white/75">
        When you use the Trade Desk, you're not trying a new product. You're joining a service built
        directly on that hands-on trade experience.
      </p>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[var(--color-bg-mid)]">
    <div class="section">
      <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">What You Receive</h2>
      <ol class="mx-auto mt-10 max-w-2xl space-y-5">
        {receive.map((item, i) => (
          <li class="flex gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--color-lime)] text-sm font-bold text-[var(--color-lime-dark)]">
              {i + 1}
            </span>
            <p class="text-white/80">{item}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Why Traders Choose Us Over "Buyer Lists" Online</h2>
    <div class="mt-10">
      <ComparisonTable
        caption='Typical online "buyer lists" versus the LeadVault Trade Desk'
        headers={['Typical online "buyer lists"', 'LeadVault Trade Desk']}
        rows={[
          ['Anonymous, unverifiable, often scams', 'Every counterparty checked before delivery'],
          ['Sold to hundreds of buyers', 'Sourced for your specification'],
          ['No accountability', 'A named company you can contact directly'],
          ['List only', 'Data + strategy + approach guidance'],
        ]}
      />
    </div>
  </section>

  <section class="border-y border-white/10 bg-[var(--color-bg-mid)]">
    <div class="section text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Your Next Trade Partner Is Verifiable. Let's Find Them.</h2>
      <div class="mt-8">
        <a href="/contact?need=trade-desk" data-cta="trade-final" class="btn-primary">Start With the Trade Survey <ArrowRight size={18} /></a>
      </div>
      <p class="mx-auto mt-4 max-w-xl text-sm text-white/60">
        Tell us your product, your lane, and your target market. We respond within 24 hours.
      </p>
    </div>
  </section>
</BaseLayout>
