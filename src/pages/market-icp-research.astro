---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { CTA_PRIMARY } from '../data/site';
import {
  ArrowRight,
  Compass,
  MapPin,
  Building2,
  Target,
  UserCheck,
  BarChart3,
  Database,
  Sparkles,
  Map,
  ListFilter,
  Crosshair,
  Ban,
  ClipboardList,
  Users,
  CheckCircle2,
  XCircle,
  Layers3,
  HelpCircle,
  Stethoscope,
} from '@lucide/astro';

// Master commercial copy package (2026-10-01) — content-depth implementation.
// The "zoom out" page of the four research tiers: defining the addressable
// market before prospecting begins.

const capabilities = [
  { icon: Map, label: 'Market Definition', body: 'Clarify the commercial market represented by your offer.' },
  { icon: ListFilter, label: 'Segment Identification', body: 'Break a broad market into meaningful target groups.' },
  { icon: Crosshair, label: 'ICP Criteria', body: 'Translate the opportunity into observable qualification criteria.' },
  { icon: Ban, label: 'Exclusions', body: 'Identify categories that should be removed before prospecting.' },
  { icon: Compass, label: 'Candidate Market Mapping', body: 'Research companies that appear to fit.' },
  { icon: UserCheck, label: 'Decision-Maker Direction', body: 'Determine which functions or roles are likely to matter.' },
  { icon: ClipboardList, label: 'Data Requirements', body: 'Define the fields the sales or outreach workflow actually needs.' },
];

const icpVariables = [
  'Industry and sub-industry', 'Geography', 'Company size', 'Business model', 'Customer type',
  'Products/services', 'Operating characteristics', 'Relevant capability signals',
  'Location footprint', 'Positive qualification criteria', 'Exclusions',
];

const useCases = [
  { icon: MapPin, title: 'New Territory Entry', body: 'Translate a target region into a defined, addressable set of companies before you commit resources to it.' },
  { icon: Target, title: 'Niche Market Validation', body: "Test whether a niche market is large enough, and well-defined enough, to prospect systematically." },
  { icon: BarChart3, title: 'Vertical Expansion', body: 'Map an adjacent industry vertical before your sales team starts cold-calling it.' },
  { icon: Building2, title: 'Sales Territory Creation', body: 'Build evidence-based territories your reps can actually work, not an arbitrary geographic split.' },
  { icon: UserCheck, title: 'Partnership Research', body: 'Identify companies that fit a partnership or channel profile, not just a sales-prospect profile.' },
  { icon: Compass, title: 'Campaign Planning', body: 'Size and map a market before a campaign launches, so targeting decisions are evidence-based.' },
];

const exampleQuestions = [
  'Which segments of this broad industry are most aligned with our offer?',
  'Which company characteristics are observable and researchable?',
  'What should disqualify an account?',
  'Which states or markets should be prioritized?',
  'Which functions inside these companies are likely to own the problem?',
  'What fields will our sales team need to act on the research?',
];

const segmentationQuestions = [
  'Which segment has the clearest need for the offer?',
  'Which segment can actually be reached through identifiable organizations and contacts?',
  'Which characteristics distinguish one segment from another?',
  'Which markets should be tested first?',
  'Which segments should be excluded from the initial campaign?',
  'Does the same decision-maker function apply across every segment?',
];

const logisticsQuestions = [
  'What counts as mid-sized for this market?',
  'Which logistics sub-sectors are relevant?',
  'Which geographies can the business serve?',
  'What observable company characteristics indicate the problem exists?',
  'Which organizations should be excluded?',
  'Which functions are likely to own the issue?',
  'What information will the sales team need before contact?',
];

const deliverableIncludes = [
  'Target-market definition', 'Priority segments', 'Positive ICP criteria', 'Negative/exclusion criteria',
  'Researchable qualification signals', 'Suggested account categories', 'Relevant decision-maker functions',
  'Initial candidate companies or market map', 'Recommended data fields', 'Research notes and assumptions',
  'Suggested next step: Qualified Prospect Data or Prospect Intelligence',
];

const related = [
  { icon: Database, title: 'Already have a defined specification?', body: "If you already know exactly who you need, skip market mapping and go straight to the data.", cta: { label: 'See Qualified Prospect Data', href: '/qualified-prospect-data' } },
  { icon: Sparkles, title: 'Need evidence-backed qualification too?', body: "If your market is defined but you need each company individually qualified against specific criteria, that's the flagship service.", cta: { label: 'See Prospect Intelligence', href: '/prospect-intelligence' } },
  { icon: UserCheck, title: 'Market is mapped — need the people?', body: 'Once your target companies are set, decision-maker research identifies who inside them matters.', cta: { label: 'See Decision-Maker Intelligence', href: '/decision-maker-intelligence' } },
];

const faqs = [
  {
    question: 'What does "mapping a market" actually produce?',
    answer: 'A defined, addressable set of companies matching your ICP within a specified geography or vertical — the universe you\'d then prospect into, not a prospect list itself (though it can lead directly into one).',
  },
  {
    question: 'Can you tell me how big a market is?',
    answer: "Where public evidence supports a defensible estimate, yes. We don't publish invented market-size figures — segment sizing is provided only where the underlying research actually supports it.",
  },
  {
    question: "What's the difference between this and Prospect Intelligence?",
    answer: 'Market & ICP Research defines the addressable market — the companies that exist within your target definition. Prospect Intelligence goes further: qualifying each company against specific commercial criteria with supporting evidence. Many projects use both, in sequence.',
  },
  {
    question: 'Do you cover international markets?',
    answer: 'Yes — LeadVault researches markets worldwide, with particular depth in the USA, UK, Canada, Nigeria, and other African markets.',
  },
  {
    question: "What's the difference between a positive ICP and a negative ICP?",
    answer: "A positive ICP defines the characteristics that indicate fit. A negative ICP defines the characteristics that make a company unsuitable for the campaign. Those exclusions prevent broad research from becoming wasted outreach — knowing who to exclude can be as valuable as knowing who to include.",
  },
];
---

<BaseLayout
  title="B2B Market Research & Ideal Customer Profile Research | LeadVault"
  description="Define your target market before you prospect. LeadVault researches market segments, ICP criteria, exclusions and target-account opportunities for B2B teams."
  path="/market-icp-research"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Market & ICP Research',
    name: 'Market & ICP Research',
    description: 'B2B market mapping and ideal-customer-profile research to define an addressable target market.',
    provider: { '@type': 'Organization', name: 'LeadVault', url: 'https://leadvaultdata.com' },
  })} />

  <section class="section text-center">
    <p class="eyebrow">Market & ICP Research</p>
    <h1 class="mt-2 text-4xl font-extrabold text-white sm:text-5xl">Before You Build the List, Make Sure You're Targeting the Right Market.</h1>
    <p class="mx-auto mt-5 max-w-2xl text-white/75">
      A prospecting campaign can fail even when every email address is correct. The problem may be
      the audience. LeadVault Market & ICP Research helps businesses turn a broad market idea into a
      clearer definition of the companies they should — and should not — target.
    </p>
    <div class="mt-8">
      <a href="/contact?need=market-icp-research" data-cta="micp-hero" class="btn-primary">Map My Target Market <ArrowRight size={18} /></a>
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-2">
        <div>
          <h2 class="text-xl font-bold text-white">ICP, Persona and Buying Group</h2>
          <p class="mt-4 text-sm leading-relaxed text-white/75">
            These concepts answer different questions. A campaign becomes more precise when these
            layers are not confused — a perfect company with the wrong contact is still a poor
            outreach record, and a perfect title inside the wrong company is equally weak.
          </p>
          <dl class="mt-4 space-y-2.5">
            <div class="rounded-lg border border-white/10 bg-white/5 p-3">
              <dt class="text-xs font-semibold uppercase tracking-wide text-white/50">Ideal Customer Profile</dt>
              <dd class="mt-1 text-sm text-white/80">What kind of organization should we target?</dd>
            </div>
            <div class="rounded-lg border border-white/10 bg-white/5 p-3">
              <dt class="text-xs font-semibold uppercase tracking-wide text-white/50">Persona</dt>
              <dd class="mt-1 text-sm text-white/80">What type of person inside that organization is relevant to the problem or purchase?</dd>
            </div>
            <div class="rounded-lg border border-white/10 bg-white/5 p-3">
              <dt class="text-xs font-semibold uppercase tracking-wide text-white/50">Buying Group</dt>
              <dd class="mt-1 text-sm text-white/80">Which stakeholders may influence, evaluate, approve, purchase or use the solution?</dd>
            </div>
          </dl>
        </div>
        <div>
          <h2 class="text-xl font-bold text-white">An Industry Is Not an ICP</h2>
          <p class="mt-4 text-sm leading-relaxed text-white/75">
            "Healthcare companies." "Manufacturers." "Technology companies." "Businesses in Texas."
            Those are markets, not yet precise prospect definitions. A useful ICP may consider
            combinations of:
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {icpVariables.map((v) => (
              <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs text-white/80">{v}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl gap-6 sm:grid-cols-2">
        <div class="card">
          <h3 class="flex items-center gap-2 text-base font-bold text-white"><CheckCircle2 size={18} class="text-[var(--color-lime)]" /> Positive ICP: What Indicates Fit?</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/70">
            Positive criteria describe the observable characteristics that make an organization
            attractive. For example, a software company may target businesses in a defined industry,
            within a certain size range, operating in selected states, using a particular operating
            model and having a department likely to experience the problem the software solves. A
            professional-service provider may care more about ownership structure, number of
            locations, customer type, specialty or a specific business activity.
          </p>
        </div>
        <div class="card">
          <h3 class="flex items-center gap-2 text-base font-bold text-white"><XCircle size={18} class="text-[var(--color-lime)]" /> Negative ICP: Who Should Be Excluded?</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/70">
            Knowing who not to target can save as much time as knowing who to target. A negative ICP
            may exclude government organizations, very small businesses, enterprises above a certain
            complexity, franchises, agencies, companies outside the service area, businesses with an
            incompatible model, existing customers, competitors or another category unlikely to
            convert. Explicit exclusions make later prospect research more efficient.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">What We Can Research</h2>
    <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {capabilities.map((c) => (
        <div class="card flex flex-col gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
            <c.icon size={22} stroke-width={1.75} aria-hidden="true" />
          </div>
          <h3 class="text-base font-semibold text-white">{c.label}</h3>
          <p class="text-sm leading-relaxed text-white/70">{c.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <div class="mx-auto max-w-3xl">
        <h2 class="flex items-center gap-2 text-2xl font-bold text-white sm:text-3xl"><Layers3 size={22} class="text-[var(--color-lime)]" /> Market Segmentation</h2>
        <p class="mt-4 text-white/75">A broad market often contains several commercially different segments. Market & ICP Research can help separate those groups and ask:</p>
        <ul class="mt-5 space-y-2">
          {segmentationQuestions.map((q) => (
            <li class="flex items-start gap-2 text-sm text-white/80">
              <HelpCircle size={15} class="mt-0.5 shrink-0 text-[var(--color-lime)]" aria-hidden="true" />
              {q}
            </li>
          ))}
        </ul>
        <p class="mt-5 text-white/75">The objective is not to produce academic segmentation for its own sake. It is to make prospecting decisions easier.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="card mx-auto max-w-3xl">
      <p class="eyebrow">From Assumption to Researchable Criteria</p>
      <p class="mt-4 text-sm leading-relaxed text-white/75">
        A founder may begin with an assumption such as "mid-sized logistics companies should need
        this service." Research can turn that into questions:
      </p>
      <ul class="mt-4 space-y-2">
        {logisticsQuestions.map((q) => (
          <li class="flex items-start gap-2 text-sm text-white/75">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-lime)]"></span>
            {q}
          </li>
        ))}
      </ul>
      <p class="mt-4 font-medium text-white">
        The result is a target definition that can be tested and refined rather than a broad label
        treated as fact.
      </p>
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <div class="card mx-auto max-w-3xl">
        <h2 class="text-xl font-bold text-white">From "Who Could Buy?" to "Who Should We Research?"</h2>
        <p class="mt-4 text-sm leading-relaxed text-white/75">
          Market research does not need to become a 100-page consultancy report. For many LeadVault
          projects, the useful outcome is practical: a clearer target definition, inclusion and
          exclusion rules, a researchable ICP, an initial market map or prospect universe, and a
          recommendation for the next data/research step.
        </p>
        <p class="mt-4 text-sm font-medium text-white">
          That creates a stronger foundation for Qualified Prospect Data or Prospect Intelligence.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Use Cases</h2>
    <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {useCases.map((u) => (
        <div class="card flex flex-col gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
            <u.icon size={22} stroke-width={1.75} aria-hidden="true" />
          </div>
          <h3 class="text-base font-semibold text-white">{u.title}</h3>
          <p class="text-sm leading-relaxed text-white/70">{u.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Example Research Questions</h2>
      <ul class="mx-auto mt-10 grid max-w-3xl gap-3 sm:grid-cols-2">
        {exampleQuestions.map((q) => (
          <li class="card text-sm leading-relaxed text-white/80">{q}</li>
        ))}
      </ul>
      <p class="mx-auto mt-6 max-w-2xl text-center text-white/70">The goal is to turn uncertainty into a usable targeting specification.</p>

      <div class="mx-auto mt-12 max-w-3xl">
        <h2 class="text-center text-xl font-bold text-white">What a Deliverable Can Include</h2>
        <p class="mx-auto mt-3 max-w-xl text-center text-sm text-white/60">
          This is practical commercial research, not automatically a large formal consulting
          report. The format should match the decision the customer needs to make. Depending on
          scope, the deliverable may include:
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-2">
          {deliverableIncludes.map((d) => (
            <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-sm text-white/80">{d}</span>
          ))}
        </div>
      </div>

      <div class="card mx-auto mt-12 max-w-3xl">
        <p class="eyebrow flex items-center gap-2"><Stethoscope size={16} /> Example: Narrowing a Broad Healthcare Market</p>
        <p class="mt-3 text-sm leading-relaxed text-white/75">
          A business may begin with "medical providers in the United States." The research may
          reveal that the actual opportunity is concentrated in selected provider types, states and
          practice models, while hospital systems or unrelated specialties should be excluded.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-white/75">
          The decision-maker may also differ by organization size: owner in one practice,
          administrator in another, business-development leader in a larger group. That refined
          definition creates a far stronger prospecting brief than the original industry label.
        </p>
        <p class="mt-4 text-xs italic text-white/50">Illustrative example — not a real customer engagement.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Is This the Right Service?</h2>
    <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-3">
      {related.map((r) => (
        <div class="card flex flex-col gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--color-lime)]/15 text-[var(--color-lime)]">
            <r.icon size={22} stroke-width={1.75} aria-hidden="true" />
          </div>
          <h3 class="text-base font-semibold text-white">{r.title}</h3>
          <p class="flex-1 text-sm leading-relaxed text-white/70">{r.body}</p>
          <a href={r.cta.href} class="text-sm font-semibold text-[var(--color-lime)] hover:underline">{r.cta.label} →</a>
        </div>
      ))}
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Frequently Asked Questions</h2>
      <div class="mx-auto mt-10 max-w-3xl">
        <FaqAccordion items={faqs} />
      </div>
    </div>
  </section>

  <section class="section text-center">
    <h2 class="text-2xl font-bold text-white sm:text-3xl">Not Sure Your Target Market Is Well-Defined Yet?</h2>
    <div class="mt-8">
      <a href="/contact?need=market-icp-research" data-cta="micp-final" class="btn-primary">{CTA_PRIMARY} <ArrowRight size={18} /></a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  })} />
</BaseLayout>
