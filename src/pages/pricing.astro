---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { ArrowRight, Check } from '@lucide/astro';

const subscriptions = [
  {
    name: 'STARTER',
    price: '$129/mo',
    features: ['300 fresh leads', '1 specification', 'Email delivery', 'Email support'],
  },
  {
    name: 'GROWTH',
    price: '$299/mo',
    popular: true,
    features: ['1,000 fresh leads', 'Up to 3 specifications', 'Strategy report', 'Priority delivery', 'WhatsApp + email support'],
  },
  {
    name: 'SCALE',
    price: '$599/mo',
    features: ['2,500 fresh leads', 'Unlimited specifications', 'Dedicated strategist', 'Quarterly market insights', 'Outreach best-practice support'],
  },
];

const emailCampaignPlans = [
  {
    name: 'One-Time Setup',
    price: '$499',
    priceNote: 'one-time',
    features: ['Account & pipeline setup', 'MX sorting configuration', 'Sending infrastructure connection', 'Ready for your first campaign'],
  },
  {
    name: 'Per Campaign',
    price: 'From $299',
    priceNote: 'per campaign',
    features: ['Verification', 'MX sorting', 'Per-provider testing', 'Warm-up', 'Sending', 'Full report'],
  },
  {
    name: 'Managed Monthly — Entry',
    price: 'From $699',
    priceNote: '/mo',
    features: ['Verification', 'MX sorting', 'Per-provider testing', 'Warm-up', 'Sending', 'Full report', 'For steady, single-lane campaigns'],
  },
  {
    name: 'Managed Monthly — Growth',
    price: 'From $1,299',
    priceNote: '/mo',
    features: ['Verification', 'MX sorting', 'Per-provider testing', 'Warm-up', 'Sending', 'Full report', 'For higher-volume, multi-segment programs'],
  },
];

const faqs = [
  {
    question: 'What does "fresh" actually mean?',
    answer: 'Records are sourced and verified for your specific order — typically within days of delivery, in some cases as recently as 72 hours before.',
  },
  {
    question: 'What fields come with each record?',
    answer: 'Standard: name, job title, company, verified email, location, industry, phone where available — plus custom fields by request.',
  },
  {
    question: 'How is data delivered?',
    answer: 'Clean CSV files to your email. (Instant portal delivery arrives with Phase 2 — join the waitlist.)',
  },
  {
    question: 'How do I pay?',
    answer: 'USD, via [payment methods — confirm: card / PayPal / bank transfer]. Custom projects: 50% deposit, balance on delivery.',
  },
  {
    question: 'Do you offer refunds?',
    answer: 'We operate a replacement guarantee (above). Where a delivery cannot be corrected to specification, we make it right — talk to us.',
  },
  {
    question: 'Can you clean a list I bought elsewhere?',
    answer: "Yes — that's exactly what the cleaning service exists for.",
  },
  {
    question: 'Do you serve my country?',
    answer: 'Almost certainly. We deliver worldwide, with particular depth in the USA, UK, Canada, Nigeria, and African markets.',
  },
];
---

<BaseLayout
  title="LeadVault Pricing — Fresh Verified Data in USD | Datasets, Cleaning & Subscriptions"
  description="Transparent USD pricing for fresh verified datasets, email list cleaning, lead subscriptions, and the Trade Desk. Pay per project or subscribe monthly."
  path="/pricing"
>
  <section class="section text-center">
    <p class="eyebrow">Pricing</p>
    <h1 class="mt-2 text-4xl font-extrabold text-white sm:text-5xl">Transparent Pricing. All in USD. Worldwide.</h1>
    <p class="mx-auto mt-5 max-w-3xl text-white/75">
      Pay per project, or subscribe for a steady pipeline. Every price includes verification,
      cleaning, CSV delivery, and our replacement guarantee.
    </p>
    <p class="mx-auto mt-2 max-w-2xl text-sm font-medium text-[var(--color-lime)]">
      Priced deliberately below US and European equivalents — our efficiency is your advantage.
      Quality guaranteed in writing.
    </p>
  </section>

  <section class="section-alt">
    <div class="section">
      <h2 class="text-2xl font-bold text-white">Custom Fresh Datasets (one-time)</h2>
      <div class="mt-6">
        <ComparisonTable
          caption="Custom fresh dataset pricing by record volume"
          headers={['Records', 'Price']}
          rows={[
            ['500 (Sample)', '$99'],
            ['1,000', '$249'],
            ['2,500', '$449'],
            ['5,000', '$799'],
            ['10,000', '$1,399'],
          ]}
        />
      </div>
      <p class="mt-4 text-sm text-white/60">
        Includes: your exact specification · decision-maker filtering · per-order verification ·
        bounce-free CSV · strategist notes.
      </p>
    </div>
  </section>

  <section class="section !pt-0">
    <h2 class="text-2xl font-bold text-white">Email List Cleaning (one-time)</h2>
    <div class="mt-6">
      <ComparisonTable
        caption="Email list cleaning pricing by list size"
        headers={['List size', 'Price']}
        rows={[
          ['Up to 5,000', '$39'],
          ['Up to 25,000', '$129'],
          ['Up to 100,000', '$399'],
          ['Larger', 'Custom quote'],
        ]}
      />
    </div>
  </section>

  <section class="section-alt">
    <div class="section">
      <h2 class="text-2xl font-bold text-white">Managed Email Campaigns</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {emailCampaignPlans.map((plan) => (
          <div class="card">
            <h3 class="text-lg font-bold text-white">{plan.name}</h3>
            <p class="mt-2 text-2xl font-extrabold text-[var(--color-lime)]">
              {plan.price} <span class="text-sm font-medium text-white/60">{plan.priceNote}</span>
            </p>
            <ul class="mt-4 space-y-2">
              {plan.features.map((f) => (
                <li class="flex items-start gap-2 text-sm text-white/75">
                  <Check size={16} class="mt-0.5 shrink-0 text-[var(--color-lime)]" aria-hidden="true" />
                  {f}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <a href="/services#managed-email-campaigns" class="mt-4 inline-block text-sm font-semibold text-[var(--color-lime)] hover:underline">Full details →</a>
    </div>
  </section>

  <section class="section !pt-0">
    <h2 class="text-2xl font-bold text-white">Monthly Lead Subscriptions</h2>
    <div class="mt-6 grid gap-6 lg:grid-cols-3">
      {subscriptions.map((plan) => (
        <div class:list={['card flex flex-col gap-4', plan.popular && 'ring-2 ring-[var(--color-lime)]']}>
          {plan.popular && (
            <span class="w-fit rounded-full bg-[var(--color-lime)] px-3 py-1 text-xs font-bold text-[var(--color-lime-dark)]">
              ⭐ Most popular
            </span>
          )}
          <h3 class="text-xl font-bold text-white">{plan.name}</h3>
          <p class="text-3xl font-extrabold text-[var(--color-lime)]">{plan.price}</p>
          <ul class="flex-1 space-y-2">
            {plan.features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-white/75">
                <Check size={16} class="mt-0.5 shrink-0 text-[var(--color-lime)]" aria-hidden="true" />
                {f}
              </li>
            ))}
          </ul>
          <a href="/contact" class="btn-primary w-full">Get Started</a>
        </div>
      ))}
    </div>
    <p class="mt-4 text-sm text-white/60">Pause or adjust at the end of any month.</p>
  </section>

  <section class="section-alt">
    <div class="section grid gap-6 lg:grid-cols-2">
      <div class="card">
        <h2 class="text-xl font-bold text-white">Trade Desk (Buyer–Seller Matching)</h2>
        <p class="mt-3 text-white/75">
          <strong class="text-white">From $449 per engagement</strong> — consultation + verified
          counterparty dataset + approach guidance.
        </p>
        <a href="/trade" class="mt-4 inline-block text-sm font-semibold text-[var(--color-lime)] hover:underline">Details →</a>
      </div>
      <div class="card">
        <h2 class="text-xl font-bold text-white">Agency & Enterprise Partner Plans</h2>
        <p class="mt-3 text-white/75">
          <strong class="text-white">From $999/mo</strong> — volume pricing, exclusive datasets,
          white-label delivery, custom tooling.
        </p>
        <a href="/contact" class="mt-4 inline-block text-sm font-semibold text-[var(--color-lime)] hover:underline">Talk to us →</a>
      </div>
    </div>
  </section>

  <section class="section text-center">
    <h2 class="text-2xl font-bold text-white sm:text-3xl">Our Replacement Guarantee</h2>
    <p class="mx-auto mt-5 max-w-2xl text-white/75">
      If more than <strong class="text-white">5%</strong> of
      records in any delivery prove invalid within 14 days, we replace them free. That's not
      generosity — it's confidence in the pipeline.
    </p>
  </section>

  <section class="section-alt">
    <div class="section">
      <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">FAQ</h2>
      <div class="mx-auto mt-10 max-w-3xl">
        <FaqAccordion items={faqs} />
      </div>
      <div class="mt-10 text-center">
        <a href="/contact" class="btn-primary">Get My Free Recommendation <ArrowRight size={18} /></a>
      </div>
    </div>
  </section>
</BaseLayout>
